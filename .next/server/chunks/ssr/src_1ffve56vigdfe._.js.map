rams":[["Strike I",[{"r":["720%","748.8%","777.6%","864%","892.8%","921.6%","1008%"]}," ATK +",{"l":["72","168","264","362","458","556","652","748","846","942","1040","1136","1232","1330","1426","1524","1620","1718","1814","1910","2008","2104","2202","2298","2394","2492","2588","2686","2782","2880"]}," (Resilience Break: 240)"]],["Strike II",[{"r":["900%","936%","972%","1080%","1116%","1152%","1259.98%"]}," ATK +",{"l":["90","210","332","452","574","694","816","936","1058","1178","1300","1420","1542","1662","1784","1904","2026","2146","2268","2388","2510","2630","2752","2872","2994","3114","3236","3356","3478","3600"]}," (Resilience Break: 300)"]],["Strike III",[{"r":["900%","936%","972%","1080%","1116%","1152%","1259.98%"]}," ATK +",{"l":["90","210","332","452","574","694","816","936","1058","1178","1300","1420","1542","1662","1784","1904","2026","2146","2268","2388","2510","2630","2752","2872","2994","3114","3236","3356","3478","3600"]}," (Resilience Break: 300)"]],["Strike IV",[{"r":["1080%","1123.2%","1166.4%","1296%","1339.2%","1382.4%","1512%"]}," ATK +",{"l":["108","252","398","542","688","834","978","1124","1268","1414","1560","1704","1850","1996","2140","2286","2430","2576","2722","2866","3012","3158","3302","3448","3592","3738","3884","4028","4174","4320"]}," (Resilience Break: 360)"]],["CD",["20s"]]]},"1612":{"name":"Axe Wind","description":"Wields the weapon like a whirlwind, dealing <style=\"physical\">Attack DMG</style> to targets within 3 meters. Each spin consumes <style=\"accent-gn\">260</style> <style=\"accent-gn\">Stamina</style>. Tap again while skill is active to end it.<br><br><size=22><style=\"tipsYellow\">Strategy: Stamina must be reasonably allocated between damage output and survivability. When safe, it can be used more for dealing damage and increasing Formless level.</style></size>","skillLabel":["Expertise Skill","Physical","Fire","Direct DMG","Single Target","Melee"],"activeEffectParams":[["DMG per hit",[{"r":["220%","228.8%","237.6%","264%","272.8%","281.6%","307.99%"]}," ATK +",{"l":["22","51","81","110","140","169","199","229","258","288","317","347","377","406","436","465","495","524","554","584","613","643","672","702","732","761","791","820","850","880"]}," (Resilience Break: 50)"]],["CD",["5s"]]]},"1613":{"name":"Wildfire Dance","description":"Unleashes an ultra-high-speed flurry. Each round consumes <style=\"accent-gn\">50</style> <style=\"accent-gn\">Flame Soul</style>, <style=\"accent-gn\">25%</style> of the <style=\"accent-gn\">Crimson Soul Gauge</style>, or <style=\"accent-gn\">25%</style> of <style=\"accent-gn\">Max HP</style> to deal <style=\"physical\">Attack DMG</style> to all enemies within 3 meters. <br>Prioritizes consuming Flame Soul, then Crimson Soul Gauge, then HP. Cannot be cast if HP is below 50%. Tap again while the skill is active to end it.<br><br><size=22><style=\"tipsYellow\">Strategy: The absolute core skill of Crimson Spec. Accumulate as much Flame Soul and Crimson Soul Gauge as possible to sustain its use. Observe play while casting to interrupt it at any time for survival.</style></size>","skillLabel":["Expertise Skill","Physical","Fire","Direct DMG","Single Target","Melee"],"activeEffectParams":[["DMG per hit",[{"r":["150%","156%","162%","180%","186%","192%","210%"]}," ATK +",{"l":["15","35","55","75","95","115","136","156","176","196","216","236","257","277","297","317","337","357","378","398","418","438","458","478","499","519","539","559","579","600"]}," (Resilience Break: 50)"]]]},"1614":{"name":"Unbound Meteor","description":"Releases power to perform a powerful leaping cleave at the target, dealing <style=\"physical\">Attack DMG</style> to enemies within 4 meters of the landing point. Upon landing, creates Crimson Earth, which deals additional <style=\"physical\">Attack DMG</style> to all enemies within 4 meters over 5s, and restores <style=\"accent-gn\">15</style> <style=\"accent-gn\">Flame Soul</style>.<br><br><size=22><style=\"tipsYellow\">Tips: Use to engage targets and restore Flame Soul. Cast in advance when burst damage is needed to remain within Crimson Earth.</style></size>","skillLabel":["Expertise Skill","Physical","Fire","Direct DMG","Single Target","Melee"],"activeEffectParams":[["Total DMG",[{"r":["480%","499.2%","518.4%","576%","595.2%","614.4%","672%"]}," ATK +",{"l":["48","112","177","241","306","370","435","499","564","628","693","758","822","887","951","1016","1080","1145","1209","1274","1339","1403","1468","1532","1597","1661","1726","1790","1855","1920"]}," (Resilience Break: 150)"]],["Fire Area DMG per hit",[{"r":["20%","20.8%","21.6%","24%","24.8%","25.6%","28%"]}," ATK +",{"l":["2","4","7","10","12","15","18","20","23","26","28","31","34","36","39","42","45","47","50","53","55","58","61","63","66","69","71","74","77","80"]}]],["CD",["10s"]]]},"1615":{"name":"Wasteland's End","description":"Imbues the power of fire, granting a <style=\"accent-gn\">Class Skills CD Boost</style> and increased <style=\"accent-gn\">Haste</style> while active.<br><br><size=22><style=\"tipsYellow\">Strategy: Use when Formless reaches A or S to maximize benefits during the burst window.</style></size>","skillLabel":["Expertise Skill","Haste"],"activeEffectParams":[["Class Skills CD Boost",[]],["Haste Bonus",[]],["Duration",["15s"]],["CD",["45s"]]]},"1616":{"name":"Flowing Splendor Slash","description":"Consumes <style=\"accent-gn\">50</style> <style=\"accent-gn\">Flame Soul</style> to unleash a powerful cross-shaped energy slash forward. The slash travels forward for a set duration, dealing <style=\"physical\">Attack DMG</style> to all enemies along its path. <style=\"accent-gn\">100%</style> of the DMG dealt to the primary target is converted into HP. Also grants <style=\"accent-gn\">50%</style> Life Steal for a certain duration.<br><br><size=22><style=\"tipsYellow\">Tips: Combine with rapid Crimson Soul Gauge buildup and gain additional recovery when HP is low.</style></size>","skillLabel":["Expertise Skill","Physical","Fire","Direct DMG","Single Target","Melee"],"activeEffectParams":[["Total DMG",[{"r":["600%","624%","648%","720%","744%","768%","840%"]}," ATK +",{"l":["60","140","220","302","382","462","544","624","704","786","866","946","1028","1108","1188","1270","1350","1430","1512","1592","1672","1754","1834","1914","1996","2076","2156","2238","2318","2400"]}," (Resilience Break: 260)"]],["Charge Time",["12s"]]]},"1617":{"name":"Endless Hellfire","description":"Becomes frenzied, increasing all <style=\"accent-gn\">Flame Soul</style> generated by <style=\"accent-gn\">100%</style>, and temporarily granting increased Crit.<br><br><size=22><style=\"tipsYellow\">Strategy: Must maintain during the burst window.</style></size>","skillLabel":["Expertise Skill","Crit"],"activeEffectParams":[["Crit Bonus",[]],["Duration",["15s"]],["CD",["45s"]]]},"1618":{"name":"Cinderfall! Hellfire Shiranui","description":"Gains the <style=\"accent-gn\">Surge</style> effect and immediately restores all Flame Soul. During this effect, <style=\"accent-gn\">Expertise Skill CD Boost</style> is increased by <style=\"accent-gn\">10%</style>. Uses Dual Axes to launch enemies into the air, then performs a lethal spiraling aerial attack that rends through them, dealing <style=\"physical\">Attack DMG</style> to all enemies below.<br><br><size=22><style=\"tipsYellow\">Tips: Maintain a faster skill rotation.</style></size>","skillLabel":["Ultimate","Physical","Fire","Direct DMG","Single Target","Melee"],"activeEffectParams":[["Total DMG",[{"r":["1000%","1040%","1080%","1200%","1240%","1280%","1400%"]}," ATK +",{"l":["100","232","367","501","636","771","905","1040","1174","1309","1442","1576","1711","1846","1980","2116","2250","2385","2520","2654","2787","2922","3056","3191","3325","3460","3595","3729","3864","4000"]}," (Resilience Break: 900)"]],["CD",["60s"]]]},"1701":{"name":"Judgment Cut","description":"<style=\"accent-gn\">Blade Intent</style><br>Stacks <style=\"accent-gn\">2</style> Blade Intent per secon