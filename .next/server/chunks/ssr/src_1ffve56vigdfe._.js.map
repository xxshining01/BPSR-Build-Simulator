/weap_equip_square_03"},"8000061":{"name":"[Weaver] Revelation Wargod Treads","description":"ui/atlas/weap_icon/weap_equip_square_03","flavorText":"ui/atlas/weap_icon/weap_equip_square_03"},"8000062":{"name":"[Weaver] Revelation Wargod Treads","description":"ui/atlas/weap_icon/weap_equip_square_03","flavorText":"ui/atlas/weap_icon/weap_equip_square_03"},"8000063":{"name":"[Weaver] Unbroken Shadowcloak Boots","description":"ui/atlas/weap_icon/weap_equip_square_03","flavorText":"ui/atlas/weap_icon/weap_equip_square_03"},"8000064":{"name":"[Weaver] Unbroken Shadowcloak Boots","description":"ui/atlas/weap_icon/weap_equip_square_03","flavorText":"ui/atlas/weap_icon/weap_equip_square_03"},"8000065":{"name":"[Weaver] Genesis Spellbinder Shoes","description":"ui/atlas/weap_icon/weap_equip_square_03","flavorText":"ui/atlas/weap_icon/weap_equip_square_03"},"8000066":{"name":"[Weaver] Genesis Spellbinder Shoes","description":"ui/atlas/weap_icon/weap_equip_square_03","flavorText":"ui/atlas/weap_icon/weap_equip_square_03"},"8000067":{"name":"[Weaver] Revelation Sunfire Bracelet (L)","description":"ui/atlas/weap_icon/weap_equip_square_03","flavorText":"ui/atlas/weap_icon/weap_equip_square_03"},"8000068":{"name":"[Weaver] Revelation Sunfire Bracelet (L)","description":"ui/atlas/weap_icon/weap_equip_square_03","flavorText":"ui/atlas/weap_icon/weap_equip_square_03"},"8000069":{"name":"[Weaver] Unbroken Glazed Bracelet (L)","description":"ui/atlas/weap_icon/weap_equip_square_03","flavorText":"ui/atlas/weap_icon/weap_equip_square_03"},"8000070":{"name":"[Weaver] Unbroken Glazed Bracelet (L)","description":"ui/atlas/weap_icon/weap_equip_square_03","flavorText":"ui/atlas/weap_icon/weap_equip_square_03"},"8000071":{"name":"[Weaver] Genesis Moonsoul Bracelet (L)","description":"ui/atlas/weap_icon/weap_equip_square_03","flavorText":"ui/atlas/weap_icon/weap_equip_square_03"},"8000072":{"name":"[Weaver] Genesis Moonsoul Bracelet (L)","description":"ui/atlas/weap_icon/weap_equip_square_03","flavorText":"ui/atlas/weap_icon/weap_equip_square_03"},"8000073":{"name":"[Weaver] Revelation Sunfire Bracelet (R)","description":"ui/atlas/weap_icon/weap_equip_square_03","flavorText":"ui/atlas/weap_icon/weap_equip_square_03"},"8000074":{"name":"[Weaver] Revelation Sunfire Bracelet (R)","description":"ui/atlas/weap_icon/weap_equip_square_03","flavorText":"ui/atlas/weap_icon/weap_equip_square_03"},"8000075":{"name":"[Weaver] Unbroken Glazed Bracelet (R)","description":"ui/atlas/weap_icon/weap_equip_square_03","flavorText":"ui/atlas/weap_icon/weap_equip_square_03"},"8000076":{"name":"[Weaver] Unbroken Glazed Bracelet (R)","description":"ui/atlas/weap_icon/weap_equip_square_03","flavorText":"ui/atlas/weap_icon/weap_equip_square_03"},"8000077":{"name":"[Weaver] Genesis Moonsoul Bracelet (R)","description":"ui/atlas/weap_icon/weap_equip_square_03","flavorText":"ui/atlas/weap_icon/weap_equip_square_03"},"8000078":{"name":"[Weaver] Genesis Moonsoul Bracelet (R)","description":"ui/atlas/weap_icon/weap_equip_square_03","flavorText":"ui/atlas/weap_icon/weap_equip_square_03"},"8000079":{"name":"Fury of the Far Sea","description":"An epic Twin Striker weapon.It can be upgraded to higher levels using a few Glinting Stellar Cores as this season progresses.\\nAfter breaking through to item level 180, it can be crafted at Lunel, an NPC of the Artisan Guild, into an \"Ember - Far Sea\" weapon at item level 220, which also activates the weapon's visual effects.\\nThe gear Modification feature can be used to select up to 4 entry effects for \"Ember - Far Sea\" weapons.","flavorText":"\"When the tides converge within the abyss, they cleave through chaos, forging a fearless heart into the surging waves.<br>A vow of resolve is cast into the boundless depths.<br>Within that ceaseless tempest, only an unyielding soul may endure the deep sea's eternal solitude.\" <br>(Excerpt from \"Book of the Depths IX\")","weaponName":"双斧"},"8000080":{"name":"Fury of the Far Sea","description":"An epic Twin Striker weapon.It can be upgraded to higher levels using a few Glinting Stellar Cores as this season progresses.\\nAfter breaking through to item level 180, it can be crafted at Lunel, an NPC of the Artisan Guild, into an \"Ember - Far Sea\" weapon at item level 220, which also activates the weapon's visual effects.\\nThe gear Modification feature can be used to select up to 4 entry effects for \"Ember - Far Sea\" weapons.","flavorText":"\"When the tides converge within the abyss, they cleave through chaos, forging a fearless heart into the surging waves.<br>A vow of resolve is cast into the boundless depths.<br>Within that ceaseless tempest, only an unyielding soul may endure the deep sea's eternal solitude.\" <br>(Excerpt from \"Book of the Depths IX\")","weaponName":"双斧"},"8000081":{"name":"Fury of the Far Sea","description":"An epic Twin Striker weapon.It can be upgraded to higher levels using a few Glinting Stellar Cores as this season progresses.\\nAfter breaking through to item level 180, it can be crafted at Lunel, an NPC of the Artisan Guild, into an \"Ember - Far Sea\" weapon at item level 220, which also activates the weapon's visual effects.\\nThe gear Modification feature can be used to select up to 4 entry effects for \"Ember - Far Sea\" weapons.","flavorText":"\"When the tides converge within the abyss, they cleave through chaos, forging a fearless heart into the surging waves.<br>A vow of resolve is cast into the boundless depths.<br>Within that ceaseless tempest, only an unyielding soul may endure the deep sea's eternal solitude.\" <br>(Excerpt from \"Book of the Depths IX\")","weaponName":"双斧"},"8000082":{"name":"Ember - Shadow of the Far Sea","description":"An epic weapon for the Stormblade class. It can be upgraded to higher levels using a few Glinting Stellar Cores during the current season.","flavorText":"\"In the dark of night, tides surge like a silent blade slicing through the deep.<br>Lightning cleaves the waves, leaving behind traces that vanish in an instant.<br>The scythe dances with the wind. What it reaps is not just mortal bodies, but the rifts of fate. <br>Each strike is a judgment jointly issued by the sea and storm. <br>And the echo that remains is but solemn silence within shattered tides.\" <br>(Excerpt from \"Book of the Depths VII\")","weaponName":"天罚神雷（物理）"},"8000083":{"name":"Ember - Revelation of the Far Sea","description":"An epic weapon for the Frost Mage class. It can be upgraded to higher levels using a few Glinting Stellar Cores during the current season.","flavorText":"\"Between the sea's breaths lies an untold truth. <br>It carves verses into the surging waves, writing them upon moonlit waters.<br>The tip of the staff catches a fleeting ripple, turning it into light.<br>Light pierces the mist, reaching even the deepest longing.<br>If you're willing to listen, the sea will offer you its answer.\"<br>(Excerpt from \"Book of the Depths II\")","weaponName":"冰之玉响（魔法）"},"8000084":{"name":"Ember - Wish of the Far Sea","description":"An epic weapon for the Wind Knight class. It can be upgraded to higher levels using a few Glinting Stellar Cores during the current season.","flavorText":"\"Its edge points straight into the distance, like tides rushing toward the endless sky.<br>It holds the sea's whispers, engraving vows between wind and water.<br>Every thrust is for the sake of protection, turning gales into unwavering creed.<br>And the knight's wish shall echo with the tide, reaching the farthest shore.\"<br>(Excerpt from \"Book of the Depths VIII\")","weaponName":"正义之风（物理）"},"8000085":{"name":"Ember - Grace of the Far Sea","description":"An epic weapon for the Verdant Oracle class. It can be upgraded to higher levels using a few Glinting Stellar Cores during the current season.","flavorText":"\"In the realm of ebbing tides, the sea leaves behind its final sigh.<br>The shattered reflections of starlight float on the water, like dreams yet unbroken.<br>Listen! Each rising tide is the heartbeat of a gentle and solemn deity.<br>The light surging through the ring soothes bloodstains, granting peace to weary souls.\"<br>(Excerpt from \"Book of the Depths I\")","weaponName":"命理之森（魔法）"},"8000086":{"name":"Ember - Waiting of the Far Sea","description":"An epic weapon for the Heavy Guardian class. It can be upgraded to higher levels using a few Glinting Stellar Cores during the current season.","flavorText":"\"The tide is not only gentle; it can become a stern barrier.<br>Great waves lie prostrate before the reefs, safeguarding the silence behind.<br>The blade's edge is like the spine of the earth, firm and unyielding.<br>Each impact echoes the ceaseless song of the ocean.<br>Guardian, the faith of the deep sea has long been bound to your soul.\"<br>(Excerpt from \"Book of the Depths III\")","weaponName":"砂岩守御（物理）"},"8000087":{"name":"Ember - Gaze of the Far Sea","description":"An epic weapon for the Marksman class. It can be upgraded to higher levels using a few Glinting Stellar Cores during the current season.","flavorText":"\"The sea's gaze reaches farther than the wind, longer than the waves.<br>The bowstring draws tight, as if binding the skyline tightly.<br>The arrow carry the breath of the tide, crossing the boundary of water and sky.<br>It always finds its destination, reaching where the heart yearns.\" <br>(Excerpt from \"Book of the Depths IV\")","weaponName":"金玉长弓（物理）"},"8000088":{"name":"Ember - Vow of the Far Sea","description":"An epic weapon for the Shield Knight class. It can upgraded to higher levels using a few Glinting Stellar Cores during the current season.","flavorText":"\"Withdraw, withdraw, yet there always remain the unyielding reefs.<br> That is the ocean's silent vow, standing firmly on the shore forever.<br>The shield bears the waves, embracing the surge without resistance.<br>With every impact, it endures alongside the sea, without end.<br>It grants peace to the soul, so the brave may walk without fear.<br>In the eternal sound of the tide, protection becomes an endless poem.\"<br>(Excerpt from \"Book of the Depths V\")","weaponName":"光灼银辉（物理）"},"8000089":{"name":"Ember - Hymn of the Far Sea","description":"An epic Beat Performer weapon. It can be upgraded to higher levels using a few Glinting Stellar Cores during the current season.","flavorText":"\"Waves strike the reef like trembling strings.<br>Their sound rises from the surge, chasing the wind into the boundless sky.<br>Each chord is a secret the deep sea has yet to speak. <br>Stars and waterlight resonate, weaving a melody that surrounds the battlefield.<br>And those who listen shall find their way home within the hymn.\"<br>(Excerpt from \"Book of the Depths VI\")","weaponName":"灵魂吉他（魔法）"},"8000090":{"name":"Ember - Fury of the Far Sea","description":"An epic Twin Stiker weapon. It can upgraded to higher levels using a few Glinting Stellar Cores during the current season.","flavorText":"\"When the tides converge within the abyss, they cleave through chaos, forging a fearless heart into the surging waves.<br>A vow of resolve is cast into the boundless depths.<br>Within that ceaseless tempest, only an unyielding soul may endure the deep sea's eternal solitude.\" <br>(Excerpt from \"Book of the Depths IX\")","weaponName":"双斧"},"8000091":{"name":"Ember - Shadow of the Far Sea","description":"An epic weapon for the Stormblade class. It can be upgraded to higher levels using a few Glinting Stellar Cores during the current season.","flavorText":"\"In the dark of night, tides surge like a silent blade slicing through the deep.<br>Lightning cleaves the waves, leaving behind traces that vanish in an instant.<br>The scythe dances with the wind. What it reaps is not just mortal bodies, but the rifts of fate. <br>Each strike is a judgment jointly issued by the sea and storm. <br>And the echo that remains is but solemn silence within shattered tides.\" <br>(Excerpt from \"Book of the Depths VII\")","weaponName":"天罚神雷（物理）"},"8000092":{"name":"Ember - Revelation of the Far Sea","description":"An epic weapon for the Frost Mage class. It can be upgraded to higher levels using a few Glinting Stellar Cores during the current season.","flavorText":"\"Between the sea's breaths lies an untold truth. <br>It carves verses into the surging waves, writing them upon moonlit waters.<br>The tip of the staff catches a fleeting ripple, turning it into light.<br>Light pierces the mist, reaching even the deepest longing.<br>If you're willing to listen, the sea will offer you its answer.\"<br>(Excerpt from \"Book of the Depths II\")","weaponName":"冰之玉响（魔法）"},"8000093":{"name":"Ember - Wish of the Far Sea","description":"An epic weapon for the Wind Knight class. It can be upgraded to higher levels using a few Glinting Stellar Cores during the current season.","flavorText":"\"Its edge points straight into the distance, like tides rushing toward the endless sky.<br>It holds the sea's whispers, engraving vows between wind and water.<br>Every thrust is for the sake of protection, turning gales into unwavering creed.<br>And the knight's wish shall echo with the tide, reaching the farthest shore.\"<br>(Excerpt from \"Book of the Depths VIII\")","weaponName":"正义之风（物理）"},"8000094":{"name":"Ember - Grace of the Far Sea","description":"An epic weapon for the Verdant Oracle class. It can be upgraded to higher levels using a few Glinting Stellar Cores during the current season.","flavorText":"\"In the realm of ebbing tides, the sea leaves behind its final sigh.<br>The shattered reflections of starlight float on the water, like dreams yet unbroken.<br>Listen! Each rising tide is the heartbeat of a gentle and solemn deity.<br>The light surging through the ring soothes bloodstains, granting peace to weary souls.\"<br>(Excerpt from \"Book of the Depths I\")","weaponName":"命理之森（魔法）"},"8000095":{"name":"Ember - Waiting of the Far Sea","description":"An epic weapon for the Heavy Guardian class. It can be upgraded to higher levels using a few Glinting Stellar Cores during the current season.","flavorText":"\"The tide is not only gentle; it can become a stern barrier.<br>Great waves lie prostrate before the reefs, safeguarding the silence behind.<br>The blade's edge is like the spine of the earth, firm and unyielding.<br>Each impact echoes the ceaseless song of the ocean.<br>Guardian, the faith of the deep sea has long been bound to your soul.\"<br>(Excerpt from \"Book of the Depths III\")","weaponName":"砂岩守御（物理）"},"8000096":{"name":"Ember - Gaze of the Far Sea","description":"An epic weapon for the Marksman class. It can be upgraded to higher levels using a few Glinting Stellar Cores during the current season.","flavorText":"\"The sea's gaze reaches farther than the wind, longer than the waves.<br>The bowstring draws tight, as if binding the skyline tightly.<br>The arrow carry the breath of the tide, crossing the boundary of water and sky.<br>It always finds its destination, reaching where the heart yearns.\" <br>(Excerpt from \"Book of the Depths IV\")","weaponName":"金玉长弓（物理）"},"8000097":{"name":"Ember - Vow of the Far Sea","description":"An epic weapon for the Shield Knight class. It can upgraded to higher levels using a few Glinting Stellar Cores during the current season.","flavorText":"\"Withdraw, withdraw, yet there always remain the unyielding reefs.<br> That is the ocean's silent vow, standing firmly on the shore forever.<br>The shield bears the waves, embracing the surge without resistance.<br>With every impact, it endures alongside the sea, without end.<br>It grants peace to the soul, so the brave may walk without fear.<br>In the eternal sound of the tide, protection becomes an endless poem.\"<br>(Excerpt from \"Book of the Depths V\")","weaponName":"光灼银辉（物理）"},"8000098":{"name":"Ember - Hymn of the Far Sea","description":"An epic Beat Performer weapon. It can be upgraded to higher levels using a few Glinting Stellar Cores during the current season.","flavorText":"\"Waves strike the reef like trembling strings.<br>Their sound rises from the surge, chasing the wind into the boundless sky.<br>Each chord is a secret the deep sea has yet to speak. <br>Stars and waterlight resonate, weaving a melody that surrounds the battlefield.<br>And those who listen shall find their way home within the hymn.\"<br>(Excerpt from \"Book of the Depths VI\")","weaponName":"灵魂吉他（魔法）"},"8000099":{"name":"Ember - Fury of the Far Sea","description":"An epic Twin Stiker weapon. It can upgraded to higher levels using a few Glinting Stellar Cores during the current season.","flavorText":"\"When the tides converge within the abyss, they cleave through chaos, forging a fearless heart into the surging waves.<br>A vow of resolve is cast into the boundless depths.<br>Within that ceaseless tempest, only an unyielding soul may endure the deep sea's eternal solitude.\" <br>(Excerpt from \"Book of the Depths IX\")","weaponName":"双斧"},"8000100":{"name":"Ember - Shadow of the Far Sea","description":"An epic weapon for the Stormblade class. It can be upgraded to higher levels using a few Glinting Stellar Cores during the current season.","flavorText":"\"In the dark of night, tides surge like a silent blade slicing through the deep.<br>Lightning cleaves the waves, leaving behind traces that vanish in an instant.<br>The scythe dances with the wind. What it reaps is not just mortal bodies, but the rifts of fate. <br>Each strike is a judgment jointly issued by the sea and storm. <br>And the echo that remains is but solemn silence within shattered tides.\" <br>(Excerpt from \"Book of the Depths VII\")","weaponName":"天罚神雷（物理）"},"8000101":{"name":"Ember - Revelation of the Far Sea","description":"An epic weapon for the Frost Mage class. It can be upgraded to higher levels using a few Glinting Stellar Cores during the current season.","flavorText":"\"Between the sea's breaths lies an untold truth. <br>It carves verses into the surging waves, writing them upon moonlit waters.<br>The tip of the staff catches a fleeting ripple, turning it into light.<br>Light pierces the mist, reaching even the deepest longing.<br>If you're willing to listen, the sea will offer you its answer.\"<br>(Excerpt from \"Book of the Depths II\")","weaponName":"冰之玉响（魔法）"},"8000102":{"name":"Ember - Wish of the Far Sea","description":"An epic weapon for the Wind Knight class. It can be upgraded to higher levels using a few Glinting Stellar Cores during the current season.","flavorText":"\"Its edge points straight into the distance, like tides rushing toward the endless sky.<br>It holds the sea's whispers, engraving vows between wind and water.<br>Every thrust is for the sake of protection, turning gales into unwavering creed.<br>And the knight's wish shall echo with the tide, reaching the farthest shore.\"<br>(Excerpt from \"Book of the Depths VIII\")","weaponName":"正义之风（物理）"},"8000103":{"name":"Ember - Grace of the Far Sea","description":"An epic weapon for the Verdant Oracle class. It can be upgraded to higher levels using a few Glinting Stellar Cores during the current season.","flavorText":"\"In the realm of ebbing tides, the sea leaves behind its final sigh.<br>The shattered reflections of starlight float on the water, like dreams yet unbroken.<br>Listen! Each rising tide is the heartbeat of a gentle and solemn deity.<br>The light surging through the ring soothes bloodstains, granting peace to weary souls.\"<br>(Excerpt from \"Book of the Depths I\")","weaponName":"命理之森（魔法）"},"8000104":{"name":"Ember - Waiting of the Far Sea","description":"An epic weapon for the Heavy Guardian class. It can be upgraded to higher levels using a few Glinting Stellar Cores during the current season.","flavorText":"\"The tide is not only gentle; it can become a stern barrier.<br>Great waves lie prostrate before the reefs, safeguarding the silence behind.<br>The blade's edge is like the spine of the earth, firm and unyielding.<br>Each impact echoes the ceaseless song of the ocean.<br>Guardian, the faith of the deep sea has long been bound to your soul.\"<br>(Excerpt from \"Book of the Depths III\")","weaponName":"砂岩守御（物理）"},"8000105":{"name":"Ember - Gaze of the Far Sea","description":"An epic weapon for the Marksman class. It can be upgraded to higher levels using a few Glinting Stellar Cores during the current season.","flavorText":"\"The sea's gaze reaches farther than the wind, longer than the waves.<br>The bowstring draws tight, as if binding the skyline tightly.<br>The arrow carry the breath of the tide, crossing the boundary of water and sky.<br>It always finds its destination, reaching where the heart yearns.\" <br>(Excerpt from \"Book of the Depths IV\")","weaponName":"金玉长弓（物理）"},"8000106":{"name":"Ember - Vow of the Far Sea","description":"An epic weapon for the Shield Knight class. It can upgraded to higher levels using a few Glinting Stellar Cores during the current season.","flavorText":"\"Withdraw, withdraw, yet there always remain the unyielding reefs.<br> That is the ocean's silent vow, standing firmly on the shore forever.<br>The shield bears the waves, embracing the surge without resistance.<br>With every impact, it endures alongside the sea, without end.<br>It grants peace to the soul, so the brave may walk without fear.<br>In the eternal sound of the tide, protection becomes an endless poem.\"<br>(Excerpt from \"Book of the Depths V\")","weaponName":"光灼银辉（物理）"},"8000107":{"name":"Ember - Hymn of the Far Sea","description":"An epic Beat Performer weapon. It can be upgraded to higher levels using a few Glinting Stellar Cores during the current season.","flavorText":"\"Waves strike the reef like trembling strings.<br>Their sound rises from the surge, chasing the wind into the boundless sky.<br>Each chord is a secret the deep sea has yet to speak. <br>Stars and waterlight resonate, weaving a melody that surrounds the battlefield.<br>And those who listen shall find their way home within the hymn.\"<br>(Excerpt from \"Book of the Depths VI\")","weaponName":"灵魂吉他（魔法）"},"8000108":{"name":"Ember - Fury of the Far Sea","description":"An epic Twin Stiker weapon. It can upgraded to higher levels using a few Glinting Stellar Cores during the current season.","flavorText":"\"When the tides converge within the abyss, they cleave through chaos, forging a fearless heart into the surging waves.<br>A vow of resolve is cast into the boundless depths.<br>Within that ceaseless tempest, only an unyielding soul may endure the deep sea's eternal solitude.\" <br>(Excerpt from \"Book of the Depths IX\")","weaponName":"双斧"},"8000109":{"name":"[Weaver] Revelation Wargod Heavy Helm - Replica","description":"Dismantle to obtain the alloy shards of the corresponding item level and the Reforge Stones consumed by replica gear reforging.","flavorText":"ui/atlas/weap_icon/weap_equip_square_03"},"8000110":{"name":"[Weaver] Revelation Wargod Heavy Helm - Replica","description":"Dismantle to obtain the alloy shards of the corresponding item level and the Reforge Stones consumed by replica gear reforging.","flavorText":"ui/atlas/weap_icon/weap_equip_square_03"},"8000111":{"name":"[Weaver] Unbroken Shadowcloak Helm - Replica","description":"Dismantle to obtain the alloy shards of the corresponding item level and the Reforge Stones consumed by replica gear reforging.","flavorText":"ui/atlas/weap_icon/weap_equip_square_03"},"8000112":{"name":"[Weaver] Unbroken Shadowcloak Helm - Replica","description":"Dismantle to obtain the alloy shards of the corresponding item level and the Reforge Stones consumed by replica gear reforging.","flavorText":"ui/atlas/weap_icon/weap_equip_square_03"},"8000113":{"name":"[Weaver] Genesis Spellbinder Crown - Replica","description":"Dismantle to obtain the alloy shards of the corresponding item level and the Reforge Stones consumed by replica gear reforging.","flavorText":"ui/atlas/weap_icon/weap_equip_square_03"},"8000114":{"name":"[Weaver] Genesis Spellbinder Crown - Replica","description":"Dismantle to obtain the alloy s