"346","359","373","386","400"]}," (Resilience Break: 100)"]]]},"1705":{"name":"Overdrive","description":"Unleashes the power of tachi and shifts its form into a scythe, each attack dealing increased <style=\"physical\">Attack Damage</style> and granting <style=\"accent-gn\">1</style> <style=\"accent-gn\">Thunder Sigil</style>.<br>This skill holds <style=\"accent-gn\">5</style> charges.<br><br><size=22><style=\"tipsYellow\">Tips: Always keep at least one charge regenerating without overflowing Thunder Sigils.</style></size>","skillLabel":["Expertise Skill","Physical","Thunder","Direct DMG","Single Target","Melee"],"activeEffectParams":[["Strike I",[{"r":["120%","124.8%","129.6%","144%","148.8%","153.6%","168%"]}," ATK +",{"l":["12","28","44","60","76","92","108","124","140","156","172","188","204","220","236","252","268","284","300","316","332","348","364","380","396","412","428","444","460","480"]}," (Resilience Break: 176)"]],["Strike II",[{"r":["120%","124.8%","129.6%","144%","148.8%","153.6%","168%"]}," ATK +",{"l":["12","28","44","60","76","92","108","124","140","156","172","188","204","220","236","253","269","285","301","317","333","349","365","381","397","413","429","445","461","480"]}," (Resilience Break: 177)"]],["Strike III",[{"r":["120%","124.8%","129.6%","144%","148.8%","153.6%","168%"]}," ATK +",{"l":["12","28","44","60","76","92","108","124","140","156","172","188","204","220","236","253","269","285","301","317","333","349","365","381","397","413","429","445","461","480"]}," (Resilience Break: 177)"]],["Charge Time",["7s"]]]},"1713":{"name":"Oblivion Combo","description":"A supreme sword technique sharp enough to cut the air itself. Unleashes a flurry of slashes in front, dealing <style=\"physical\">Attack Damage</style> to all enemies in range. Grants max <style=\"accent-gn\">Thunder Sigil</style> and fully restores <style=\"accent-gn\">Blade Intent</style> at the end of the strike.<br><i><style=\"text_third_gray\">\"Heaven's weapon dims even the brightest stars.\"</style></i><br><br><size=22><style=\"tipsYellow\">Tips: Cast when Thunder Sigil is empty to quickly charge it. Also effective against multiple targets for massive area damage.</style></size>","skillLabel":["Ultimate","Physical","Thunder","Direct DMG","AoE","Melee","Energy Restore"],"activeEffectParams":[["Total DMG",[{"r":["646%","671.84%","697.68%","775.2%","801.04%","826.88%","904.4%"]}," ATK +",{"l":["63","147","231","324","408","501","585","670","762","847","931","1023","1108","1200","1285","1369","1462","1546","1631","1723","1807","1900","1984","2069","2161","2246","2330","2423","2507","2600"]}," (Resilience Break: 941)"]],["CD",["60s"]]]},"1714":{"name":"Iaido Slash","description":"Powers up and delivers a swift forward slash, consuming all <style=\"accent-gn\">Thunder Sigils</style> to deal <style=\"physical\">Attack Damage</style>. <style=\"accent-gn\">Each</style> <style=\"accent-gn\">Thunder Sigil</style> consumed boosts DMG by <style=\"accent-gn\">25%</style>. <br><br><i><style=\"text_third_gray\">\"Everything I see, hear, or sense can be severed.\"</style></i><br><br><size=22><style=\"tipsYellow\">Tips: Use when Thunder Sigils reach the max for maximum damage.</style></size>","skillLabel":["Special Attack","Physical","Thunder","Direct DMG","Single Target","Melee"],"activeEffectParams":[["Base DMG",[{"r":["157%","163.28%","169.56%","188.4%","194.68%","200.96%","219.8%"]}," ATK +",{"l":["15","36","57","79","100","121","142","163","184","205","226","247","269","290","311","332","353","374","395","416","437","459","480","501","522","543","564","585","606","628"]}," (Resilience Break: 487)"]],["CD",["0.5s"]]]},"1715":{"name":"Moonstrike","description":"Consumes <style=\"accent-gn\">3</style> <style=\"accent-gn\">Thunder Sigils</style> to dash forward with a spinning blade attack, dealing <style=\"physical\">Attack DMG</style> to nearby enemies. <style=\"accent-gn\">Moonblades</style> on the field perform a whirling slashing attack, dealing <style=\"physical\">Attack DMG</style> to surrounding targets. This damage scales with the Level/Tier of <style=\"accent-gn\">Scythe Wheel</style>.<br><i><style=\"text_third_gray\">\"Under the moonlight, I move as one with the shadows.\"</style></i><br><br><size=22><style=\"tipsYellow\">Tips: Use when multiple Moonblades exist to trigger as many whirling attacks as possible.</style></size>","skillLabel":["Special Attack","Physical","Thunder","Direct DMG","Single Target","Melee"],"activeEffectParams":[["Base DMG",[{"r":["100%","104%","108%","120%","124%","128%","140%"]}," ATK +",{"l":["10","22","36","50","62","76","90","104","116","130","144","156","170","184","198","210","224","238","252","264","278","292","304","318","332","346","358","372","386","400"]}," (Resilience Break: 260)"]]]},"1717":{"name":"Flash Strike","description":"Consumes all <style=\"accent-gn\">Thunder Sigils</style> to power up and dash forward, slashing all enemies along the path to deal <style=\"physical\">Attack DMG</style>. <style=\"accent-gn\">Each</style> <style=\"accent-gn\">Thunder Sigil</style> increases DMG by <style=\"accent-gn\">25%</style>. <br><br><i><style=\"text_third_gray\">\"In a blink of lightning, the blade is already unsheathed.\"</style></i><br><br><size=22><style=\"tipsYellow\">Tips: A core skill of Iaido Slash Spec. Prioritize using it before Iaido Slash. Use when your Thunder Sigils are at their maximum to maximize damage.</style></size>","skillLabel":["Expertise Skill","Physical","Thunder","Direct DMG","Single Target","Melee"],"activeEffectParams":[["Total DMG",[{"r":["350%","364%","378%","420%","434%","448%","490%"]}," ATK +",{"l":["35","82","129","176","223","270","317","364","411","458","505","552","599","646","693","741","788","835","882","929","976","1023","1070","1117","1164","1211","1258","1305","1352","1400"]}," (Resilience Break: 566)"]],["CD",["15s"]]]},"1718":{"name":"Raijin Dash","description":"Consumes all <style=\"accent-gn\">Thunder Sigils</style> to release slashes across a wide area, dealing <style=\"physical\">Attack DMG</style>. <style=\"accent-gn\">Each</style> <style=\"accent-gn\">Thunder Sigil</style> increases DMG by <style=\"accent-gn\">25%</style>. Grants <style=\"accent-gn\">immunity to all DMG</style> while slashing. <br><br><size=22><style=\"tipsYellow\">Tips: A core skill of Iaido Slash Spec. Use when facing 3 or more targets and your Thunder Sigils are at their maximum to maximize damage.</style></size>","skillLabel":["Expertise Skill","Physical","Thunder","Direct DMG","AoE","Melee"],"activeEffectParams":[["Total DMG",[{"r":["300%","312%","324%","360%","372%","384%","420%"]}," ATK +",{"l":["30","69","108","150","189","231","270","312","351","393","432","471","513","552","594","633","675","714","756","795","834","876","915","957","996","1038","1077","1119","1158","1200"]}," (Resilience Break: 294)"]],["CD",["25s"]]]},"1719":{"name":"Scythe Wheel","description":"Turns the weapon into a scythe, swinging it to perform multi-hit attacks against surrounding enemies, dealing <style=\"physical\">Attack DMG</style> and <style=\"accent-gn\">repelling</style> enemies. The final strike inflicts a <style=\"accent-gn\">50%</style> <linktext=3004><style=\"ItemQuality_5\">Wound</style></linktext> on the target for <style=\"accent-gn\">10s</style>. <br>Summons <style=\"accent-gn\">Moonblades</style> to aid in combat. <br><br><style=\"accent-gn\">Moonblade</style>: Spins for <style=\"accent-gn\">35s</style>, dealing <style=\"physical\">Attack DMG</style> on the target every <style=\"accent-gn\">2s</style>. Casting <style=\"accent-gn\">Moonstrike</style> commands all active <style=\"accent-gn\">Moonblades</style> to release a whirling attack, dealing <style=\"physical\">Attack DMG</style> to nearby enemies. When you die, <style=\"accent-gn\">Moonblades</style> end immediately and the remaining CD of <style=\"accent-gn\">Scythe Wheel</style> is refunded.<br><br><size=22><style=\"tipsYellow\">Tips: A core skill of Iaido Slash Spec. Release just prior to each Moonblade's expiration to maximize its DMG.</style></size>","skillLabel":["Expertise Skill","Physical","Thunder","Direct DMG","AoE","Summon","Melee"],"activeEffectParams":[["Skill Damage",[{"r":["300%","312%","324%","360%","372%","384%","420%"]}," ATK +",{"l":["27","69","105","147","189","231","267","309","351","387","430","472","508","550","592","634","670","712","754","790","833","875","917","953","995","1037","1073","1115","1157","1200"]}," (Resilience Break: 171)"]],["Moonblade DMG per hit",[{"r":["50%","52%","54%","60%","62%","64%","70%"]}," ATK +",{"l":["5","11","18","25","31","38","45","52","58","65","72","78","85","92","99","105","112","119","126","132","139","146","152","159","166","173","179","186","193","200"]}]],["Trigger Whirl Damage",[{"r":["150%","156%","162%","180%","186%","192%","210%"]}," ATK +",{"l":["15","35","55","75","95","115","136","156","176","196","216","236","257","277","297","317","337","357","378","398","418","438","458","478","499","519","539","559","579","600"]}]],["CD",["30s"]]]},"1720":{"name":"True Sight","description":"Enters a defensive stance, gaining immunity to all DMG. If hit while in this stance, counterattacks with a slash and leaps backward. Recast to dash forward and slash, dealing <style=\"physical\">Attack Damage</style>. If the attack hits a target, gains max <style=\"accent-gn\">Thunder Sigils</style>.<br><br><size=22><style=\"tipsYellow\">Tips: Release under intense battles or when confident in timing to gain Thunder Sigil more efficiently.</style></size>","skillLabel":["Expertise Skill","Physical","Thunder","Direct DMG","Single Target","Melee","Energy Restore","Block"],"activeEffectParams":[["Slash Backstep Damage",[{"r":["30%","31.2%","32.4%","36%","37.2%","38.4%","42%"]}," ATK +",{"l":["3","7","11","15","19","23","27","31","35","39","43","47","51","55","59","63","67","71","75","79","83","87","91","95","99","103","107","111","115","120"]}]],["Dashing Slash Damage",[{"r":["70%","72.8%","75.6%","84%","86.8%","89.6%","98%"]}," ATK +",{"l":["7","16","25","35","44","54","63","72","82","91","101","110","119","129","138","148","157","167","176","185","195","204","214","223","232","242","251","261","270","280"]}]],["CD",["30s"]]]},"1721":{"name":"Judgment Cut I - Alt.","description":"<style=\"accent-gn\">Phantom Scythe Wheel</style><br>Approach the target at lightning speed, then creates a Phantom Scythe Wheel, dealing <style=\"electro\">Thunder Element damage</style> for 3s, striking every 0.5s.<br><br><size=22><style=\"tipsYellow\">Tips: Reliable Attack skill when enemy movement is unpredictable. Great for dealing massive DMG.</style></size>","skillLabel":["Direct DMG","Special Attack","Thunder"]},"1724":{"name":"Thundercut","description":"Double lightning-fast Iai Slashes. Inflicts <style=\"physical\">Attack DMG</style> on enemies at the cost of <style=\"accent-gn\">50</style> <style=\"accent-gn\">Blade Intent</style>. Once Attack Speed reaches <style=\"accent-gn\">25%</style>|<style=\"accent-gn\">50%</style>|<style=\"accent-gn\">80%</style>, deals <style=\"accent-gn\">1</style>|<style=\"accent-gn\">2</style>|<style=\"accent-gn\">3</style> additional attack(s). If <style=\"accent-gn\">Blade Intent</style> remains after the strike, the skill can be recast. <br><br><size=22><style=\"tipsYellow\">Tips: Core skill of the Spec. Consumes Blade Intent to deal DMG. Release when Blade Intent is at its maximum.</style></size>","skillLabel":["Expertise Skill","Physical","Thunder","Direct DMG","Single Target","Melee"],"activeEffectParams":[["Total DMG",[{"r":["150%","156%","162%","180%","186%","192%","210%"]}," ATK +",{"l":["14","34","54","74","94","114","136","156","176","196","216","236","256","276","296","316","336","356","378","398","418","438","458","478","498","518","538","558","578","600"]}," (Resilience Break: 80)"]]]},"1728":{"name":"Oblivion Combo","description":"<style=\"accent-gn\">Oblivion Combo</style><br>A supreme sword technique sharp enough to cut the air itself. Unleashes a flurry of slashes in front, dealing <style=\"physical\">Attack DMG</style> to all enemies in range. Grants max <style=\"accent-gn\">Thunder Sigil</style> and fully restores <style=\"accent-gn\">Blade Intent</style> at the end of the strike.<br><i><style=\"text_third_gray\">\"Heaven's weapon dims even the brightest stars.\"</style></i><br><br><size=22><style=\"tipsYellow\">Tips: Cast when Thunder Sigil is empty to quickly charge it. Also effective against multiple targets for massive area damage.</style></size>","skillLabel":["Ultimate","Physical","Thunder","Direct DMG","AoE","Melee"]},"1729":{"name":"场地标记01","description":"场地标记01","skillLabel":["Basic Attack","Physical","Thunder","Direct DMG","Energy Restore"],"activeEffectParams":[["Strike I",[{"r":["32%","33.28%","34.56%","38.4%","39.68%","40.96%","44.8%"]}," ATK +",{"l":["3","7","11","15","20","24","28","32","37","41","45","49","53","58","62","66","70","75","79","83","87","92","96","100","104","109","113","117","121","126"]}]],["Strike II",[{"r":["52%","54.08%","56.16%","62.4%","64.48%","66.56%","72.78%"]}," ATK +",{"l":["4","12","18","26","32","40","46","54","60","68","74","82","88","96","102","110","116","124","132","138","146","152","160","166","174","180","188","194","202","208"]}]],["Strike III",[{"r":["57%","59.28%","61.56%","68.4%","70.68%","72.96%","79.8%"]}," ATK +",{"l":["4","11","20","27","34","43","50","57","64","73","80","87","96","103","111","118","127","134","141","150","157","164","171","180","187","194","203","210","217","226"]}]],["Strike IV",[{"r":["69%","71.76%","74.52%","82.8%","85.56%","88.32%","96.6%"]}," ATK +",{"l":["6","16","25","34","44","53","62","72","81","90","100","109","118","128","137","146","156","165","174","184","193","202","211","221","230","239","249","258","267","277"]}]],["Plunge Attack",[{"r":["100%","104%","108%","120%","124%","128%","140%"]}," ATK +",{"l":["10","23","36","50","63","77","90","104","117","131","144","157","171","184","198","2