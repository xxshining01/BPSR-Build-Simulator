ription":"Intellect +10"},"3":{"name":"Agility","description":"Agility +10"},"4":{"name":"Endurance","description":"Endurance +30"},"5":{"name":"Crit","description":"Crit +25"},"6":{"name":"Haste","description":"Haste +25"},"7":{"name":"Luck","description":"Luck +25"},"8":{"name":"Mastery","description":"Mastery +25"},"9":{"name":"Versatility","description":"Versatility +25"},"20":{"name":"Ice Attack","description":"Ice Attack +5"},"21":{"name":"Rock Attack","description":"Rock Attack +5"},"22":{"name":"Thunder Attack","description":"Thunder Attack +5"},"23":{"name":"Forest Attack","description":"Forest Attack +5"},"24":{"name":"Light Attack","description":"Light Attack +5"},"25":{"name":"Dark Attack","description":"Dark Attack +5"},"26":{"name":"Wind Attack","description":"Wind Attack +5"},"27":{"name":"Fire Attack","description":"Fire Attack +5"},"40":{"name":"Crit Chance","description":"Crit +200"},"41":{"name":"Attack Speed","description":"Attack SPD +1%"},"42":{"name":"Casting SPD","description":"Attack SPD +1%"},"43":{"name":"Skill CD","description":"Skill CD Reduction +100"},"44":{"name":"Luck Chance","description":"Luck +200"},"45":{"name":"Crit DMG","description":"Crit DMG +300"},"46":{"name":"Luck Damage","description":"Lucky Strike DMG Multiplier +300"},"47":{"name":"Healing","description":"Healing Output +300"},"48":{"name":"Shield DMG Reduction","description":"Shield DMG Reduction +400"},"49":{"name":"Block DMG Reduction","description":"Block DMG Reduction +400"},"50":{"name":"Universal Damage Bonus","description":"Versatility Enhancement +300"},"51":{"name":"Universal DMG Reduction","description":"Versatility Resistance +300"},"52":{"name":"Vulnerability factor","description":"Shatter Strength +300"},"53":{"name":"Vulnerability Damage Bonus","description":"Shatter Damage Increase +300"},"54":{"name":"Suppress Damage Bonus","description":"Suppress Damage +300"},"55":{"name":"Suppress DMG Reduction","description":"Suppress DMG Reduction +300"},"56":{"name":"Inspiring Effect","description":"Inspiration Ratio +300"},"57":{"name":"Ignore Defense","description":"Armor Penetration +200"},"100":{"name":"Blade Intent","description":"<style=\"accent-gn\">3</style> points of <linktext=1167><style=\"ItemQuality_5\">Blade Intent</style></linktext> are gained when an <style=\"accent-gn\">Expertise Skill</style> is cast."},"101":{"name":"Agility Conversion","description":"Every <style=\"accent-gn\">8</style> Agility grants <style=\"accent-gn\">1</style> ATK."},"102":{"name":"Thunder Whirl","description":"<linktext=1096><style=\"ItemQuality_5\">Piercing Slash</style></linktext> grants <linktext=1556><style=\"ItemQuality_5\">Overdrive</style></linktext> <style=\"accent-gn\">1</style> charge."},"103":{"name":"Keen Strike","description":"When <style=\"accent-gn\">Basic Attacks</style> deal DMG, <style=\"accent-gn\">10%</style> chance to trigger <linktext=1096><style=\"ItemQuality_5\">Piercing Slash</style></linktext>, once <style=\"accent-gn\">per</style> second."},"104":{"name":"Keen Enhancement","description":"Increases the fixed chance to trigger <linktext=1096><style=\"ItemQuality_5\">Piercing Slash</style></linktext> by <style=\"accent-gn\">10%</style>."},"105":{"name":"Iaido Mastery","description":"<linktext=1500><style=\"ItemQuality_5\">Iaido Slash</style></linktext> Crit +<style=\"accent-gn\">10%</style>.<br>Each <style=\"accent-gn\">1%</style> Crit chance grants <style=\"accent-gn\">0.15%</style> Crit DMG for skills that consume <linktext=1104><style=\"ItemQuality_5\">Thunder Sigils</style></linktext>. When Crit chance exceeds <style=\"accent-gn\">60%</style>, every extra <style=\"accent-gn\">1%</style> grants an additional <style=\"accent-gn\">0.88%</style> Crit DMG for skills that consume <linktext=1104><style=\"ItemQuality_5\">Thunder Sigils</style></linktext>."},"106":{"name":"Wind Assault I","description":"Crit Rate obtained in any way is increased by <style=\"accent-gn\">12%</style>, but Luck chance obtained in any way are reduced by <style=\"accent-gn\">10%</style>."},"107":{"name":"Zen Moment","description":"Crit hits of <style=\"accent-gn\">Special Attacks</style> grant <style=\"accent-gn\">100</style> <linktext=1167><style=\"ItemQuality_5\">Blade Intent</style></linktext>."},"108":{"name":"Thunder Sigil Charm","description":"Increases Max <linktext=1104><style=\"ItemQuality_5\">Thunder Sigil</style></linktext> by <style=\"accent-gn\">1</style>."},"109":{"name":"Thunder Reversal","description":"Consumes <style=\"accent-gn\">100</style> <linktext=1167><style=\"ItemQuality_5\">Blade Intent</style></linktext> to gain stacks of <style=\"accent-gn\">Thunder Reversal Mark</style>. When <style=\"accent-gn\">Thunder Reversal Mark</style> reaches <style=\"accent-gn\">5</style> stacks, casting <linktext=1500><style=\"ItemQuality_5\">Iaido Slash</style></linktext> grants the <style=\"accent-gn\">Thunder Reversal</style> effect and removes all <style=\"accent-gn\">Thunder Reversal Mark</style> stacks.<br><style=\"accent-gn\">Thunder Reversal</style>: Gain a <style=\"accent-gn\">10%</style> Thunder DMG bonus for <style=\"accent-gn\">15</style>s."},"110":{"name":"Vacuum Slash","description":"Each cast of <linktext=1501><style=\"ItemQuality_5\">Flash Strike</style></linktext>, <linktext=1554><style=\"ItemQuality_5\">Raijin Dash</style></linktext>, or its enhanced skills grants <style=\"accent-gn\">1</style> stack of <style=\"accent-gn\">Thundrage</style>. When <style=\"accent-gn\">Thundrage</style> reaches <style=\"accent-gn\">5</style> stacks, <linktext=1500><style=\"ItemQuality_5\">Iaido Slash</style></linktext> evolves into <linktext=1588><style=\"ItemQuality_5\">Thunder Cut</style></linktext>.<br>After casting <linktext=1588><style=\"ItemQuality_5\">Thunder Cut</style></linktext>, <style=\"accent-gn\">5</style> stacks of <style=\"accent-gn\">Thundrage</style> are consumed. <style=\"accent-gn\">Thundrage</style> stacks up to <style=\"accent-gn\">8</style> times."},"112":{"name":"Flash Frenzy Blade","description":"When <linktext=1500><style=\"ItemQuality_5\">Iaido Slash</style></linktext> and its enhanced skill (<linktext=1588><style=\"ItemQuality_5\">Thunder Cut</style></linktext>) deal DMG, there is a fixed <style=\"accent-gn\">10%</style> chance to reset the remaining CD of <linktext=1501><style=\"ItemQuality_5\">Flash Strike</style></linktext> and <linktext=1554><style=\"ItemQuality_5\">Raijin Dash</style></linktext>. For <style=\"accent-gn\">each</style> <linktext=1104><style=\"ItemQuality_5\">Thunder Sigil</style></linktext> consumed, the chance increases by <style=\"accent-gn\">10%</style>. During <linktext=1504><style=\"ItemQuality_5\">Volt Surge</style></linktext>, this chance is doubled."},"113":{"name":"Bladewind Domain","description":"Every <style=\"accent-gn\">3</style> casts of <linktext=1556><style=\"ItemQuality_5\">Overdrive</style></linktext> allows the next <linktext=1500><style=\"ItemQuality_5\">Iaido Slash</style></linktext> to generate a <linktext=1099><style=\"ItemQuality_5\">Bladewind Domain</style></linktext> in front.<br>Each time <linktext=1099><style=\"ItemQuality_5\">Bladewind Domain</style></linktext> deals DMG, reduces the CD of <linktext=1502><style=\"ItemQuality_5\">Oblivion Combo</style></linktext> by <style=\"accent-gn\">1.5</style>s."},"114":{"name":"Touch of Thunder Soul","description":"<linktext=1101><style=\"ItemQuality_5\">Moonblades</style></linktext> have a fixed <style=\"accent-gn\">60%</style> chance to cast <linktext=1100><style=\"ItemQuality_5\">Thunderstrike</style></linktext> on a Lucky Strike. <br><linktext=1100><style=\"ItemQuality_5\">Thunderstrike</style></linktext> deals double DMG."},"115":{"name":"Breath of Mark","description":"Lucky Strikes of <linktext=1101><style=\"ItemQuality_5\">Moonblades</style></linktext> grant a fixed <style=\"accent-gn\">30%</style> chance to restore <style=\"accent-gn\">1</style> <linktext=1104><style=\"ItemQuality_5\">Thunder Sigil</style></linktext>, once per <style=\"accent-gn\">2</style> seconds."},"116":{"name":"Phantom Delay","description":"For <style=\"accent-gn\">12</style> seconds after casting <linktext=1506><style=\"ItemQuality_5\">Chaos Breaker</style></linktext>, whenever the Talents Raijin Dash Charge, Moonlight Charge, and Charge Catcher obtain a <linktext=1106><style=\"ItemQuality_5\">Charge Seed</style></linktext>, <style=\"accent-gn\">1</style> additional Charge Seed is granted."},"118":{"name":"Phantom Scythe Realm I","description":"Increases Max <linktext=1101><style=\"ItemQuality_5\">Moonblades</style></linktext> by <style=\"accent-gn\">1</style>."},"119":{"name":"Phantom Scythe Realm II","description":"Casting <linktext=1503><style=\"ItemQuality_5\">Thundercut</style></linktext> grants <style=\"accent-gn\">12</style> + Luck% x <style=\"accent-gn\">10</style> points of <linktext=1167><style=\"ItemQuality_5\">Blade Intent</style></linktext>."},"120":{"name":"Power of Thunder","description":"For every <style=\"accent-gn\">10</style> instances of damage dealt, triggers <style=\"accent-gn\">Thunder Power</style>.<br><style=\"accent-gn\">Thunder Power</style>: Thunder DMG +<style=\"accent-gn\">22</style> for <style=\"accent-gn\">10</style>s, up to <style=\"accent-gn\">10</style> stacks."},"121":{"name":"Moonstrike Delay","description":"<linktext=1167><style=\"ItemQuality_5\">Blade Intent</style></linktext> cap +<style=\"accent-gn\">25</style>.<br>After <style=\"accent-gn\">5</style> consecutive <linktext=1503><style=\"ItemQuality_5\">Thundercuts</style></linktext> in one go, it evolves into the more powerful <linktext=1098><style=\"ItemQuality_5\">Thundercleave</style></linktext>, which deals higher DMG."},"122":{"name":"Lightning Flash","description":"During <linktext=1505><style=\"ItemQuality_5\">Stormflash</style></linktext>, doubles <linktext=1101><style=\"ItemQuality_5\">Moonblades</style></linktext>' Attack SPD."},"123":{"name":"Thunder Curse","description":"<style=\"accent-gn\">Special Attacks</style> inflict <style=\"accent-gn\">Thunder Curse</style> on the target upon dealing DMG.<br><style=\"accent-gn\">Thunder Curse</style>: Each stack of <style=\"accent-gn\">Thunder Curse</style> increases the target's DMG taken from you by <style=\"accent-gn\">2%</style> for <style=\"accent-gn\">10</style>s, stacking up to <style=\"accent-gn\">4</style> times."},"124":{"name":"Duel Awareness","description":"Deals <style=\"accent-gn\">20%</style> more DMG to enemies with <style=\"accent-gn\">80%</style> HP or above."},"126":{"name":"Frenzied Thunder Roar","description":"Defeating an enemy triggers <linktext=1103><style=\"ItemQuality_5\">Thunderburst</style></linktext>, once every <style=\"accent-gn\">3s</style>."},"128":{"name":"Shadow Despise","description":"For <style=\"accent-gn\">each</style> enemy within <style=\"accent-gn\">3</style>m, you gain <style=\"accent-gn\">3%</style> Armor Penetration, up to <style=\"accent-gn\">15%</style>. This effect is doubled against Elite or stronger enemies."},"129":{"name":"Iai Thunder Dance","description":"When <linktext=1104><style=\"ItemQuality_5\">Thunder Sigils</style></linktext> are at <style=\"accent-gn\">3</style> or higher, <style=\"accent-gn\">Special Attack</style> hits <style=\"accent-gn\">twice</style> times consecutively."},"130":{"name":"Iaido Slash Spec","description":"Further enhances the ability to use <linktext=1500><style=\"ItemQuality_5\">Iaido Slash</style></linktext>. <br>When the number of <linktext=1104><style=\"ItemQuality_5\">Thunder Sigils</style></linktext> consumed by <linktext=1500><style=\"ItemQuality_5\">Iaido Slash</style></linktext> and its enhanced skill (<linktext=1588><style=\"ItemQuality_5\">Thunder Cut</style></linktext>) equals the current maximum <linktext=1104><style=\"ItemQuality_5\">Thunder Sigil</style></linktext> count, increases the DMG of <linktext=1500><style=\"ItemQuality_5\">Iaido Slash</style></linktext> and its enhanced skill (<linktext=1588><style=\"ItemQuality_5\">Thunder Cut</style></linktext>) by <style=\"accent-gn\">12%</style> and grants <linktext=1102><style=\"ItemQuality_5\">Super Armor</style></linktext> during the cast. <br><br><i><style=\"text_third_gray\"><size=20>Consume as many Thunder Sigils as possible to deliver a powerful blow to the target with Iaido Slash. High Crit and Mastery allow Iaido Slash to deal greater DMG and more hits. Under certain conditions, Iaido Slash no longer needs to be channeled.</size></style></i>"},"131":{"name":"Thunder Seed","description":"Casting <linktext=1503><style=\"ItemQuality_5\">Thundercut</style></linktext> guarantees <style=\"accent-gn\">2</style> <linktext=1106><style=\"ItemQuality_5\">Charge Seed</style></linktext>."},"132":{"name":"Flash Sharp Strike","description":"Triggers Sharp Strike when casting <linktext=1500><style=\"ItemQuality_5\">Iaido Slash</style></linktext> and its enhanced skill (<linktext=1588><style=\"ItemQuality_5\">Thunder Cut</style></linktext>). <br>Sharp Strike: Increases Crit Rate of <linktext=1501><style=\"ItemQuality_5\">Flash Strike</style></linktext> and its enhanced skill (<linktext=1584><style=\"ItemQuality_5\">Dracoflash</style></linktext>) by <style=\"accent-gn\">10%</style>. If <linktext=1501><style=\"ItemQuality_5\">Flash Strike</style></linktext> and its enhanced skill (<linktext=1584><style=\"ItemQuality_5\">Dracoflash</style></linktext>) deals Crit DMG <style=\"accent-gn\">1</style> time, gains <style=\"accent-gn\">1</style> <linktext=1104><style=\"ItemQuality_5\">Thunder Sigil</style></linktext>. This effect is removed after the use of <linktext=1501><style=\"ItemQuality_5\">Flash Strike</style></linktext> and its enhanced skill (<linktext=1584><style=\"ItemQuality_5\">Dracoflash</style></linktext>) or after <style=\"accent-gn\">10s</style>."},"133":{"name":"Rapid Thunder Assault","description":"<style=\"accent-gn\">Each</style> additional <linktext=1104><style=\"ItemQuality_5\">Thunder Sigil</style></linktext> consumed by a skill increases its DMG by <style=\"accent-gn\">3%</style>."},"134":{"name":"End of Annihilation","description":"The final strike of <linktext=1502><style=\"ItemQuality_5\">Oblivion Combo</style></linktext> is empowered into <linktext=1105><style=\"ItemQuality_5\">Ultimate Slash</style></linktext>."},"135":{"name":"Swift","description":"Each <style=\"accent-gn\">1%</style> Haste provides <style=\"accent-gn\">1%</style> Attack Speed."},"136":{"name":"Thunder Sigil Charm","description":"Increases Max <linktext=1104><style=\"ItemQuality_5\">Thunder Sigil</style></linktext> by <style=\"accent-gn\">1</style>."},"137":{"name":"Swift Blade","description":"When <style=\"accent-gn\">Agility</style> reaches <style=\"accent-gn\">500</style> points, Crit DMG and Luck Damage +<style=\"accent-gn\">5%</style>."},"138":{"name":"Thunder Charm Blade","description":"For each <style=\"accent-gn\">1</style> <linktext=1104><style=\"ItemQuality_5\">Thunder Sigil</style></linktext> consumed by <style=\"accent-gn\">Expertise Skill</style>, gain an additional <style=\"accent-gn\">3</style> points of <linktext=1167><style=\"ItemQuality_5\">Blade Intent</style></linktext>.<br>For every consumption of Blade Intent, grants 20% DMG Reduction for 5s."},"139":{"name":"Infinite Thunder","description":"For every <style=\"accent-gn\">5</style> <linktext=1104><style=\"ItemQuality_5\">Thunder Sigils</style></linktext> consumed, the remaining CD of <linktext=1504><style=\"ItemQuality_5\">Volt Surge</style></linktext> -<style=\"accent-gn\">0.5s</style>."},"140":{"name":"Thunder Sigil Rewind","description":"When consuming <linktext=1104><style=\"ItemQuality_5\">Thunder Sigils</style></linktext>, there is a chance to return <style=\"accent-gn\">1</style> <linktext=1104><style=\"ItemQuality_5\">Thunder Sigil</style></linktext>, and for each additional <style=\"accent-gn\">1</style> <linktext=1104><style=\"ItemQuality_5\">Thunder Sigil</style></linktext> consumed, the return chance +<style=\"accent-gn\">9%</style>."},"141":{"name":"Thunder Might","description":"Activate <linktext=1504><style=\"ItemQuality_5\">Volt Surge</style></linktext>. <linktext=1501><style=\"ItemQuality_5\">Flash Strike</style></linktext> and <linktext=1554><style=\"ItemQuality_5\">Raijin Dash</style></linktext> evolve into <linktext=1584><style=\"ItemQuality_5\">Dracoflash</style></linktext> and <linktext=1585><style=\"ItemQuality_5\">Phantom Slash</style></linktext>."},"142":{"name":"Unmatched Raijin Dash","description":"<linktext=1554><style=\"ItemQuality_5\">Raijin Dash</style></linktext> and its enhanced skill (<linktext=1585><style=\"ItemQuality_5\">Phantom Slash</style></linktext>) ignore the target's Armor. <br><linktext=1554><style=\"ItemQuality_5\">Raijin Dash</style></linktext> and its enhanced skill (<linktext=1585><style=\"ItemQuality_5\">Phantom Slash</style></linktext>) deal <style=\"accent-gn\">10%</style> more damage per additional <style=\"accent-gn\">1</style> enemy hit."},"143":{"name":"Violent Slash","description":"Increases the critical rate of <linktext=1500><style=\"ItemQuality_5\">Iaido Slash</style></linktext> and <linktext=1588><style=\"ItemQuality_5\">Thunder Cut</style></linktext> by <style=\"accent-gn\">12%</style>."},"144":{"name":"Wind Assault II","description":"Crit Rate obtained in any way is increased by <style=\"accent-gn\">12%</style>, but Luck chance obtained in any way are reduced by <style=\"accent-gn\">10%</style>."},"145":{"name":"Dual Blade Intent","description":"When <linktext=1167><style=\"ItemQuality_5\">Blade Intent</style></linktext> is at least <style=\"accent-gn\">100</style>, <linktext=1501><style=\"ItemQuality_5\">Flash Strike</style></linktext>, <linktext=1554><style=\"ItemQuality_5\">Raijin Dash</style></linktext>, and their enhanced skills (<linktext=1584><style=\"ItemQuality_5\">Dracoflash</style></linktext>, <linktext=1585><style=\"ItemQuality_5\">Phantom Slash</style></linktext>) +<style=\"accent-gn\">10%</style> Crit and +<style=\"accent-gn\">20%</style> Thunder DMG.<br>When <linktext=1167><style=\"ItemQuality_5\">Blade Intent</style></linktext> is at least <style=\"accent-gn\">100</style>, greatly increases <linktext=1501><style=\"ItemQuality_5\">Flash Strike</style></linktext>'s and <linktext=1554><style=\"ItemQuality_5\">Raijin Dash</style></linktext>'s casting speed."},"146":{"name":"Thunder Sigil Affinity","description":"<style=\"accent-gn\">Each</style> additional <linktext=1104><style=\"ItemQuality_5\">Thunder Sigil</style></linktext> consumed by <style=\"accent-gn\">Expertise Skill</style> or <style=\"accent-gn\">Special Attacks</style> increases your Thunder DMG dealt by <style=\"accent-gn\">1.5%</style> when they deal DMG."},"147":{"name":"Thundrage","description":"Each use of <linktext=1584><style=\"ItemQuality_5\">Dracoflash</style></linktext> or <linktext=1585><style=\"ItemQuality_5\">Phantom Slash</style></linktext> grants <style=\"accent-gn\">4</style> stacks of <style=\"accent-gn\">Thundrage</style>, up to <style=\"accent-gn\">8</style> stacks."},"148":{"name":"Overdrive Refinement","description":"Reduces the CD of <linktext=1556><style=\"ItemQuality_5\">Overdrive</style></linktext> by <style=\"accent-gn\">30%</style>."},"149":{"name":"Blade Intent Thunderstrike","description":"When <linktext=1500><style=\"ItemQuality_5\">Iaido Slash</style></linktext> deals Crit DMG, if the <linktext=1167><style=\"ItemQuality_5\">Blade Intent</style></linktext> exceeds <style=\"accent-gn\">20</style>, launches <linktext=1100><style=\"ItemQuality_5\">Thunderstrike</style></linktext> (which can only be triggered once per use of <linktext=1500><style=\"ItemQuality_5\">Iaido Slash</style></linktext>)."},"150":{"name":"Thunder Sigil Charm","description":"Increases Max <linktext=1104><style=\"ItemQuality_5\">Thunder Sigil</style></linktext> by <style=\"accent-gn\">1</style>."},"151":{"name":"Break Slash","description":"When dealing Crit DMG, <linktext=1500><style=\"ItemQuality_5\">Iaido Slash</style></linktext> and its enhanced skill (<linktext=1588><style=\"ItemQuality_5\">Thunder Cut</style></linktext>) nullifies <style=\"accent-gn\">30%</style> of the targets' Armor."},"152":{"name":"Arcane","description":"Crit DMG <style=\"accent-gn\">+10%</style>"},"153":{"name":"Instant Slash","description":"<linktext=1500><style=\"ItemQuality_5\">Iaido Slash</style></linktext> reduces the Armor of the target hit by <style=\"accent-gn\">6%</style>. The effect lasts <style=\"accent-gn\">5s</style> and stacks up to <style=\"accent-gn\">5</style> times."},"154":{"name":"Advancement","description":"Mastery <style=\"accent-gn\">+6%</style>"},"155":{"name":"Thunder Scythe","description":"Reduces the <linktext=1586><style=\"ItemQuality_5\">Charge Seeds</style></linktext> that <linktext=1106><style=\"ItemQuality_5\">Storm Scythe</style></linktext> consumes by <style=\"accent-gn\">5</style>."},"156":{"name":"Blade Intent Recovery","description":"Each <style=\"accent-gn\">1%</style> Haste increases the REG SPD of <linktext=1167><style=\"ItemQuality_5\">Blade Intent</style></linktext> by <style=\"accent-gn\">1%</style>."},"157":{"name":"Moonstrike Spec","description":"Replaces <style=\"accent-gn\">Special Attack</style> with <linktext=1507><style=\"ItemQuality_5\">Moonstrike</style></linktext>, enhancing the ability.<br>Cast <linktext=1507><style=\"ItemQuality_5\">Moonstrike</style></linktext> to gain <style=\"accent-gn\">30</style> <linktext=1167><style=\"ItemQuality_5\">Blade Intent</style></linktext>.<br><br><i><style=\"text_third_gray\"><size=20>Frequent consumption of Thunder Sigils summons Moonblades to continuously attack the target. High Haste accelerates Moonblades' attacks. High Luck increases the frequency of Moonblades triggering Thunder Strike.</size></style></i>"},"158":{"name":"Divine Sickle","description":"Casting <linktext=1586><style=\"ItemQuality_5\">Storm Scythe</style></linktext> <style=\"accent-gn\">7</style> times triggers <linktext=1587><style=\"ItemQuality_5\">Divine Sickle</style></linktext>.<br><linktext=1587><style=\"ItemQuality_5\">Divine Sickle</style></linktext> is guaranteed to Crit.<br>When Luck is between <style=\"accent-gn\">28%</style> and <style=\"accent-gn\">45%</style>, <linktext=1587><style=\"ItemQuality_5\">Divine Sickle</style></linktext>'s Final DMG increases by <style=\"accent-gn\">150%</style>, but requires <style=\"accent-gn\">14</style> casts of <linktext=1586><style=\"ItemQuality_5\">Storm Scythe</style></linktext> to trigger.<br>When Luck chance is above <style=\"accent-gn\">45%</style>, Final DMG increases by <style=\"accent-gn\">275%</style>, but requires <style=\"accent-gn\">21</style> casts of <linktext=1586><style=\"ItemQuality_5\">Storm Scythe</style></linktext> to trigger."},"159":{"name":"Moonlight Charge","description":"If Luck chance exceeds <style=\"accent-gn\">25%</style>, <linktext=1101><style=\"ItemQuality_5\">Moonblades</style></linktext> trigger a Lucky Strike to gain <linktext=1106><style=\"ItemQuality_5\">Charge Seed</style></linktext>. Otherwise, when <linktext=1101><style=\"ItemQuality_5\">Moonblades</style></linktext> deal DMG, it has a fixed <style=\"accent-gn\">25%</style> chance to gain <linktext=1106><style=\"ItemQuality_5\">Charge Seed</style></linktext>."},"160":{"name":"Blade Intent - Rare","description":"Increases Max <linktext=1167><style=\"ItemQuality_5\">Blade Intent</style></linktext> by <style=\"accent-gn\">75</style>."},"161":{"name":"Thousand Thunder Flashes","description":"Every <style=\"accent-gn\">2</style> times <linktext=1100><style=\"ItemQuality_5\">Thunderstrike</style></linktext> is triggered, the CD of <linktext=1505><style=\"ItemQuality_5\">Stormflash</style></linktext> is reduced by <style=\"accent-gn\">0.7s</style>."},"162":{"name":"Chaos Breaker","description":"When <linktext=1505><style=\"ItemQuality_5\">Stormflash</style></linktext> is activated, <linktext=1507><style=\"ItemQuality_5\">Moonstrike</style></linktext> evolves into <linktext=1506><style=\"ItemQuality_5\">Chaos Breaker</style></linktext>."},"163":{"name":"Enhanced Thunderstrike","description":"Increases the DMG dealt by <linktext=1100><style=\"ItemQuality_5\">Thunderstrike</style></linktext> by <style=\"accent-gn\">20%</style>.<br>Each <style=\"accent-gn\">1%</style> Luck grants <linktext=1100><style=\"ItemQuality_5\">Thunderstrike</style></linktext> <style=\"accent-gn\">1%</style> more DMG dealt."},"164":{"name":"Charge Catcher","description":"<style=\"accent-gn\">Each</style> enemy defeated grants <style=\"accent-gn\">1</style> <linktext=1106><style=\"ItemQuality_5\">Charge Seed</style></linktext> (effective within a team)."},"165":{"name":"Thunderstrike Whisper","description":"Increases the Thunder DMG <linktext=1100><style=\"ItemQuality_5\">Thunderstrike</style></linktext> deals by <style=\"accent-gn\">50%</style>, yet <linktext=1100><style=\"ItemQuality_5\">Thunderstrike</style></linktext> never deals Crit DMG."},"166":{"name":"Moonstrike Sharp Strike","description":"When <linktext=1167><style=\"ItemQuality_5\">Blade Intent</style></linktext> is at least <style=\"accent-gn\">50</style>, <linktext=1507><style=\"ItemQuality_5\">Moonstrike</style></linktext> and its enhanced skill (<linktext=1506><style=\"ItemQuality_5\">Chaos Breaker</style></linktext>) are guaranteed to land a Crit."},"167":{"name":"Thunder Sigil Charm","description":"Increases Max <linktext=1104><style=\"ItemQuality_5\">Thunder Sigil</style></linktext> by <style=\"accent-gn\">1</style>. <br>During <linktext=1505><style=\"ItemQuality_5\">Stormflash</style></linktext>, each trigger of <linktext=1586><style=\"ItemQuality_5\">Storm Scythe</style></linktext> extends its duration by <style=\"accent-gn\">0.5s</style>, up to <style=\"accent-gn\">5s</style>."},"168":{"name":"Thunder Rune Mastery","description":"Doubles Max <linktext=1167><style=\"ItemQuality_5\">Blade Intent</style></linktext>."},"169":{"name":"Raijin Dash Charge","description":"When <linktext=1503><style=\"ItemQuality_5\">Thundercut</style></linktext> triggers a Lucky Strike, grants <style=\"accent-gn\">1</style> <linktext=1106><style=\"ItemQuality_5\">Charge Seed</style></linktext>."},"170":{"name":"Moonblade Swift","description":"<linktext=1101><style=\"ItemQuality_5\">Moonblades</style></linktext> additionally deal <style=\"accent-gn\">1</style> instance of Whirling DMG every <style=\"accent-gn\">6s</style>. Each <style=\"accent-gn\">2%</style> Haste reduces its CD by <style=\"accent-gn\">1%</style>."},"171":{"name":"Thunder Might","description":"During <linktext=1505><style=\"ItemQuality_5\">Stormflash</style></linktext>, <linktext=1586><style=\"ItemQuality_5\">Storm Scythe</style></linktext> will activate twice in succession."},"172":{"name":"Thunder Sigil Rewind","description":"During <linktext=1504><style=\"ItemQuality_5\">Volt Surge</style></linktext>, the return chance of Thunder Sigil Rewind doubles, but the damage bonus of <style=\"accent-gn\">non-derivative</style> skills that consume <linktext=1104><style=\"ItemQuality_5\">Thunder Sigil</style></linktext> is reduced from <style=\"accent-gn\">25%</style> to <style=\"accent-gn\">20%</style>."},"173":{"name":"Luck Enhancement","description":"Lucky Strike ATK +<style=\"accent-gn\">100%</style>."},"200":{"name":"Cold Intent - Sharp","description":"Max <style=\"accent-gn\">Ice Energy</style> +<style=\"accent-gn\">10</style>.<br><style=\"accent-gn\">Special Attack</style> DMG +<style=\"accent-gn\">12%</style>."},"201":{"name":"Intellect Conversion","description":"Every <style=\"accent-gn\">10</style> Intellect grants <style=\"accent-gn\">1</style> MATK."},"202":{"name":"Frost Curse Sigil","description":"When a <style=\"accent-gn\">Special Attack</style> deals DMG, it has a fixed <style=\"accent-gn\">5%</style> chance to <linktext=1171><style=\"ItemQuality_5\">Frozen</style></linktext> the target."},"203":{"name":"Ice Revelation","description":"Summons <style=\"accent-gn\">2</style> permanent <style=\"accent-gn\">Ice Crystal Cores</style> that float beside you. <br><style=\"accent-gn\">Ice Crystal Core</style><br>When <style=\"accent-gn\">Basic Attacks</style> deal DMG, <style=\"accent-gn\">Ice Crystal Cores</style> have a fixed <style=\"accent-gn\">10%</style> chance to fire <style=\"accent-gn\">2</style> <style=\"accent-gn\">Ice Arrows</style>. <br><style=\"accent-gn\">Ice Arrow</style>: Each arrow deals <style=\"magic\">Magic DMG</style> equal to <style=\"accent-gn\">28%</style> ATK to the target and grants <style=\"accent-gn\">1</style> <linktext=1161><style=\"ItemQuality_5\">Frost Crystal</style></linktext> (up to <style=\"accent-gn\">2</style> <linktext=1161><style=\"ItemQuality_5\">Frost Crystals</style></linktext> can be stored)."},"204":{"name":"Breath of Frost","description":"<linktext=1161><style=\"ItemQuality_5\">Frost Crystal</style></linktext> cap +<style=\"accent-gn\">1</style>."},"206":{"name":"Tide Mastery","description":"While casting <linktext=1509><style=\"ItemQuality_5\">Frostbeam</style></linktext>, you can channel <linktext=1508><style=\"ItemQuality_5\">Tidepool</style></linktext> and <linktext=1558><style=\"ItemQuality_5\">Maelstrom</style></linktext>."},"207":{"name":"Crystal Resonance","description":"When <linktext=1509><style=\"ItemQuality_5\">Frostbeam</style></linktext> deals DMG, it has a <style=\"accent-gn\">30%</style> fixed chance to make <style=\"accent-gn\">Ice Crystal Core</style> fire an <style=\"accent-gn\">Ice Arrow</style>. Up to 1 <style=\"accent-gn\">Ice Arrow</style> can be fired every <style=\"accent-gn\">0</style>.<style=\"accent-gn\">5s</style>.<br><style=\"accent-gn\">The final DMG of the Ice Arrow</style> is doubled (this also affects DMG triggered by the Frost Explosion talent)."},"208":{"name":"Frost Explosion","description":"When <style=\"accent-gn\">Ice Arrows</style> fired by <style=\"accent-gn\">Ice Crystal Cores</style> deal a Crit, they deal an additional instance of <style=\"magic\">Magic DMG</style> equal to <style=\"accent-gn\">28%</style> ATK. This DMG can trigger Lucky Strike."},"209":{"name":"Ice Crystal Expansion","description":"Max <style=\"accent-gn\">Ice Energy</style> +<style=\"accent-gn\">40</style>."},"210":{"name":"Ice Shard Pact","description":"Increases <linktext=1558><style=\"ItemQuality_5\">Maelstrom</style></linktext>'s <style=\"accent-gn\">Ice Energy</style> recovery rate by <style=\"accent-gn\">200%</style>."},"211":{"name":"Cold Wind Convergence","description":"When <linktext=1514><style=\"ItemQuality_5\">Frozen Gale</style></linktext> hits a target (only triggers once when hitting multiple targets), it consumes all <linktext=1161><style=\"ItemQuality_5\">Frost Crystals</style></linktext> to summon <linktext=1162><style=\"ItemQuality_5\">Icy Bolt</style></linktext>, with the number of <linktext=1162><style=\"ItemQuality_5\">Icy Bolt</style></linktext> equal to the consumed <linktext=1161><style=\"ItemQuality_5\">Frost Crystals</style></linktext>.<br><linktext=1162><style=\"ItemQuality_5\">Icy Bolt</style></linktext> deals DMG, restores <style=\"accent-gn\">5</style> <style=\"accent-gn\">Ice Energy</style>, and reduces the <style=\"accent-gn\">Ice Energy</style> cost of skills by <style=\"accent-gn\">3%</style> for the next <style=\"accent-gn\">15s</style>, stacking up to <style=\"accent-gn\">6</style> times."},"212":{"name":"Frostbeam Spec","description":"Replaces <style=\"accent-gn\">Special Attack</style> with <linktext=1509><style=\"ItemQuality_5\">​Frostbeam​</style></linktext> and enhances the skill.<br>Every <linktext=1161><style=\"ItemQuality_5\">Frost Crystal</style></linktext> increases <linktext=1509><style=\"ItemQuality_5\">​Frostbeam​</style></linktext> DMG by <style=\"accent-gn\">15%</style>. Each <style=\"accent-gn\">10%</style> Mastery grants an additional <style=\"accent-gn\">0.85%</style> DMG bonus (up to <style=\"accent-gn\">5%</style>) and increases the <style=\"accent-gn\">Ice Energy</style> consumed by <style=\"accent-gn\">30%</style>.<br>When <linktext=1509><style=\"ItemQuality_5\">​Frostbeam​</style></linktext> hits a target, every <style=\"accent-gn\">13</style> hits reduce the remaining CD of <linktext=1515><style=\"ItemQuality_5\">Permafrost</style></linktext>by <style=\"accent-gn\">1s</style> (hitting multiple targets only counts once).<br><br><i><style=\"text_third_gray\"><size=20>Consumes Ice Energy to channel Frostbeam continuously at the target. High Haste and Mastery greatly speed up its channeling while improving Ice Energy recovery.</size></style></i>"},"214":{"name":"Snow Shadow","description":"For every <style=\"accent-gn\">25</style> <style=\"accent-gn\">Ice Energy</style> consumed, the CD of <linktext=1510><style=\"ItemQuality_5\">Crystal Veil</style></linktext> -<style=\"accent-gn\">1</style>s."},"215":{"name":"Frost Comet","description":"When <linktext=1512><style=\"ItemQuality_5\">Frost Lance</style></linktext> that consumes <linktext=1161><style=\"ItemQuality_5\">Frost Crystals</style></linktext> deals DMG, there is a fixed <style=\"accent-gn\">21%</style> chance to summon <linktext=1165><style=\"ItemQuality_5\">Frost Comet</style></linktext>."},"216":{"name":"Frozen Stars","description":"When <linktext=1512><style=\"ItemQuality_5\">Frost Lance</style></linktext> triggers both a Crit and a Lucky Strike, <linktext=1511><style=\"ItemQuality_5\">Meteor Storm</style></linktext>'s CD is immediately reset. If <linktext=1511><style=\"ItemQuality_5\">Meteor Storm</style></linktext> is already off cooldown, <linktext=1511><style=\"ItemQuality_5\">it</style></linktext> will be automatically cast (but this <linktext=1511><style=\"ItemQuality_5\">Meteor Storm</style></linktext> will deal half damage). This effect can trigger up to 3 times within 1.5s (affected by Attack Speed)."},"217":{"name":"Blizzard Dual Lances","description":"Within <style=\"accent-gn\">8s</style> after casting <linktext=1513><style=\"ItemQuality_5\">Blizzard</style></linktext>, <linktext=1512><style=\"ItemQuality_5\">Frost Lance</style></linktext> can fire an additional <linktext=1512><style=\"ItemQuality_5\">Frost Lance</style></linktext> at another target near the original one."},"219":{"name":"Stormy Encounter","description":"When <linktext=1510><style=\"ItemQuality_5\">Crystal Veil</style></linktext> deals DMG, it has a fixed chance to reduce the CD of <linktext=1513><style=\"ItemQuality_5\">Blizzard</style></linktext> by <style=\"accent-gn\">1</style>s. The chance equals half percentage of your Luck."},"220":{"name":"Shattering Strike","description":"When <linktext=1511><style=\"ItemQuality_5\">Meteor Storm</style></linktext> deals DMG, it causes <style=\"accent-gn\">Ice Crystal Cores</style> to fire <style=\"accent-gn\">Ice Arrows</style>. This effect can trigger up to once per <linktext=1511><style=\"ItemQuality_5\">Meteor Storm</style></linktext> cast."},"221":{"name":"Glacier fury","description":"Consuming <style=\"accent-gn\">15</style> <linktext=1161><style=\"ItemQuality_5\">Frost Crystals</style></linktext> enhances the next <linktext=1513><style=\"ItemQuality_5\">Blizzard</style></linktext>. <br><linktext=1513><style=\"ItemQuality_5\">Blizzard</style></linktext>: Bypasses the casting time and increases DMG dealt by <style=\"accent-gn\">30%</style>, and trigger Lucky Strike."},"222":{"name":"Icicle Volley","description":"For every <style=\"accent-gn\">10</style> casts of <linktext=1512><style=\"ItemQuality_5\">Frost Lance</style></linktext>, a <linktext=1164><style=\"ItemQuality_5\">Piercing Ice Lance</style></linktext> is launched forward."},"223":{"name":"Glazed Vastness","description":"Ice skills deal <style=\"accent-gn\">8%</style> more DMG to Elites and stronger targets."},"224":{"name":"Continuous Stream","description":"Dealing DMG triggers <style=\"accent-gn\">Trickle</style>.<br><style=\"accent-gn\">Trickle</style>: Grants a <style=\"accent-gn\">1%</style> Ice damage bonus for <style=\"accent-gn\">6</style>s, stacking up to <style=\"accent-gn\">5</style> times."},"225":{"name":"Boundless Frost","description":"Every <style=\"accent-gn\">50</style> <style=\"accent-gn\">Ice Energy</style> consumed grants <style=\"accent-gn\">1</style> <linktext=1161><style=\"ItemQuality_5\">Frost Crystal</style></linktext>.<br>Max <linktext=1161><style=\"ItemQuality_5\">Frost Crystal</style></linktext> +<style=\"accent-gn\">3</style>. Each possessed <linktext=1161><style=\"ItemQuality_5\">Frost Crystal</style></linktext> increases <linktext=1509><style=\"ItemQuality_5\">Frostbeam</style></linktext> DMG by <style=\"accent-gn\">5%</style>."},"226":{"name":"Frost Shock","description":"When an <style=\"accent-gn\">Expertise Skill</style> or <style=\"accent-gn\">Ultimate</style> lands a Lucky Strike, it has a fixed <style=\"accent-gn\">30%</style> chance to trigger <linktext=1163><style=\"ItemQuality_5\">Frost Shock</style></linktext>, once every <style=\"accent-gn\">3s</style>."},"227":{"name":"Quick Frozen Blast","description":"When an <style=\"accent-gn\">Expertise Skill</style> or <style=\"accent-gn\">Ultimate</style> deals DMG to a target with <linktext=1171><style=\"ItemQuality_5\">Frozen</style></linktext>, it triggers <linktext=1163><style=\"ItemQuality_5\">Frost Shock</style></linktext>, once <style=\"accent-gn\">per</style> second."},"228":{"name":"Icy Calm","description":"Each additional target hit by an <style=\"accent-gn\">Expertise Skill</style> or <style=\"accent-gn\">Ultimate</style> grants a <style=\"accent-gn\">2%</style> bonus to your highest stat among Mastery, Haste, Crit, or Luck for <style=\"accent-gn\">5</style>s. Hitting more than 5 additional targets still only counts as <style=\"accent-gn\">5</style>."},"229":{"name":"Instant Cooling","description":"Every <style=\"accent-gn\">35</style> <style=\"accent-gn\">Ice Energy</style> consumed reduces the remaining CD of <linktext=1511><style=\"ItemQuality_5\">Meteor Storm</style></linktext> and <linktext=1514><style=\"ItemQuality_5\">Frozen Gale</style></linktext> by <style=\"accent-gn\">1.3s</style>."},"230":{"name":"Cold Stream","description":"Max <style=\"accent-gn\">Ice Energy</style> +<style=\"accent-gn\">25</style>.<br>Every <style=\"accent-gn\">1%</style> Haste increases <style=\"accent-gn\">Ice Energy</style>'s auto REG SPD by <style=\"accent-gn\">1%</style>."},"231":{"name":"Frostjade Staff","description":"When <style=\"accent-gn\">Ice Arrow</style> cast with <style=\"accent-gn\">Ice Crystal Core</style> deals DMG, restores <style=\"accent-gn\">1</style> <style=\"accent-gn\">Ice Energy</style>.<br>In the <linktext=1515><style=\"ItemQuality_5\">Permafrost</style></linktext> status, the recovery doubles."},"233":{"name":"Icicle Spec","description":"Further enhances <linktext=1512><style=\"ItemQuality_5\">Frost Lance</style></linktext>.<br>When <linktext=1512><style=\"ItemQuality_5\">Frost Lance</style></linktext> deals Crit DMG, there is a fixed <style=\"accent-gn\">30%</style> chance for <style=\"accent-gn\">Ice Crystal Cores</style> to fire <style=\"accent-gn\">Ice Arrows</style>.<br><br><i><style=\"text_third_gray\"><size=20>Time your use of Ice Energy to chant and launch Frost Lance. Crit and Luck increase the chance to skip chanting and significantly boost the lance's DMG.</size></style></i>"},"234":{"name":"Frost Domain","description":"The area of <linktext=1516><style=\"ItemQuality_5\">Glacier Hymn</style></linktext> -<style=\"accent-gn\">50%</style>. While within the domain, you gain a <style=\"accent-gn\">25%</style> Ice bonus."},"235":{"name":"Cold Pulse","description":"Every <style=\"accent-gn\">50</style> hits by <linktext=1509><style=\"ItemQuality_5\">Frostbeam</style></linktext> trigger a <linktext=1166><style=\"ItemQuality_5\">Cold Pulse</style></linktext>.<br>For each additional enemy hit, increases <linktext=1166><style=\"ItemQuality_5\">Cold Pulse</style></linktext> DMG by <style=\"accent-gn\">20%</style>, up to <style=\"accent-gn\">500%</style>."},"236":{"name":"Intellect Cooling","description":"When <style=\"accent-gn\">Intellect</style> reaches <style=\"accent-gn\">300</style>, skill CD -<style=\"accent-gn\">10%</style>."},"237":{"name":"Secondary Amp","description":"Boost the highest stat among the following <style=\"accent-gn\">5</style> stats: Crit, Haste, Luck, Mastery, and Versatility by <style=\"accent-gn\">3.5%</style> as a final value."},"238":{"name":"Cold Intent - Flow","description":"<style=\"accent-gn\">Ice Energy</style> cap +<style=\"accent-gn\">40</style>.<br><style=\"accent-gn\">Special Attack</style> damage +<style=\"accent-gn\">4%</style>."},"239":{"name":"Ice Comet","description":"When <style=\"accent-gn\">Intellect</style> reaches <style=\"accent-gn\">500</style>, gain <style=\"accent-gn\">5%</style> Ice bonus."},"240":{"name":"Endless Cold","description":"Every <style=\"accent-gn\">20</style> <linktext=1161><style=\"ItemQuality_5\">Frost Crystals</style></linktext> consumed grants <style=\"accent-gn\">Endless Cold</style> effect. <br><style=\"accent-gn\">Endless Cold</style>: For <style=\"accent-gn\">10s</style>, increases <linktext=1511><style=\"ItemQuality_5\">Meteor Storm</style></linktext> DMG by <style=\"accent-gn\">150%</style>, and removes its CD and <style=\"accent-gn\">Ice Energy</style> cost. During this period, <style=\"accent-gn\">Ice Arrows</style> triggered by <linktext=1511><style=\"ItemQuality_5\">Meteor Storm</style></linktext> cannot produce <linktext=1161><style=\"ItemQuality_5\">Frost Crystal</style></linktext>.<br>When <style=\"accent-gn\">Endless Cold</style> is triggered during <linktext=1515><style=\"ItemQuality_5\">Permafrost</style></linktext>, enter the <style=\"accent-gn\">Endless Cold</style> state after the effect of <linktext=1515><style=\"ItemQuality_5\">Permafrost</style></linktext> ends. If the number of <linktext=1161><style=\"ItemQuality_5\">Frost Crystals</style></linktext> consumed during this period exceeds <style=\"accent-gn\">20</style>, proportionally increase the final damage dealt by <linktext=1511><style=\"ItemQuality_5\">Meteor Storm</style></linktext> (up to <style=\"accent-gn\">100%</style>)."},"241":{"name":"Frost Lance Barrage","description":"During <linktext=1512><style=\"ItemQuality_5\">Permafrost</style></linktext>, <linktext=1515><style=\"ItemQuality_5\">Frost Lance</style></linktext> fires <style=\"accent-gn\">2</style> consecutive shots."},"242":{"name":"Freezing Meteor Storm","description":"When <linktext=1511><style=\"ItemQuality_5\">Meteor Storm</style></linktext> deals damage, <style=\"accent-gn\">20%</style> chance to apply <linktext=1171><style=\"ItemQuality_5\">Frozen</style></linktext> to the target.<br>Throughout the duration of <linktext=1515><style=\"ItemQuality_5\">Permafrost</style></linktext>, when <linktext=1512><style=\"ItemQuality_5\">Frost Lance</style></linktext> and <linktext=1511><style=\"ItemQuality_5\">Meteor Storm</style></linktext> critically hit, extends the duration of <linktext=1515><style=\"ItemQuality_5\">Permafrost</style></linktext> by <style=\"accent-gn\">0.5s</style>, up to <style=\"accent-gn\">5s</style> of extension."},"243":{"name":"Energy Saving","description":"When consuming <linktext=1161><style=\"ItemQuality_5\">Frost Crystal</style></linktext> to cast <linktext=1512><style=\"ItemQuality_5\">Frost Lance</style></linktext>, refunds <style=\"accent-gn\">50%</style> of the <style=\"accent-gn\">Ice Energy</style> consumed after the cast.<br>When casting <linktext=1512><style=\"ItemQuality_5\">Frost Lance</style></linktext> without consuming <linktext=1161><style=\"ItemQuality_5\">Frost Crystal</style></linktext>, an additional <style=\"accent-gn\">50%</style> of the <style=\"accent-gn\">Ice Energy</style> consumed is deducted after the cast."},"244":{"name":"Frost Blade","description":"<linktext=1512><style=\"ItemQuality_5\">Frost Lances</style></linktext> that consume <linktext=1161><style=\"ItemQuality_5\">Frost Crystal</style></linktext> deal <style=\"accent-gn\">30%</style> more DMG."},"245":{"name":"Deep Cold Magic Spear","description":"<linktext=1512><style=\"ItemQuality_5\">Frost Lance</style></linktext> deals <style=\"accent-gn\">70%</style> more DMG.<br><linktext=1512><style=\"ItemQuality_5\">Frost Lance</style></linktext> costs <style=\"accent-gn\">100%</style> more time to use."},"246":{"name":"Meteor Storm Expansion","description":"<linktext=1511><style=\"ItemQuality_5\">Meteor Storm</style></linktext> hit count +<style=\"accent-gn\">1</style>. <br><linktext=1511><style=\"ItemQuality_5\">Meteor Storm</style></linktext> gains <style=\"accent-gn\">10%</style> Ice Bonus."},"247":{"name":"Frost Lance Crit","description":"<linktext=1512><style=\"ItemQuality_5\">Frost Lance</style></linktext> deals <style=\"accent-gn\">1.5%</style> more Crit DMG. The effect lasts <style=\"accent-gn\">6s</style> and stacks up to <style=\"accent-gn\">10</style> times."},"248":{"name":"Infusion Sublimation","description":"Increases Max <linktext=1161><style=\"ItemQuality_5\">Frost Crystal</style></linktext> by <style=\"accent-gn\">1</style>.<br>During <linktext=1515><style=\"ItemQuality_5\">Permafrost</style></linktext>, Ice ATK increases by <style=\"accent-gn\">150</style>.<br>When <linktext=1515><style=\"ItemQuality_5\">Permafrost</style></linktext> ends, your <linktext=1161><style=\"ItemQuality_5\">Frost Crystal</style></linktext> resets to the amount you had before the activation of <linktext=1515><style=\"ItemQuality_5\">Permafrost</style></linktext>."},"249":{"name":"Deadly Frost Lance","description":"<linktext=1512><style=\"ItemQuality_5\">Frost Lance</style></linktext> deals <style=\"accent-gn\">20%</style> more DMG to targets with HP less than <style=\"accent-gn\">35%</style>"},"250":{"name":"Critical Cold","description":"During <linktext=1515><style=\"ItemQuality_5\">Permafrost</style></linktext>, increases Crit DMG dealt by <style=\"accent-gn\">15%</style>.<br>During <linktext=1515><style=\"ItemQuality_5\">Permafrost</style></linktext>, increases allies' critical rate by <style=\"accent-gn\">3%</style>."},"251":{"name":"Bitter Cold","description":"Every <style=\"accent-gn\">265</style> <style=\"accent-gn\">Intellect</style> grants <style=\"accent-gn\">0.5%</style> bonus Crit DMG."},"252":{"name":"Sharp Blizzard","description":"Increases the critical rate of <linktext=1513><style=\"ItemQuality_5\">Blizzard</style></linktext> by <style=\"accent-gn\">50%</style>.<br>Increases the Crit DMG of <linktext=1513><style=\"ItemQuality_5\">Blizzard</style></linktext> by <style=\"accent-gn\">15%</style>."},"253":{"name":"Frost Crystal Empowerment","description":"<style=\"accent-gn\">Each</style> <linktext=1161><style=\"ItemQuality_5\">Frost Crystal</style></linktext> consumed increases <style=\"accent-gn\">Intellect</style> by <style=\"accent-gn\">55</style>. This effect lasts <style=\"accent-gn\">10</style>s and stacks up to <style=\"accent-gn\">5</style> times."},"254":{"name":"Frost Assault","description":"<linktext=1513><style=\"ItemQuality_5\">Blizzard</style></linktext> reduces the Ice Resistance of targets hit by <style=\"accent-gn\">10%</style>. The effect lasts <style=\"accent-gn\">10s</style> and does not stack, and only works on your own."},"255":{"name":"Luck Damage","description":"Lucky Strike DMG Multiplier +<style=\"accent-gn\">15%</style>. <br>Every <style=\"accent-gn\">2%</style> Luck grants <style=\"accent-gn\">1%</style> Lucky Strike DMG Multiplier."},"256":{"name":"Cold Retention","description":"In the <linktext=1515><style=\"ItemQuality_5\">Permafrost</style></linktext> status, the cost of <linktext=1509><style=\"ItemQuality_5\">Frostbeam</style></linktext> decreases by <style=\"accent-gn\">25%</style>."},"257":{"name":"Frost Revelation","description":"The first hit of <linktext=1508><style=\"ItemQuality_5\">Tidepool</style></linktext> on the target grants <style=\"accent-gn\">5</style> <style=\"accent-gn\">Ice Energy</style>. Each additional <linktext=1161><style=\"ItemQuality_5\">Frost Crystal</style></linktext> increases <style=\"accent-gn\">Ice Energy</style> restored by <style=\"accent-gn\">10</style>."},"258":{"name":"Law of Energy Surge","description":"Every <style=\"accent-gn\">50</style> <style=\"accent-gn\">Ice Arrows</style> shot increases the DMG of your next <linktext=1514><style=\"ItemQuality_5\">Frozen Gale</style></linktext> by <style=\"accent-gn\">200%</style> for <style=\"accent-gn\">30s</style>. Additionally, casting <linktext=1514><style=\"ItemQuality_5\">Frozen Gale</style></linktext> grants the <linktext=1130><style=\"ItemQuality_5\">Law of Energy Surge</style></linktext>."},"259":{"name":"Power of Ice Crystals","description":"When <style=\"accent-gn\">Ice Energy</style> is above <style=\"accent-gn\">50%</style>, deals <style=\"accent-gn\">8%</style> more Ice damage."},"260":{"name":"Ice Crystal Recovery","description":"When <style=\"accent-gn\">Ice Energy</style> is below <style=\"accent-gn\">50%</style>, enhances the recovery rate of <style=\"accent-gn\">Ice Energy</style> by <style=\"accent-gn\">10%</style>."},"261":{"name":"Rapid Ice Arrow","description":"During <linktext=1515><style=\"ItemQuality_5\">Permafrost</style></linktext>, <linktext=1509><style=\"ItemQuality_5\">Frostbeam</style></linktext> fires <style=\"accent-gn\">2</style> additional <style=\"accent-gn\">Ice Arrows</style> generated by <style=\"accent-gn\">Ice Crystal Core</style>."},"262":{"name":"Endless Tide","description":"During <linktext=1515><style=\"ItemQuality_5\">Permafrost</style></linktext>, each <style=\"accent-gn\">Ice Arrow</style> triggered by <style=\"accent-gn\">Ice Crystal Core</style> extends the duration of <linktext=1515><style=\"ItemQuality_5\">Permafrost</style></linktext> by <style=\"accent-gn\">0.5s</style>, up to <style=\"accent-gn\">5s</style>."},"263":{"name":"Frost Tide","description":"When dealing DMG, <linktext=1509><style=\"ItemQuality_5\">Frostbeam</style></linktext> has a fixed <style=\"accent-gn\">20%</style> chance to grant <linktext=1161><style=\"ItemQuality_5\">Frost Crystal</style></linktext>. If Max <linktext=1161><style=\"ItemQuality_5\">Frost Crystal</style></linktext> is reached, grants <style=\"accent-gn\">5%</style> bonus Ice damage dealt instead for <style=\"accent-gn\">3s</style>."},"264":{"name":"Ray Mastery I","description":"<linktext=1509><style=\"ItemQuality_5\">Frostbeam</style></linktext> deals <style=\"accent-gn\">2%</style> more Ice damage.<br><linktext=1509><style=\"ItemQuality_5\">Frostbeam</style></linktext> deals <style=\"accent-gn\">5%</style> more Ice damage to the main target."},"265":{"name":"Wide Area Ice Arrow","description":"Every <style=\"accent-gn\">10</style> hits of <style=\"accent-gn\">Expertise Skill</style> allows <style=\"accent-gn\">Ice Crystal Core</style> to fire <style=\"accent-gn\">Ice Arrow</style> (triggers up to once every <style=\"accent-gn\">0.5</style>s)."},"266":{"name":"Intellect Ice Crystal","description":"Every <style=\"accent-gn\">50</style> <style=\"accent-gn\">Intellect</style> grants <style=\"accent-gn\">1</style> Max <style=\"accent-gn\">Ice Energy</style>, up to <style=\"accent-gn\">100</style> from this source."},"267":{"name":"Quick Chant","description":"Increases Haste by <style=\"accent-gn\">2500</style>.<br>During <linktext=1515><style=\"ItemQuality_5\">Permafrost</style></linktext>, Casting SPD increases by <style=\"accent-gn\">15%</style>."},"268":{"name":"Sharp Ice Arrow","description":"<style=\"accent-gn\">Ice Arrows</style> from <style=\"accent-gn\">Ice Crystal Core</style> are guaranteed to Crit.<br><style=\"accent-gn\">Increases the Crit DMG of Ice Arrows</style> from <style=\"accent-gn\">Ice Crystal Core</style> by <style=\"accent-gn\">10%</style>."},"269":{"name":"Ray's Swan Song","description":"When dealing DMG, <linktext=1509><style=\"ItemQuality_5\">Frostbeam</style></linktext> gains a fixed <style=\"accent-gn\">10%</style> chance to double <style=\"accent-gn\">Mastery</style> for 3s (which can only be triggers once on multiple hits)."},"270":{"name":"Ice Crystal Expansion","description":"Max <style=\"accent-gn\">Ice Energy</style> +<style=\"accent-gn\">40</style>."},"271":{"name":"Intellect Amp","description":"Increases <style=\"accent-gn\">Intellect</style> by <style=\"accent-gn\">5%</style>."},"300":{"name":"Power Conversion","description":"Every <style=\"accent-gn\">8</style> Strength grants <style=\"accent-gn\">1</style> ATK."},"301":{"name":"Swift Turn","description":"For every <style=\"accent-gn\">1%</style> Haste, gains <style=\"accent-gn\">1%</style> Attack SPD."},"302":{"name":"Infernal Combo","description":"When <style=\"accent-gn\">Special Attacks</style> or <style=\"accent-gn\">Basic Attacks</style> deal damage, grants <linktext=1211><style=\"ItemQuality_5\">Infernal Combo</style></linktext> (triggers only once when hitting multiple targets)."},"303":{"name":"Crimson Lotus","description":"Gain adaptive effects when <linktext=1211><style=\"ItemQuality_5\">Infernal Combo</style></linktext> reaches max stacks:<br><br><style=\"accent-gn\">Formless Spec</style>: ATK +<style=\"accent-gn\">8%</style>.<br><style=\"accent-gn\">Crimson Spec</style>: <style=\"accent-gn\">Crimson Recovery</style> effect +<style=\"accent-gn\">10%</style>."},"304":{"name":"Crimson Flame Pursuit","description":"<style=\"accent-gn\">Special Attack</style> hits cause the target to take +<style=\"accent-gn\">2.5%</style> DMG. The effect lasts <style=\"accent-gn\">8</style>s and stacks up to <style=\"accent-gn\">3</style> times."},"305":{"name":"Wild Soul - Break","description":"When <style=\"accent-gn\">Strength</style> reaches <style=\"accent-gn\">500</style> points, <style=\"accent-gn\">Expertise Skill</style> damage +<style=\"accent-gn\">5%</style>."},"306":{"name":"Crimson Lotus Duality","description":"Each stack of <linktext=1211><style=\"ItemQuality_5\">Infernal Combo</style></linktext> grants effects based on the relationship between Luck Chance and Crit Chance:<br><br>When Luck Chance is greater than or equal to Crit Chance, each stack of <linktext=1211><style=\"ItemQuality_5\">Infernal Combo</style></linktext> grants <style=\"accent-gn\">1.6%</style> Lucky Strike Multiplier.<br>When Crit Chance is greater than Luck Chance, each stack of <linktext=1211><style=\"ItemQuality_5\">Infernal Combo</style></linktext> grants <style=\"accent-gn\">1.2%</style> Crit DMG."},"307":{"name":"Flame Soul Seal","description":"<style=\"accent-gn\">Flame Soul</style> cap +<style=\"accent-gn\">50</style>.<br>Every <style=\"accent-gn\">50</style> <style=\"accent-gn\">Flame Soul</style> gained triggers <linktext=1211><style=\"ItemQuality_5\">Infernal Combo</style></linktext>."},"308":{"name":"Wild Soul - Swift","description":"When <style=\"accent-gn\">Strength</style> reaches <style=\"accent-gn\">300</style> points, the effect of the talent <linktext=1211><style=\"ItemQuality_5\">Infernal Combo</style></linktext> is increased by <style=\"accent-gn\">50%</style>."},"309":{"name":"Ember Epiphany","description":"Grants the <linktext=1218><style=\"ItemQuality_5\">Flame Suppression</style></linktext> specialization effect."},"310":{"name":"Crimson Lotus Ember Epiphany","description":"While in the <linktext=1211><style=\"ItemQuality_5\">Infernal Combo</style></linktext> state, the <linktext=1218><style=\"ItemQuality_5\">Flame Suppression</style></linktext> effect is increased by <style=\"accent-gn\">50%</style>."},"311":{"name":"Soaring Crimson Flame Pursuit","description":"Enhances Crimson Flame Pursuit based on the target's lost HP:<br><br>When the target's HP is below <style=\"accent-gn\">80%</style>, enhances the base effect by <style=\"accent-gn\">30%</style>.<br>The lower the target's HP, the higher the bonus, up to a maximum enhancement of <style=\"accent-gn\">100%</style> when the target's HP drops to <style=\"accent-gn\">30%</style>."},"312":{"name":"Formless Expertise Spec","description":"By using different <style=\"accent-gn\">Special Attacks</style> and <style=\"accent-gn\">Expertise Skills</style>, the <style=\"accent-gn\">Formless</style> level can be raised from E to S (a total of <style=\"accent-gn\">6</style> levels). During its <style=\"accent-gn\">8</style>s duration, each <style=\"accent-gn\">1</style> level grants <linktext=1622><style=\"ItemQuality_5\">Blazing Assault</style></linktext>, <linktext=1623><style=\"ItemQuality_5\">Rage Cleave</style></linktext>, and <linktext=1624><style=\"ItemQuality_5\">Axe Wind</style></linktext> a <style=\"accent-gn\">2%</style> CD Speed increase.<br><br><i><style=\"text_third_gray\"><size=20>Trigger Formless effects to accelerate CDs, chain Blazing Assault to boost Expertise Skill DMG, and combine with the core Formless Flame Slash mechanic to deal massive combo DMG.</size></style></i>"},"313":{"name":"Blazing Pact","description":"After casting <linktext=1622><style=\"ItemQuality_5\">Blazing Assault</style></linktext>, the next <style=\"accent-gn\">Expertise Skill</style> deals +<style=\"accent-gn\">20%</style> Final DMG, but its Crit Chance is halved."},"314":{"name":"Soaring Flame","description":"After gaining <style=\"accent-gn\">Formless</style> <style=\"accent-gn\">6</style> times or activating <linktext=1625><style=\"ItemQuality_5\">Wasteland's End</style></linktext>, <linktext=1619><style=\"ItemQuality_5\">Blazing Ascension</style></linktext> evolves into <linktext=1620><style=\"ItemQuality_5\">Soaring Flame</style></linktext>.<br>Gains <linktext=1620><style=\"ItemQuality_5\">Blaze</style></linktext> after casting <linktext=1212><style=\"ItemQuality_5\">Soaring Flame</style></linktext>."},"315":{"name":"Time Wheel Rewind","description":"When <style=\"accent-gn\">Formless</style> is obtained, the remaining CD of the skill with the longest current CD among <linktext=1622><style=\"ItemQuality_5\">Blazing Assault</style></linktext>, <linktext=1623><style=\"ItemQuality_5\">Rage Cleave</style></linktext>, and <linktext=1624><style=\"ItemQuality_5\">Axe Wind</style></linktext> is reduced by <style=\"accent-gn\">1</style>.<style=\"accent-gn\">5</style>s."},"316":{"name":"Inferno","description":"In <linktext=1212><style=\"ItemQuality_5\">Blaze</style></linktext> state, <style=\"accent-gn\">Expertise Skills</style> inflict <linktext=1213><style=\"ItemQuality_5\">Burn</style></linktext> when they hit a target."},"317":{"name":"Inferno Explosion","description":"When a target is inflicted with <linktext=1213><style=\"ItemQuality_5\">Burn</style></linktext>, there is a <style=\"accent-gn\">30%</style> fixed chance to accumulate <style=\"accent-gn\">1</style> stack of <style=\"accent-gn\">Wildfire</style> that lasts for <style=\"accent-gn\">10</style>s. When <style=\"accent-gn\">Wildfire</style> reaches <style=\"accent-gn\">12</style> stacks, it triggers <linktext=1214><style=\"ItemQuality_5\">Explosion</style></linktext> and clears <style=\"accent-gn\">Wildfire</style> stacks."},"318":{"name":"Lucky Explosion","description":"<linktext=1213><style=\"ItemQuality_5\">Burn</style></linktext> can trigger Lucky Strike.<br>Based on the target's current <linktext=1213><style=\"ItemQuality_5\">Burn</style></linktext> stacks, increases <linktext=1214><style=\"ItemQuality_5\">Explosion</style></linktext> damage. Each additional <style=\"accent-gn\">1</style> stack of <linktext=1213><style=\"ItemQuality_5\">Burn</style></linktext> increases <linktext=1214><style=\"ItemQuality_5\">Explosion</style></linktext> damage by <style=\"accent-gn\">5%</style>."},"319":{"name":"Wasteland Raid","description":"During <linktext=1625><style=\"ItemQuality_5\">Wasteland's End</style></linktext>, triggering a Lucky Strike with <linktext=1623><style=\"ItemQuality_5\">Rage Cleave</style></linktext> or <linktext=1624><style=\"ItemQuality_5\">Axe Wind</style></linktext> reduces the charge time of <linktext=1622><style=\"ItemQuality_5\">Blazing Assault</style></linktext> by <style=\"accent-gn\">1</style>s."},"320":{"name":"Time Wheel Lucky Soul","description":"Each <style=\"accent-gn\">1</style> level of the <style=\"accent-gn\">Formless</style> effect increases Lucky Strike DMG by <style=\"accent-gn\">2%</style>."},"321":{"name":"Time Wheel Agile Soul","description":"Each <style=\"accent-gn\">1</style> level of the <style=\"accent-gn\">Formless</style> effect grants <style=\"accent-gn\">2.5%</style> <style=\"accent-gn\">Strength</style>."},"322":{"name":"Returning Soul","description":"<linktext=1622><style=\"ItemQuality_5\">Blazing Assault</style></linktext> restores <style=\"accent-gn\">5%</style> of lost <style=\"accent-gn\">Flame Soul</style>. When <style=\"accent-gn\">Formless</style> is at S level, enhances recovery effect to <style=\"accent-gn\">10%</style>."},"323":{"name":"Double Inferno","description":"<linktext=1624><style=\"ItemQuality_5\">Axe Wind</style></linktext> applies <style=\"accent-gn\">3</style> stacks of <linktext=1213><style=\"ItemQuality_5\">Burn</style></linktext> to hit targets.<br>At S <style=\"accent-gn\">Formless</style> level, targets hit by <linktext=1624><style=\"ItemQuality_5\">Axe Wind</style></linktext> accumulate <style=\"accent-gn\">1</style> stack of <style=\"accent-gn\">Wildfire</style> that lasts for <style=\"accent-gn\">10</style>s. When <style=\"accent-gn\">Wildfire</style> reaches <style=\"accent-gn\">12</style> stacks, it triggers <linktext=1214><style=\"ItemQuality_5\">Explosion</style></linktext> and clears <style=\"accent-gn\">Wildfire</style> stacks."},"324":{"name":"Hellfire Meteor","description":"In the <style=\"accent-gn\">Formless</style> S-Rank state, each cast of <linktext=1623><style=\"ItemQuality_5\">Rage Cleave</style></linktext> summons <style=\"accent-gn\">1</style> <linktext=1215><style=\"ItemQuality_5\">Hellfire Meteor</style></linktext> at the primary target's location."},"325":{"name":"Supreme Battlefield","description":"Every <style=\"accent-gn\">1%</style> Mastery grants <style=\"accent-gn\">0.2%</style> Fire Bonus."},"326":{"name":"Wasteland Finale","description":"Gains <style=\"accent-gn\">25%</style> Fire Bonus for <style=\"accent-gn\">15</style>s after casting Ultimate."},"327":{"name":"Expertise Formless Flame Slash","description":"<linktext=1623><style=\"ItemQuality_5\">Rage Cleave</style></linktext>, <linktext=1622><style=\"ItemQuality_5\">Blazing Assault</style></linktext>, and <linktext=1624><style=\"ItemQuality_5\">Axe Wind</style></linktext> can trigger <linktext=1216><style=\"ItemQuality_5\">Formless Flame Slash</style></linktext>."},"328":{"name":"Formless Flame Slash Luck","description":"Every </linktext><style=\"accent-gn\">1%</style> Luck increases the trigger chance of <linktext=1216><style=\"ItemQuality_5\">Formless Flame Slash</style> stages <style=\"accent-gn\">1</style> to <style=\"accent-gn\">3</style> by <style=\"accent-gn\">0.2%</style>/<style=\"accent-gn\">0.1%</style>/<style=\"accent-gn\">0.05%</style> respectively, but the Crit Rate of <linktext=1216><style=\"ItemQuality_5\">Formless Flame Slash</style></linktext> is halved."},"329":{"name":"Formless Combo","description":"For every <style=\"accent-gn\">5</style> hits an <style=\"accent-gn\">Expertise Skill</style> deals to the main target, it grants a buff that increases the Lucky Strike Multiplier by <style=\"accent-gn\">27%</style> and reduces Lucky Strike Crit Rate by <style=\"accent-gn\">20%</style> for the next <style=\"accent-gn\">8s</style>. This effect stacks up to <style=\"accent-gn\">3</style> times."},"330":{"name":"Formless Flame Slash - Break","description":"<linktext=1216><style=\"ItemQuality_5\">Formless Flame Slash</style></linktext> can trigger Lucky Strike.<br>Lucky Strike DMG Multiplier +<style=\"accent-gn\">5%</style>. Every <style=\"accent-gn\">1%</style> Luck grants <style=\"accent-gn\">0</style>.<style=\"accent-gn\">8%</style> Lucky Strike DMG Multiplier."},"331":{"name":"Formless Flame Slash - Luck","description":"<linktext=1216><style=\"ItemQuality_5\">Formless Flame Slash</style></linktext> Luck Chance +<style=\"accent-gn\">8%</style>."},"332":{"name":"Formless Flame Slash - Blaze","description":"<linktext=1216><style=\"ItemQuality_5\">Formless Flame Slash</style></linktext> gains <style=\"accent-gn\">5%</style> Fire Bonus."},"333":{"name":"Formless Flame Slash Attack Break","description":"<style=\"accent-gn\">Basic Attacks</style>, <linktext=1619><style=\"ItemQuality_5\">Blazing Ascension</style></linktext>, and <linktext=1620><style=\"ItemQuality_5\">Soaring Flame</style></linktext> can trigger <linktext=1216><style=\"ItemQuality_5\">Formless Flame Slash</style></linktext>."},"334":{"name":"Lucky Blade Combo","description":"<style=\"accent-gn\">Expertise Skills</style> ignore <style=\"accent-gn\">35%</style> of the target's Armor."},"335":{"name":"Formless Flame Slash Combo","description":"Each <style=\"accent-gn\">1</style> level of the <style=\"accent-gn\">Formless</style> effect provides <style=\"accent-gn\">2%</style> <linktext=1216><style=\"ItemQuality_5\">Formless Flame Slash</style></linktext> DMG."},"336":{"name":"Oblivion Inferno","description":"During <linktext=1625><style=\"ItemQuality_5\">Wasteland's End</style></linktext>, <style=\"accent-gn\">Expertise Skill</style> DMG +<style=\"accent-gn\">30%</style>."},"337":{"name":"Instant Wasteland","description":"When <style=\"accent-gn\">Formless</style> is obtained, the remaining CD of <linktext=1625><style=\"ItemQuality_5\">Wasteland's End</style></linktext> is reduced by <style=\"accent-gn\">0</style>.<style=\"accent-gn\">5</style>s or its duration is extended by <style=\"accent-gn\">0</style>.<style=\"accent-gn\">5</style>s (total extended duration cannot exceed <style=\"accent-gn\">5</style>s)."},"338":{"name":"Burning Attack","description":"Fire Bonus +<style=\"accent-gn\">8%</style> when attacking Elite or higher targets."},"339":{"name":"Varied Strikes","description":"For each additional target hit by an <style=\"accent-gn\">Expertise Skill</style>, DMG dealt +<style=\"accent-gn\">10%</style>, up to <style=\"accent-gn\">60%</style>."},"340":{"name":"Flame Soul Attack Spirit","description":"When killing a target, <style=\"accent-gn\">Flame Soul</style> +<style=\"accent-gn\">5</style>."},"341":{"name":"Stellar Spark","description":"<style=\"accent-gn\">Expertise Skill</style> DMG increases Fire ATK by <style=\"accent-gn\">22</style> for the next <style=\"accent-gn\">10</style>s. Stacks up to <style=\"accent-gn\">10</style> times."},"342":{"name":"Crimson Expertise Spec","description":"Gains the <style=\"accent-gn\">Crimson Recovery</style> effect: When hitting the main target (excluding <linktext=1626><style=\"ItemQuality_5\">Wildfire Dance</style></linktext>), <style=\"accent-gn\">20%</style> of the DMG dealt is converted into <style=\"accent-gn\">Crimson Soul Gauge</style> (<style=\"accent-gn\">Crimson Soul Gauge</style> value cannot exceed Max HP). When <style=\"accent-gn\">Flame Soul</style> is insufficient, <style=\"accent-gn\">25%</style> of the <style=\"accent-gn\">Crimson Soul Gauge</style> value can be consumed to extend the duration of <linktext=1626><style=\"ItemQuality_5\">Wildfire Dance</style></linktext> by <style=\"accent-gn\">0.8</style>s.<br><br><i><style=\"text_third_gray\"><size=20>Build the gauge quickly through Crimson Recovery, then leverage high Attack SPD to trigger Wildfire Dance frequently. Use this as the core mechanic and combine it with other skill effects to unleash massive DMG within the burst window.</size></style></i>"},"343":{"name":"Soul Flame","description":"For every <style=\"accent-gn\">10%</style> <style=\"accent-gn\">Crimson Soul Gauge</style> charged, immediately gains a buff: Increases ATK bonuses from all sources by <style=\"accent-gn\">2%</style> for <style=\"accent-gn\">5</style>s. This effect can stack up to <style=\"accent-gn\">3</style> times."},"344":{"name":"Raging Flame Sharpness I","description":"For every <style=\"accent-gn\">10%</style> Max HP or <style=\"accent-gn\">Crimson Soul Gauge</style> lost, a stack of a buff is immediately gained: Crit Chance from all sources is increased by <style=\"accent-gn\">2.5%</style> for <style=\"accent-gn\">5</style>s. This effect can stack up to <style=\"accent-gn\">3</style> times."},"345":{"name":"Crimson Earth - Flame Soul","description":"While within <style=\"accent-gn\">Crimson Earth</style>, <style=\"accent-gn\">Flame Soul</style> recovery efficiency +<style=\"accent-gn\">30%</style>.<br> While within <style=\"accent-gn\">Crimson Earth</style>, <linktext=1626><style=\"ItemQuality_5\">Wildfire Dance</style></linktext> DMG +<style=\"accent-gn\">50%</style>."},"346":{"name":"Crimson Earth - Swift","description":"Every <style=\"accent-gn\">1%</style> Attack SPD increases the <style=\"accent-gn\">Crimson Recovery</style> effect by <style=\"accent-gn\">1%</style> while within <style=\"accent-gn\">Crimson Earth</style>."},"347":{"name":"Crimson Earth Meteor I","description":"Every <style=\"accent-gn\">2</style> casts of <linktext=1627><style=\"ItemQuality_5\">Unbound Meteor</style></linktext> cause <linktext=1627><style=\"ItemQuality_5\">Unbound Meteor</style></linktext> to evolve into <linktext=1628><style=\"ItemQuality_5\">Falling Hellfire</style></linktext>."},"348":{"name":"Raging Flame Sharpness II","description":"Every <style=\"accent-gn\">1%</style> Haste grants <style=\"accent-gn\">0.5%</style> <style=\"accent-gn\">Expertise Skill</style> CD Boost."},"349":{"name":"Crimson Earth Meteor II","description":"<linktext=1627><style=\"ItemQuality_5\">Unbound Meteor</style></linktext> and its enhanced skill (<linktext=1628><style=\"ItemQuality_5\">Falling Hellfire</style></linktext>) gain <style=\"accent-gn\">15%</style> Fire Bonus. This is increased by an additional <style=\"accent-gn\">15%</style> within <style=\"accent-gn\">Crimson Earth</style>."},"350":{"name":"Destined Meteor","description":"Casting <linktext=1630><style=\"ItemQuality_5\">Flowing Splendor Slash</style></linktext>, <linktext=1627><style=\"ItemQuality_5\">Unbound Meteor</style></linktext>, and its enhanced skill (<linktext=1628><style=\"ItemQuality_5\">Falling Hellfire</style></linktext>) consumes up to <style=\"accent-gn\">2</style> stacks of <linktext=1211><style=\"ItemQuality_5\">Infernal Combo</style></linktext>. Each stack of <linktext=1211><style=\"ItemQuality_5\">Infernal Combo</style></linktext> grants that skill a <style=\"accent-gn\">10%</style> Fire Bonus."},"351":{"name":"Crimson Break Slash","description":"Crit DMG +<style=\"accent-gn\">8%</style>."},"352":{"name":"Hellfire Manifestation","description":"While <linktext=1629><style=\"ItemQuality_5\">Endless Hellfire</style></linktext> is active, the <style=\"accent-gn\">Crimson Recovery</style> effect is doubled and the final consumption of the <style=\"accent-gn\">Crimson Soul Gauge</style> is reduced by half."},"353":{"name":"Crimson Focus","description":"For every <style=\"accent-gn\">1%</style> Attack SPD exceeding <style=\"accent-gn\">30%</style>, <style=\"accent-gn\">0.2%</style> <style=\"accent-gn\">Expertise Skill</style> DMG is provided."},"354":{"name":"Flowing Splendor Rotation","description":"After casting <linktext=1630><style=\"ItemQuality_5\">Flowing Splendor Slash</style></linktext>, <linktext=1626><style=\"ItemQuality_5\">Wildfire Dance</style></linktext> DMG is increased by<style=\"accent-gn\">50%</style> for <style=\"accent-gn\">5</style>s.<br><linktext=1630><style=\"ItemQuality_5\">Flowing Splendor Slash</style></linktext> charge count +<style=\"accent-gn\">1</style>."},"355":{"name":"Instant Flowing Splendor","description":"When <linktext=1621><style=\"ItemQuality_5\">Frenzied Slash</style></linktext> deals DMG, there is a <style=\"accent-gn\">15%</style> fixed chance to grant <linktext=1630><style=\"ItemQuality_5\">Flowing Splendor Slash</style></linktext> <style=\"accent-gn\">1</style> charge and cause its next cast to consume no <style=\"accent-gn\">Flame Soul</style>."},"356":{"name":"Ultimate Hellfire","description":"Activating <linktext=1629><style=\"ItemQuality_5\">Endless Hellfire</style></linktext> immediately grants <style=\"accent-gn\">5</style> stacks of <linktext=1211><style=\"ItemQuality_5\">Infernal Combo</style></linktext>, which are not consumed while it is active.<br><linktext=1629>While <style=\"ItemQuality_5\">Endless Hellfire</style></linktext> is active, <style=\"accent-gn\">Strength</style> +<style=\"accent-gn\">15%</style>."},"357":{"name":"Crimson Crit","description":"When <style=\"accent-gn\">Crimson Soul Gauge</style> is charged above <style=\"accent-gn\">50%</style>, Fire ATK +<style=\"accent-gn\">50%</style>."},"358":{"name":"Crimson Pierce","description":"When dealing Crit DMG, ignores <style=\"accent-gn\">22%</style> of the target's Armor."},"359":{"name":"Unbound Meteor Combo","description":"<linktext=1628><style=\"ItemQuality_5\">Falling Hellfire</style></linktext> is enhanced into a continuous three-hit strike form. <br> Every <style=\"accent-gn\">1%</style> <style=\"accent-gn\">Crimson Soul Gauge</style> increases <linktext=1628><style=\"ItemQuality_5\">Falling Hellfire</style></linktext> DMG by <style=\"accent-gn\">1%</style>."},"360":{"name":"Crimson Epiphany","description":"Every <style=\"accent-gn\">1%</style> Mastery grants <style=\"accent-gn\">2%</style> <style=\"accent-gn\">Crimson Recovery</style> final effect."},"361":{"name":"Wildfire Dance Final Slash","description":"After <linktext=1626><style=\"ItemQuality_5\">Wildfire Dance</style></linktext> deals Crit DMG <style=\"accent-gn\">10</style> times (hits on multiple targets count as one), it triggers a <style=\"accent-gn\">Final Slash</style> that deals <style=\"accent-gn\">500%</style> ATK as <style=\"physical\">Attack DMG</style> to enemies.<br><linktext=1626>Each Crit DMG instance dealt by <style=\"ItemQuality_5\">Wildfire Dance</style></linktext> grants the <style=\"accent-gn\">Final Slash</style> a <style=\"accent-gn\">3%</style> Final DMG Bonus (up to a maximum of <style=\"accent-gn\">100%</style>)."},"362":{"name":"Wildfire Formless Flame Slash","description":"<linktext=1626><style=\"ItemQuality_5\">Wildfire Dance</style></linktext> can trigger <linktext=1216><style=\"ItemQuality_5\">Formless Flame Slash</style></linktext>, but can no longer trigger Lucky Strikes.<br><linktext=1216>The damage multiplier of <style=\"ItemQuality_5\">Formless Flame Slash</style></linktext> is adjusted to the skill multiplier that triggered it * (<style=\"accent-gn\">30%</style> + Crit%)."},"363":{"name":"Wild Slash Combo","description":"Each time <linktext=1626><style=\"ItemQuality_5\">Wildfire Dance</style></linktext> deals DMG <style=\"accent-gn\">1</style> time, it grants the next <linktext=1627><style=\"ItemQuality_5\">Unbound Meteor</style></linktext>, <linktext=1628><style=\"ItemQuality_5\">Falling Hellfire</style></linktext>, or <linktext=1630><style=\"ItemQuality_5\">Flowing Splendor Slash</style></linktext> a <style=\"accent-gn\">2.5%</style> Final DMG Bonus (up to a maximum of <style=\"accent-gn\">100%</style>). Casting any of these skills clears this bonus."},"364":{"name":"Arcane Wildfire Bloodline","description":"When <linktext=1626><style=\"ItemQuality_5\">Wildfire Dance</style></linktext> deals DMG, there is a fixed chance of <style=\"accent-gn\">12%</style> + Haste% / <style=\"accent-gn\">2</style>.<style=\"accent-gn\">5</style> to gain <style=\"accent-gn\">1</style> stack of <style=\"accent-gn\">Crimson Bloodline</style>. When <style=\"accent-gn\">Crimson Bloodline</style> reaches <style=\"accent-gn\">7</style> stacks, it triggers <linktext=1217><style=\"ItemQuality_5\">Great Crimson Lotus</style></linktext> and clears all <style=\"accent-gn\">Crimson Bloodline</style> stacks."},"365":{"name":"Arcane Wildfire Haste","description":"<linktext=1626><style=\"ItemQuality_5\">Wildfire Dance</style></linktext> Attack SPD +<style=\"accent-gn\">20%</style>."},"366":{"name":"Arcane Raging Flame","description":"Every <style=\"accent-gn\">15%</style> <style=\"accent-gn\">Crimson Soul Gauge</style> charged reduces the remaining CD of <linktext=1629><style=\"ItemQuality_5\">Endless Hellfire</style></linktext> by <style=\"accent-gn\">0.5</style>s. Every <style=\"accent-gn\">10%</style> of Haste reduces it by an additional <style=\"accent-gn\">0.1</style>s, up to <style=\"accent-gn\">1</style>s."},"400":{"name":"Swift Shadow","description":"Every <style=\"accent-gn\">50</style> points of <style=\"accent-gn\">Courage</style> consumed reduces the CD of <linktext=1523><style=\"ItemQuality_5\">Spiral Thrust</style></linktext>, <linktext=1522><style=\"ItemQuality_5\">Breach Pursuit</style></linktext>, and <linktext=1524><style=\"ItemQuality_5\">Falcon Toss</style></linktext> by <style=\"accent-gn\">1</style>s."},"401":{"name":"Power Conversion","description":"Every <style=\"accent-gn\">8</style> Strength grants <style=\"accent-gn\">1</style> ATK."},"402":{"name":"Vulnerable Strike","description":"Dealing DMG grants a fixed <style=\"accent-gn\">30%</style> chance to apply <style=\"accent-gn\">Vulnerability</style> to the enemy. <br><style=\"accent-gn\">Vulnerability</style>: Increases the DMG you deal to the target by <style=\"accent-gn\">10%</style> for <style=\"accent-gn\">5s</style>."},"403":{"name":"Sharp","description":"Dealing DMG with <style=\"accent-gn\">Special Attacks</style> grants <linktext=1152><style=\"ItemQuality_5\">Sharp</style></linktext>."},"404":{"name":"Sharp Expansion","description":"<linktext=1152><style=\"ItemQuality_5\">Sharp</style></linktext> cap +<style=\"accent-gn\">1</style>."},"405":{"name":"Wind Rift Diffusion","description":"<style=\"accent-gn\">Expertise</style> and <style=\"accent-gn\">Ultimates</style> deal <style=\"accent-gn\">10%</style> more DMG to targets inflicted with <linktext=1153><style=\"ItemQuality_5\">Rend</style></linktext>, and when hitting <linktext=1153><style=\"ItemQuality_5\">Rend</style></linktext> targets, deal <style=\"accent-gn\">1</style> additional hit of <style=\"accent-gn\">75%</style> DMG."},"406":{"name":"Wind Tear","description":"When <linktext=1517><style=\"ItemQuality_5\">Gale Thrust</style></linktext> deals DMG, apply <linktext=1153><style=\"ItemQuality_5\">Rend</style></linktext> to targets."},"407":{"name":"Quickshot Meteor","description":"<linktext=1517><style=\"ItemQuality_5\">Gale Thrust</style></linktext> is enhanced, increasing hit counts by <style=\"accent-gn\">2</style>.<br>Reduces <linktext=1517><style=\"ItemQuality_5\">Gale Thrust</style>'s </linktext><style=\"accent-gn\">Courage</style> consumption by <style=\"accent-gn\">20%</style>."},"409":{"name":"Sharp Expansion","description":"<linktext=1152><style=\"ItemQuality_5\">Sharp</style></linktext> cap +<style=\"accent-gn\">1</style>."},"410":{"name":"Swift Blade","description":"When <linktext=1518><style=\"ItemQuality_5\">Valor Cyclone</style></linktext> deals DMG, it has a fixed <style=\"accent-gn\">7%</style> chance to evolve <style=\"accent-gn\">Basic Attacks</style> into <linktext=1592><style=\"ItemQuality_5\">Swift Blade</style></linktext>."},"411":{"name":"Zephyr Waltz Agility","description":"Additional <style=\"accent-gn\">Courage</style> recovery: Recovers <style=\"accent-gn\">1</style> extra point of <style=\"accent-gn\">Courage</style> per second for every <style=\"accent-gn\">2</style> stacks of <linktext=1152><style=\"ItemQuality_5\">Sharp</style></linktext>."},"412":{"name":"Wind Chaser","description":"During the casting of <linktext=1518><style=\"ItemQuality_5\">Valor Cyclone</style></linktext>, for every <style=\"accent-gn\">20</style> points of <style=\"accent-gn\">Courage</style> consumed, increase the DMG of <linktext=1518><style=\"ItemQuality_5\">Valor Cyclone</style></linktext> by <style=\"accent-gn\">4%</style>, up to <style=\"accent-gn\">20%</style>."},"413":{"name":"Vortex Strike","description":"After every <style=\"accent-gn\">2</style> casts of <linktext=1591><style=\"ItemQuality_5\">Drake Cannon</style></linktext>, your <linktext=1523><style=\"ItemQuality_5\">Spiral Thrust</style></linktext> evolves into <linktext=1590><style=\"ItemQuality_5\">Vortex Strike</style></linktext>."},"414":{"name":"Instantaneous Crit","description":"While <linktext=1157><style=\"ItemQuality_5\">Chasing Step</style></linktext> is active, <linktext=1519><style=\"ItemQuality_5\">Instant Edge</style></linktext> and <linktext=1521><style=\"ItemQuality_5\">Sharp Impact</style></linktext> have their Crit Chance doubled. Additionally, for <linktext=1519><style=\"ItemQuality_5\">Instant Edge</style></linktext> and <linktext=1521><style=\"ItemQuality_5\">Sharp Impact</style></linktext>, every <style=\"accent-gn\">1%</style> excess Crit is converted into <style=\"accent-gn\">3%</style> Crit DMG for the respective skill."},"416":{"name":"Spear Thrust","description":"When <linktext=1520><style=\"ItemQuality_5\">Skyfall</style></linktext> lands a Lucky Strike, it triggers <linktext=1156><style=\"ItemQuality_5\">Spear Thrust</style></linktext>, once every <style=\"accent-gn\">2s</style>.<br>Dealing DMG with <linktext=1156><style=\"ItemQuality_5\">Spear Thrust</style></linktext> restores <style=\"accent-gn\">8</style> points of <style=\"accent-gn\">Courage</style>. This effect triggers only once, even if multiple targets are hit."},"417":{"name":"Wind Fury","description":"Casting <linktext=1521><style=\"ItemQuality_5\">Sharp Impact</style></linktext> grants <linktext=1187><style=\"ItemQuality_5\">Wind Fury</style></linktext>."},"418":{"name":"Sharp Expansion","description":"<linktext=1152><style=\"ItemQuality_5\">Sharp</style></linktext> cap +<style=\"accent-gn\">1</style>."},"419":{"name":"Air Dance Strike","description":"<linktext=1521><style=\"ItemQuality_5\">Sharp Impact</style></linktext> and its enhanced skill (<linktext=1159><style=\"ItemQuality_5\">Typhoon: Sharp Impact</style></linktext>) increase the <style=\"accent-gn\">Courage</style> restored by the next <linktext=1553><style=\"ItemQuality_5\">​Galeform​</style></linktext> by <style=\"accent-gn\">50%</style>.<br>Casting <linktext=1521><style=\"ItemQuality_5\">Sharp Impact</style></linktext> immediately grants <style=\"accent-gn\">3</style> <linktext=1152><style=\"ItemQuality_5\">Sharp</style></linktext>, and casting its enhanced skill <linktext=1159><style=\"ItemQuality_5\">Typhoon: Sharp Impact</style></linktext> immediately grants <style=\"accent-gn\">6</style> <linktext=1152><style=\"ItemQuality_5\">Sharp</style></linktext>."},"420":{"name":"Sharp Expansion","description":"<linktext=1152><style=\"ItemQuality_5\">Sharp</style></linktext> cap +<style=\"accent-gn\">1</style>."},"421":{"name":"Tornado Dance","description":"During <linktext=1187><style=\"ItemQuality_5\">Wind Fury</style></linktext>, DMG dealt by <linktext=1519><style=\"ItemQuality_5\">Instant Edge</style></linktext> and <linktext=1589><style=\"ItemQuality_5\">Azure Sever</style></linktext> triggers <linktext=1158><style=\"ItemQuality_5\">Tornado</style></linktext> (triggered at most once when hitting multiple targets)."},"422":{"name":"Chasing Step","description":"When <linktext=1520><style=\"ItemQuality_5\">Skyfall</style></linktext> or <linktext=1524><style=\"ItemQuality_5\">Falcon Toss</style></linktext> deals a Crit or Lucky Strike, they trigger <linktext=1157><style=\"ItemQuality_5\">Chasing Step</style></linktext>.<br>When <linktext=1520><style=\"ItemQuality_5\">Skyfall</style></linktext> or <linktext=1524><style=\"ItemQuality_5\">Falcon Toss</style></linktext> trigger a Crit and Lucky Strike simultaneously, they grant <style=\"accent-gn\">2</style> stacks of <linktext=1157><style=\"ItemQuality_5\">Chasing Step</style></linktext>."},"423":{"name":"Divine Wind Support","description":"When <linktext=1524><style=\"ItemQuality_5\">Falcon Toss</style></linktext> and its enhanced skill (<linktext=1589><style=\"ItemQuality_5\">Azure Sever</style></linktext>), or <linktext=1519><style=\"ItemQuality_5\">Instant Edge</style></linktext> hits <style=\"accent-gn\">1</style> target, the DMG gains a <style=\"accent-gn\">10%</style> Wind bonus."},"424":{"name":"Combat Expertise","description":"As the battle goes on, grants continuously increasing ATK. Every <style=\"accent-gn\">10</style>s, ATK +<style=\"accent-gn\">2.5%</style>, up to <style=\"accent-gn\">10%</style>. Cleared after battle."},"425":{"name":"Momentum Surge","description":"Increases <linktext=1152><style=\"ItemQuality_5\">Sharp</style></linktext> effect by <style=\"accent-gn\">1%</style>, and for <style=\"accent-gn\">each</style> enemy within <style=\"accent-gn\">12m</style>, additionally increases by <style=\"accent-gn\">1%</style>, up to <style=\"accent-gn\">3%</style>."},"427":{"name":"Catcher","description":"In combat, for every <style=\"accent-gn\">1</style> enemy target defeated (party-wide effect), ATK +<style=\"accent-gn\">65</style> for <style=\"accent-gn\">30</style>s, up to <style=\"accent-gn\">650</style>."},"428":{"name":"Wind Split Technique","description":"When <linktext=1153><style=\"ItemQuality_5\">Rend</style></linktext> deals DMG, it has a fixed <style=\"accent-gn\">50%</style> chance to grant <style=\"accent-gn\">2</style> points of <style=\"accent-gn\">Courage</style>."},"429":{"name":"Tempestrike","description":"When <linktext=1553><style=\"ItemQuality_5\">Galeform</style></linktext> ends, it applies the <linktext=1179><style=\"ItemQuality_5\">Tempestrike</style></linktext>.<br>Every <style=\"accent-gn\">50</style> points of <style=\"accent-gn\">Courage</style> or <style=\"accent-gn\">3</style> points of <style=\"accent-gn\">Sharp</style> consumed during <linktext=1553><style=\"ItemQuality_5\">Galeform</style></linktext> extends the duration of <linktext=1179><style=\"ItemQuality_5\">Tempestrike</style></linktext> by <style=\"accent-gn\">1</style>s."},"430":{"name":"Divine Concealment","description":"Consuming <style=\"accent-gn\">Courage</style> increases Haste by <style=\"accent-gn\">1%</style> and Speed by <style=\"accent-gn\">2%</style> for <style=\"accent-gn\">5</style>s, stacking up to <style=\"accent-gn\">5</style> times."},"431":{"name":"Valor","description":"Increases Max <style=\"accent-gn\">Courage</style> by <style=\"accent-gn\">30</style>."},"432":{"name":"Skyward Spec","description":"Replaces <style=\"accent-gn\">Special Attack</style> with <linktext=1520><style=\"ItemQuality_5\">Skyfall</style></linktext> and enhances the skill.<br>When having <linktext=1152><style=\"ItemQuality_5\">Sharp</style></linktext>, gains ATK based on the max number of <linktext=1152><style=\"ItemQuality_5\">Sharp</style></linktext>.<br><br><i><style=\"text_third_gray\"><size=20>Skyfall and Instant Edge can chain together, skipping the aerial cast delay. High Luck and critical rate enable Skyfall to trigger a low-cost Instant Edge.</size></style></i>"},"433":{"name":"Vanguard Spec","description":"Further enhances <linktext=1517><style=\"ItemQuality_5\">Gale Thrust</style></linktext>.<br>Casting <linktext=1517><style=\"ItemQuality_5\">Gale Thrust</style></linktext> grants a <style=\"accent-gn\">20%</style> fixed chance to cause <style=\"accent-gn\">Basic Attacks</style> to evolve into <linktext=1592><style=\"ItemQuality_5\">Swift Blade</style></linktext>, with an additional <style=\"accent-gn\">5%</style> chance <style=\"accent-gn\">per</style> stack of <linktext=1152><style=\"ItemQuality_5\">Sharp</style></linktext>.<br><br><i><style=\"text_third_gray\"><size=20>Maximize Courage gain and expenditure to reduce the CD of Expertise skills. Haste increases Courage generation and the casting speed of core Expertise skills.</size></style></i>"},"434":{"name":"Battle Cry","description":"<linktext=1525><style=\"ItemQuality_5\">Typhoon Cleave</style></linktext> raises the banner spear, granting <style=\"accent-gn\">Inspire</style> to allies and increasing the caster's Crit DMG by <style=\"accent-gn\">50%</style> for 10s. Afterward, a follow-up leap can be launched, dealing <style=\"physical\">Attack DMG</style> to the enemies within range and knocking them airborne, while restoring <style=\"accent-gn\">100</style> <style=\"accent-gn\">Courage</style>. <br><style=\"accent-gn\">Inspire</style>: Lasts for <style=\"accent-gn\">10s</style>. All allies gain <style=\"accent-gn\">10%</style> Haste (only one effect can be active at a time). You restore <style=\"accent-gn\">10</style> <style=\"accent-gn\">Courage</style> <style=\"accent-gn\">per</style> second and <style=\"accent-gn\">1</style> <linktext=1152><style=\"ItemQuality_5\">Sharp</style> every <style=\"accent-gn\">2s</style></linktext>."},"435":{"name":"Swift","description":"Each <style=\"accent-gn\">1%</style> Haste provides <style=\"accent-gn\">1%</style> Attack Speed."},"436":{"name":"Sharp Expansion","description":"<linktext=1152><style=\"ItemQuality_5\">Sharp</style></linktext> cap +<style=\"accent-gn\">1</style>."},"437":{"name":"Long Lance Sharp Blade","description":"When <style=\"accent-gn\">Strength</style> reaches <style=\"accent-gn\">300</style> points, <style=\"accent-gn\">Expertise Skill</style> damage +<style=\"accent-gn\">7%</style>."},"438":{"name":"Sharp","description":"When <style=\"accent-gn\">Strength</style> reaches <style=\"accent-gn\">500</style> points, the additional ATK from <linktext=1152><style=\"ItemQuality_5\">Sharp</style></linktext> increases to <style=\"accent-gn\">6%</style>."},"439":{"name":"Break Pursuit Advancement","description":"Within <style=\"accent-gn\">15s</style> after Casting the <style=\"accent-gn\">Ultimate</style>, Casting <linktext=1522><style=\"ItemQuality_5\">Breach Pursuit</style></linktext> will not start CD. This effect is removed after the duration ends or after Casting <style=\"accent-gn\">3</style> times <linktext=1522><style=\"ItemQuality_5\">Breach Pursuit</style></linktext>."},"440":{"name":"Wind Spiral","description":"When <linktext=1517><style=\"ItemQuality_5\">Gale Thrust</style></linktext> deals DMG, it has a fixed <style=\"accent-gn\">50%</style> chance to grant <style=\"accent-gn\">1</style> stack of <style=\"accent-gn\">Wind Spiral</style> for <style=\"accent-gn\">20</style>s, stacking up to <style=\"accent-gn\">10</style> times.<br><style=\"accent-gn\">Wind Spiral</style>: When casting <linktext=1523><style=\"ItemQuality_5\">Spiral Thrust</style></linktext> or <linktext=1518><style=\"ItemQuality_5\">Valor Cyclone</style></linktext>, it triggers a Spiral Explosion, dealing <style=\"physical\">Attack DMG</style> equal to <style=\"accent-gn\">Wind Spiral</style> stacks x <style=\"accent-gn\">200%</style> ATK to nearby enemies. Each <style=\"accent-gn\">1%</style> of Mastery increases this DMG multiplier by <style=\"accent-gn\">7%</style>, up to <style=\"accent-gn\">560%</style>. This DMG cannot Crit, and decreases by <style=\"accent-gn\">5%</style> for each additional target hit, down to a minimum of <style=\"accent-gn\">25%</style>. Triggering this clears all <style=\"accent-gn\">Wind Spiral</style> stacks."},"441":{"name":"Vigor Spike","description":"When <linktext=1152><style=\"ItemQuality_5\">Sharp</style></linktext> reaches full amount and the caster is in combat, enters <linktext=1155><style=\"ItemQuality_5\">Vigor Spike</style></linktext> state, effective up to once every <style=\"accent-gn\">30s</style> (affected by CD Boost stats)."},"442":{"name":"Fearless Gale","description":"After casting <linktext=1523><style=\"ItemQuality_5\">Spiral Thrust</style></linktext> or <linktext=1522><style=\"ItemQuality_5\">Breach Pursuit</style></linktext> or <linktext=1518><style=\"ItemQuality_5\">Valor Cyclone</style></linktext>, the next <linktext=1517><style=\"ItemQuality_5\">Gale Thrust</style></linktext> will not consume <style=\"accent-gn\">Courage</style>. This effect is removed after leaving combat."},"443":{"name":"Whispering Breeze","description":"When <style=\"accent-gn\">Courage</style> is below or equal to <style=\"accent-gn\">50%</style>, reduces the <style=\"accent-gn\">Energy</style> <linktext=1518><style=\"ItemQuality_5\">Valor Cyclone</style></linktext> consumes by <style=\"accent-gn\">2</style>.<br>When <style=\"accent-gn\">Courage</style> is above <style=\"accent-gn\">50%</style>, increases the DMG <linktext=1518><style=\"ItemQuality_5\">Valor Cyclone</style></linktext> deals by <style=\"accent-gn\">12%</style>."},"444":{"name":"Rapid Drake Cannon","description":"Using <linktext=1592><style=\"ItemQuality_5\">Swift Blade</style></linktext> grants it a fixed <style=\"accent-gn\">10%</style> chance to evolve <style=\"accent-gn\">Basic Attack</style> into <linktext=1591><style=\"ItemQuality_5\">Drake Cannon</style></linktext> in <style=\"accent-gn\">10s</style>. Each failure to evolve increases the chance by <style=\"accent-gn\">10%</style> until success."},"445":{"name":"Rupture","description":"When <linktext=1518><style=\"ItemQuality_5\">Valor Cyclone</style></linktext> deals DMG, it has a fixed <style=\"accent-gn\">50%</style> chance to inflict <linktext=1154><style=\"ItemQuality_5\">Rupture</style></linktext>."},"446":{"name":"Spiral Tear","description":"<linktext=1523><style=\"ItemQuality_5\">Spiral Thrust</style></linktext> and <linktext=1590><style=\"ItemQuality_5\">Vortex Strike</style></linktext> deals <style=\"accent-gn\">30%</style> more DMG to the targets with <linktext=1153><style=\"ItemQuality_5\">Rend</style></linktext>."},"447":{"name":"Fortitude","description":"During <linktext=1518><style=\"ItemQuality_5\">Valor Cyclone</style></linktext>, gains <linktext=1102><style=\"ItemQuality_5\">Super Armor</style></linktext> and reduces DMG taken by <style=\"accent-gn\">20%</style>. <br>When <linktext=1518><style=\"ItemQuality_5\">Valor Cyclone</style></linktext> deals DMG, restores HP equal to <style=\"accent-gn\">10%</style> ATK."},"448":{"name":"Swift Breeze","description":"Each <style=\"accent-gn\">1%</style> Haste accelerates the REG SPD of <style=\"accent-gn\">Courage</style> by <style=\"accent-gn\">2%</style>."},"449":{"name":"Breath of Wind","description":"Skills that consume <style=\"accent-gn\">Courage</style> (<linktext=1523><style=\"ItemQuality_5\">Spiral Thrust</style></linktext> and its enhanced skills, <linktext=1518><style=\"ItemQuality_5\">Valor Cyclone</style></linktext>, <linktext=1524><style=\"ItemQuality_5\">Falcon Toss</style></linktext> and its enhanced skills, <linktext=1517><style=\"ItemQuality_5\">Gale Thrust</style></linktext>) gain <style=\"accent-gn\">6%</style> Wind Bonus."},"450":{"name":"Wind Rise","description":"When <linktext=1518><style=\"ItemQuality_5\">Valor Cyclone</style></linktext> deals DMG, increases <linktext=1591><style=\"ItemQuality_5\">Drake Cannon</style></linktext> and <linktext=1590><style=\"ItemQuality_5\">Vortex Strike</style></linktext> Crit Chance by <style=\"accent-gn\">7%</style>, and Crit DMG by <style=\"accent-gn\">5%</style>. The effect lasts <style=\"accent-gn\">5s</style> and stacks up to <style=\"accent-gn\">7</style> times."},"451":{"name":"Strong Attack","description":"When <linktext=1518><style=\"ItemQuality_5\">Valor Cyclone</style></linktext> deals DMG, reduces the CD of Ultimate by <style=\"accent-gn\">0.5s</style> (which can only be triggers <style=\"accent-gn\">once</style> on multiple hits)."},"452":{"name":"Spiral Flame","description":"Using <linktext=1590><style=\"ItemQuality_5\">Vortex Strike</style></linktext>, increases Haste by <style=\"accent-gn\">25%</style> for <style=\"accent-gn\">10s</style>."},"453":{"name":"Dragon's Fury Flame","description":"The Crit chance of <linktext=1591><style=\"ItemQuality_5\">​Drake Cannon​</style></linktext> and <linktext=1590><style=\"ItemQuality_5\">​Vortex Strike​</style></linktext> is doubled.<br>Increases the Crit DMG of <linktext=1591><style=\"ItemQuality_5\">Drake Cannon</style></linktext> and <linktext=1590><style=\"ItemQuality_5\">Vortex Strike</style></linktext> by <style=\"accent-gn\">8%</style>.<br>Each <style=\"accent-gn\">1%</style> Haste grants <style=\"accent-gn\">0.5%</style> Crit DMG for <linktext=1591><style=\"ItemQuality_5\">Drake Cannon​</style></linktext> and <linktext=1590><style=\"ItemQuality_5\">​Vortex Strike​</style></linktext>."},"454":{"name":"Wind Gate Drake Cannon","description":"Every <style=\"accent-gn\">22</style> triggers of <linktext=1518><style=\"ItemQuality_5\">Valor Cyclone</style></linktext> allows <style=\"accent-gn\">Basic Attack</style> to evolve into <linktext=1591><style=\"ItemQuality_5\">Drake Cannon</style></linktext> in <style=\"accent-gn\">10s</style>."},"455":{"name":"Bird Advancement","description":"Increases the charge of <linktext=1524><style=\"ItemQuality_5\">Falcon Toss</style></linktext> by <style=\"accent-gn\">1</style>.<br>Reduces <style=\"accent-gn\">Courage</style> consumed by <linktext=1524><style=\"ItemQuality_5\">Falcon Toss</style></linktext> by <style=\"accent-gn\">50%</style>."},"456":{"name":"Sharp Advancement","description":"Enhances the effectiveness of <linktext=1187><style=\"ItemQuality_5\">Wind Fury</style></linktext> by <style=\"accent-gn\">50%</style>.<br>When <linktext=1519><style=\"ItemQuality_5\">Instant Edge</style></linktext> consumes <linktext=1157><style=\"ItemQuality_5\">Chasing Step</style></linktext>, doubles the charge efficiency of <linktext=1521><style=\"ItemQuality_5\">Sharp Impact</style></linktext>."},"457":{"name":"Spear Recovery","description":"<linktext=1156><style=\"ItemQuality_5\">Spear Thrust</style></linktext> reduces the CD of <linktext=1524><style=\"ItemQuality_5\">Falcon Toss</style></linktext> by <style=\"accent-gn\">2s</style> (which can only be triggers once on multiple hits)."},"458":{"name":"Sharp Long Breath","description":"During <linktext=1187><style=\"ItemQuality_5\">Wind Fury</style></linktext>, <linktext=1524><style=\"ItemQuality_5\">Falcon Toss</style></linktext> evolves into <linktext=1589><style=\"ItemQuality_5\">Azure Sever</style></linktext> <style=\"accent-gn\">once</style>."},"459":{"name":"Sharp Expansion","description":"<linktext=1152><style=\"ItemQuality_5\">Sharp</style></linktext> cap +<style=\"accent-gn\">1</style>."},"460":{"name":"Skyfall","description":"When dealing DMG, <linktext=1520><style=\"ItemQuality_5\">Skyfall</style></linktext> gains a fixed <style=\"accent-gn\">15%</style> chance to grant <style=\"accent-gn\">1</style> stack of <linktext=1152><style=\"ItemQuality_5\">Sharp</style></linktext>."},"461":{"name":"Pursuit Power","description":"<linktext=1157><style=\"ItemQuality_5\">Chasing Step</style></linktext> consumed increases <style=\"accent-gn\">Strength</style> by <style=\"accent-gn\">15%</style>. The effect lasts <style=\"accent-gn\">10s</style> and stacks up to <style=\"accent-gn\">2</style> times."},"462":{"name":"Exceptional Elegance","description":"During <linktext=1553><style=\"ItemQuality_5\">Galeform</style></linktext>, increases the DMG dealt by <linktext=1519><style=\"ItemQuality_5\">Instant Edge</style></linktext> and <linktext=1520><style=\"ItemQuality_5\">Skyfall</style></linktext> by <style=\"accent-gn\">25%</style>."},"463":{"name":"Typhoon: Sharp Impact","description":"<linktext=1521><style=\"ItemQuality_5\">Sharp Impact</style></linktext> is enhanced, evolving into <linktext=1159><style=\"ItemQuality_5\">Typhoon: Sharp Impact</style></linktext>."},"464":{"name":"Instant Edge Break Style","description":"<linktext=1519><style=\"ItemQuality_5\">Instant Edge</style></linktext> consumes <style=\"accent-gn\">1</style> more <linktext=1152><style=\"ItemQuality_5\">Sharp</style></linktext>.<br>Increases the DMG dealt by <linktext=1519><style=\"ItemQuality_5\">Instant Edge</style></linktext> by <style=\"accent-gn\">90%</style>."},"465":{"name":"Wind Swirl Strike","description":"Increases the DMG dealt by <linktext=1158><style=\"ItemQuality_5\">Tornado</style></linktext> by <style=\"accent-gn\">30%</style>. <br>Increases the DMG dealt by <linktext=1156><style=\"ItemQuality_5\">Spear Thrust</style></linktext> by <style=\"accent-gn\">30%</style>."},"466":{"name":"Sharp Pursuit","description":"When <linktext=1519><style=\"ItemQuality_5\">Instant Edge</style></linktext> consumes <linktext=1157><style=\"ItemQuality_5\">Chasing Step</style></linktext>, grants <style=\"accent-gn\">1</style> stack of <linktext=1152><style=\"ItemQuality_5\">Sharp</style></linktext>."},"467":{"name":"Instant Edge Combo","description":"<linktext=1519><style=\"ItemQuality_5\">Instant Edge</style></linktext> has a fixed <style=\"accent-gn\">25%</style> chance to trigger one extra instance of DMG (if Lucky Strike chance exceeds <style=\"accent-gn\">25%</style>, that becomes the new trigger chance). This extra DMG equals <linktext=1519><style=\"ItemQuality_5\">Instant Edge</style></linktext> DMG x current Lucky Strike DMG multiplier%, and is affected by all relevant <linktext=1519><style=\"ItemQuality_5\">Instant Edge</style></linktext> DMG bonuses."},"468":{"name":"Break Style","description":"When dealing Crit DMG, <style=\"accent-gn\">Expertise Skill</style> ignore the targets' <style=\"accent-gn\">50%</style> Armor."},"469":{"name":"Sharp Echo","description":"If <linktext=1152><style=\"ItemQuality_5\">Sharp</style></linktext> isn't at Max stacks, increases the DMG dealt by <linktext=1520><style=\"ItemQuality_5\">Skyfall</style></linktext> by <style=\"accent-gn\">25%</style>."},"470":{"name":"Kamikaze Luck","description":"For each <style=\"accent-gn\">1</style> stack of <linktext=1152><style=\"ItemQuality_5\">Sharp</style></linktext> consumed, gains <style=\"accent-gn\">3</style> points of <style=\"accent-gn\">Courage</style>. <br>Increases Lucky Strike final DMG by <style=\"accent-gn\">50%</style>."},"500":{"name":"Brimming Vitality","description":"Increases <style=\"accent-gn\">Energy</style> REG SPD by <style=\"accent-gn\">20%</style>."},"501":{"name":"Intellect Conversion","description":"Every <style=\"accent-gn\">10</style> points of Intellect provides <style=\"accent-gn\">1</style> point of MATK."},"502":{"name":"Inspiration","description":"Applies <linktext=1107><style=\"ItemQuality_5\">Inspiration</style></linktext> to yourself and allies within <style=\"accent-gn\">30</style> meters."},"503":{"name":"Regen Bud","description":"Casting a <style=\"accent-gn\">Special Attack</style> grants <style=\"accent-gn\">1</style> <linktext=1108><style=\"ItemQuality_5\">Regen Bud</style></linktext>. <br><br>Initial cap of <linktext=1108><style=\"ItemQuality_5\">Regen Buds</style></linktext>: <style=\"accent-gn\">4</style>.<br>When an <style=\"accent-gn\">Expertise Skill</style> or <style=\"accent-gn\">Ultimate</style> generates healing, <style=\"accent-gn\">2</style> <linktext=1108><style=\"ItemQuality_5\">Regen Buds</style></linktext> are consumed to throw a <linktext=1115><style=\"ItemQuality_5\">Nourishing Seed</style></linktext>, triggering up to once <style=\"accent-gn\">per</style> second.<br>When an <style=\"accent-gn\">Expertise Skill</style> or <style=\"accent-gn\">Ultimate</style> deals DMG, <style=\"accent-gn\">2</style> <linktext=1108><style=\"ItemQuality_5\">Regen Buds</style></linktext> are consumed to shoot a <linktext=1116><style=\"ItemQuality_5\">Wild Seed</style></linktext>, once <style=\"accent-gn\">per</style> second."},"504":{"name":"Breath of Buds","description":"Increases Max <linktext=1108><style=\"ItemQuality_5\">Regen Bud</style></linktext> by <style=\"accent-gn\">4</style>."},"505":{"name":"Nature Shield","description":"When <linktext=1526><style=\"ItemQuality_5\">Wild Bloom</style></linktext> heals a target, it also applies <linktext=1111><style=\"ItemQuality_5\">Nature Shield</style></linktext> to them.<br>Targets with <linktext=1111><style=\"ItemQuality_5\">Nature Shield</style></linktext> restore HP when hit, with the amount equal to <style=\"accent-gn\">10%</style> of your ATK. This effect can occur up to once <style=\"accent-gn\">per</style> second."},"506":{"name":"Arcane of Green","description":"When <linktext=1529><style=\"ItemQuality_5\">Feral Seed</style></linktext> deals DMG, it increases <linktext=1530>ATK by <style=\"accent-gn\">Mastery % x Luck %</style></linktext> for the next <style=\"accent-gn\">10</style>s."},"507":{"name":"Healing Breath","description":"When a <style=\"accent-gn\">Special Attack</style>, <style=\"accent-gn\">Expertise Skill</style>, or <style=\"accent-gn\">Ultimate</style> generates Healing, there is a <style=\"accent-gn\">20%</style> to trigger <linktext=1109><style=\"ItemQuality_5\">Healing Chain</style></linktext>. For every <style=\"accent-gn\">2%</style> Luck, the chance +<style=\"accent-gn\">1%</style>."},"508":{"name":"Wild Blessing","description":"<linktext=1526><style=\"ItemQuality_5\">Wild Bloom</style></linktext> now holds up to <style=\"accent-gn\">2</style> charges.<br><linktext=1526><style=\"ItemQuality_5\">Wild Bloom</style></linktext>'s <style=\"accent-gn\">Energy</style> cost -<style=\"accent-gn\">15%</style>."},"509":{"name":"Flourish","description":"When <linktext=1530><style=\"ItemQuality_5\">Infusion</style></linktext>, <linktext=1529><style=\"ItemQuality_5\">Feral Seed</style></linktext>, or <linktext=1526><style=\"ItemQuality_5\">Wild Bloom</style></linktext> deals DMG, <style=\"accent-gn\">30%</style> chance to reduce the CD of the <style=\"accent-gn\">Ultimate</style> by <style=\"accent-gn\">1</style>s, once <style=\"accent-gn\">per</style> second."},"510":{"name":"Smite Spec","description":"Further enhances the ability to use <linktext=1526><style=\"ItemQuality_5\">Wild Bloom</style></linktext>.<br><linktext=1526><style=\"ItemQuality_5\">Wild Bloom</style></linktext>, <linktext=1532><style=\"ItemQuality_5\">Regen Pulse</style></linktext>, and <linktext=1535><style=\"ItemQuality_5\">​Nature Ward​</style></linktext> grant <style=\"accent-gn\">Symbiotic Mark</style> to allies.<br><style=\"accent-gn\">Symbiotic Mark</style>: Lasts for <style=\"accent-gn\">10s</style>. All of the caster's DMG will heal allies with <style=\"accent-gn\">Symbiotic Mark</style> for <style=\"accent-gn\">45%</style> of the DMG dealt.<br>Increases the final DMG of Lucky Strikes by <style=\"accent-gn\">50%</style>.<br>When overhealing a target with <style=\"accent-gn\">Symbiotic Mark</style>, if the overheal reaches <style=\"accent-gn\">30%</style> of their Max HP, the excess healing is converted into a regeneration effect lasting for <style=\"accent-gn\">10s</style>. This effect can trigger only once every <style=\"accent-gn\">30s</style>.<br><br><style=\"accent-gn\">Healing of Stillness</style>: If the caster deals no DMG to enemies for <style=\"accent-gn\">5s</style>, each hit of the caster's <style=\"accent-gn\">Basic Attack</style> will heal up to <style=\"accent-gn\">10</style> allies (party members prioritized), with the 4-hit combo restoring <style=\"accent-gn\">12.6%</style> Max HP in total. After using an Ultimate, Basic Attacks immediately start healing, but this effect is disabled upon dealing DMG to enemies.<br><br><i><style=\"text_third_gray\"><size=20>Capable of converting attacks into healing. Lucky Strikes from attacks trigger various healing effects, enhancing healing while increasing DMG dealt.</size></style></i>"},"511":{"name":"Double Infusion","description":"After casting <linktext=1593><style=\"ItemQuality_5\">Stag Charge</style></linktext>, the number of channels for the next <linktext=1530><style=\"ItemQuality_5\">Infusion</style></linktext> +<style=\"accent-gn\">100%</style>."},"512":{"name":"Final Bloomwheel","description":"When <linktext=1526><style=\"ItemQuality_5\">Wild Bloom</style></linktext> deals DMG, reduces the remaining CD of <linktext=1530><style=\"ItemQuality_5\">Infusion</style></linktext> by <style=\"accent-gn\">1s</style>. If the DMG triggers a Lucky Strike, the remaining CD is reduced by <style=\"accent-gn\">3s</style>."},"514":{"name":"Verdant Root","description":"While in battle state, standing still for <style=\"accent-gn\">2s</style> creates a <style=\"accent-gn\">Grass Domain</style>. <br><style=\"accent-gn\">Grass Domain</style>: While inside the <style=\"accent-gn\">Grass Domain</style>, your Haste +<style=\"accent-gn\">10%</style>. Upon exiting the <style=\"accent-gn\">Grass Domain</style>, your Movement SPD +<style=\"accent-gn\">50%</style> for <style=\"accent-gn\">0.5s</style>, and <style=\"accent-gn\">Grass Domain</style> disappears."},"515":{"name":"Full Bloom","description":"Casting <linktext=1527><style=\"ItemQuality_5\">Life Bloom</style></linktext> grants a <style=\"accent-gn\">40%</style> chance to reduce the remaining CD of <linktext=1533><style=\"ItemQuality_5\">Blossom Charge</style></linktext> and <linktext=1528><style=\"ItemQuality_5\">Nourish</style></linktext> by <style=\"accent-gn\">2</style>s. Each <style=\"accent-gn\">1%</style> of Mastery increases this chance by <style=\"accent-gn\">0.4%</style>, up to a maximum of <style=\"accent-gn\">60%</style>.<br>Casting <linktext=1527><style=\"ItemQuality_5\">Life Bloom</style></linktext> grants a <style=\"accent-gn\">50%</style> chance to reduce the remaining CD of <linktext=1583><style=\"ItemQuality_5\">Fast Growth</style></linktext> by <style=\"accent-gn\">0.2</style>s, triggering at most once every <style=\"accent-gn\">10</style>s. Each <style=\"accent-gn\">20%</style> of Haste increases the CD reduction by <style=\"accent-gn\">0.1</style>s, up to a maximum of <style=\"accent-gn\">0.5</style>s."},"516":{"name":"Healing Infusion","description":"Every <style=\"accent-gn\">5</style> uses of <linktext=1527><style=\"ItemQuality_5\">Life Bloom</style></linktext> enhances the next direct healing <style=\"accent-gn\">Expertise Skill</style> by <style=\"accent-gn\">100%</style>."},"518":{"name":"Verdant Duet","description":"<linktext=1527><style=\"ItemQuality_5\">Life Bloom</style></linktext> has a fixed <style=\"accent-gn\">20%</style> chance to heal <style=\"accent-gn\">1</style> additional time."},"519":{"name":"Floral Whisper","description":"Healing <style=\"accent-gn\">Expertise</style> generate <style=\"accent-gn\">20%</style> more healing, but healing from <linktext=1527><style=\"ItemQuality_5\">Life Bloom</style></linktext> -<style=\"accent-gn\">50%</style>."},"520":{"name":"Lifeforce Extension","description":"Increases the Healing of <linktext=1109><style=\"ItemQuality_5\">Healing Chain</style></linktext> by <style=\"accent-gn\">10%</style>. For every <style=\"accent-gn\">7%</style> Mastery, <linktext=1109><style=\"ItemQuality_5\">Healing Chain</style></linktext> jumps <style=\"accent-gn\">1</style> additional time.<br><linktext=1109><style=\"ItemQuality_5\">Healing Chain</style></linktext> restores <style=\"accent-gn\">1%</style> of an ally's Max HP with each tick."},"521":{"name":"Nourish Essence","description":"When <linktext=1527><style=\"ItemQuality_5\">Life Bloom</style></linktext> generates healing, <style=\"accent-gn\">50%</style> chance to apply <linktext=1528><style=\"ItemQuality_5\">Nourish</style></linktext>."},"522":{"name":"Endless Blossom","description":"When casting <linktext=1533><style=\"ItemQuality_5\">Blossom Charge</style></linktext>, <linktext=1534><style=\"ItemQuality_5\">Grove Wish</style></linktext>, or <linktext=1532><style=\"ItemQuality_5\">Regen Pulse</style></linktext>, <style=\"accent-gn\">20%</style> chance that the next cast of <linktext=1527><style=\"ItemQuality_5\">Life Bloom</style></linktext> within <style=\"accent-gn\">5</style>s consumes no <style=\"accent-gn\">Energy</style>."},"523":{"name":"Stag Charge","description":"After triggering a total of <style=\"accent-gn\">10</style> <linktext=1115><style=\"ItemQuality_5\">Nourishing Seeds</style></linktext> or <linktext=1116><style=\"ItemQuality_5\">Wild Seeds</style></linktext>, <linktext=1526><style=\"ItemQuality_5\">Wild Bloom</style></linktext> evolves into <linktext=1593><style=\"ItemQuality_5\">Stag Charge</style></linktext>.<br>Casting <linktext=1593><style=\"ItemQuality_5\">Stag Charge</style></linktext> instants grants <style=\"accent-gn\">3</style> <linktext=1108><style=\"ItemQuality_5\">Regen Buds</style></linktext>."},"524":{"name":"Wings of Revival","description":"When an ally within <style=\"accent-gn\">20</style> meters takes DMG exceeding <style=\"accent-gn\">30%</style> of their HP, <style=\"accent-gn\">Revival</style> triggers, which can affect the same target up to once every <style=\"accent-gn\">45s</style>.<br><style=\"accent-gn\">Revival</style>: Restores HP equal to <style=\"accent-gn\">50%</style> of the DMG taken over <style=\"accent-gn\">5</style>s."},"525":{"name":"Natural Bloom","description":"When healing an ally with lower than <style=\"accent-gn\">30%</style> HP, <style=\"accent-gn\">Natural Bloom</style> triggers, instantly restoring HP equal to <style=\"accent-gn\">200%</style> ATK to them. This effect can occur up to once every <style=\"accent-gn\">30s</style>."},"526":{"name":"Healing Pulse","description":"When an enemy within <style=\"accent-gn\">10</style> meters that you are engaged with is defeated (effective within a team), generates a <linktext=1110><style=\"ItemQuality_5\">Healing Pulse</style></linktext>. This can only occur once every <style=\"accent-gn\">10s</style>."},"527":{"name":"Gift of Life","description":"When an enemy within <style=\"accent-gn\">10</style> meters that you are engaged with is defeated (effective within a team), generates a <linktext=1113><style=\"ItemQuality_5\">Healing Orb</style></linktext>. This can only occur once every <style=\"accent-gn\">2s</style>."},"528":{"name":"Bud Acquisition","description":"When an enemy within <style=\"accent-gn\">10</style> meters that you are engaged with is defeated (effective within a team), generates an <linktext=1114><style=\"ItemQuality_5\">Engram Orb</style></linktext>, which grants <style=\"accent-gn\">1</style> <linktext=1108><style=\"ItemQuality_5\">Regen Bud</style></linktext> upon pickup."},"529":{"name":"Defensive Blessing","description":"<linktext=1107><style=\"ItemQuality_5\">Inspiration</style></linktext> provides the target with an additional <style=\"accent-gn\">400</style> Armor."},"530":{"name":"Flowers Ascension","description":"When <linktext=1116><style=\"ItemQuality_5\">Wild Seed</style></linktext> deals DMG or <linktext=1115><style=\"ItemQuality_5\">Nourishing Seed</style></linktext> generates healing, you gain a <style=\"accent-gn\">10%</style> Forest DMG bonus for the next <style=\"accent-gn\">8</style>s."},"531":{"name":"Lifebind Spec","description":"Replace <style=\"accent-gn\">Special Attack</style> with <linktext=1527><style=\"ItemQuality_5\">Life Bloom</style></linktext> and enhances the skill.<br><linktext=1527><style=\"ItemQuality_5\">Life Bloom</style></linktext> generates <style=\"accent-gn\">20%</style> more healing.<br>Casting <linktext=1527><style=\"ItemQuality_5\">Life Bloom</style></linktext> grants <style=\"accent-gn\">1</style> additional <linktext=1108><style=\"ItemQuality_5\">Regen Bud</style></linktext>.<br><br><i><style=\"text_third_gray\"><size=20>Whenever safety allows, aim to cast as many healing skills as possible. Haste increases cast speed, and Mastery enhances healing potency.</size></style></i>"},"532":{"name":"Thorn","description":"When <linktext=1116><style=\"ItemQuality_5\">Wild Seed</style></linktext> hits a target, it inflicts <linktext=1117><style=\"ItemQuality_5\">Thorn</style></linktext> on them.<br>Forest DMG dealt by players to targets with <linktext=1117><style=\"ItemQuality_5\">Thorn</style></linktext> +<style=\"accent-gn\">20%</style>."},"533":{"name":"Vital Surge","description":"Replace <style=\"accent-gn\">Ultimate</style>, <linktext=1531><style=\"ItemQuality_5\">Divine Circle Bloom</style></linktext> with <linktext=1551><style=\"ItemQuality_5\">Vital Surge</style></linktext>."},"534":{"name":"Verdant Blessing","description":"When HP of an ally with <linktext=1107><style=\"ItemQuality_5\">Inspiration</style></linktext> drops below <style=\"accent-gn\">20%</style>, <style=\"accent-gn\">Blessing</style> triggers.<br><style=\"accent-gn\">Blessing</style>: Grants a <linktext=1111><style=\"ItemQuality_5\">Nature Shield</style></linktext> and reduces the DMG taken by <style=\"accent-gn\">35%</style> for <style=\"accent-gn\">8s</style>, once every <style=\"accent-gn\">60s</style>."},"535":{"name":"Bloomheal","description":"Replace <style=\"accent-gn\">Ultimate</style>, <linktext=1531><style=\"ItemQuality_5\">Divine Circle Bloom</style></linktext> with <linktext=1552><style=\"ItemQuality_5\">Bloomheal</style></linktext>."},"536":{"name":"Dancing Seed","description":"When a DMG-type <style=\"accent-gn\">Expertise Skill</style> triggers Lucky Strike, next <linktext=1116><style=\"ItemQuality_5\">Wild Seed</style></linktext> launches <style=\"accent-gn\">1</style> more projectile.<br>For every <style=\"accent-gn\">5</style> <linktext=1115><style=\"ItemQuality_5\">Nourishing Seeds</style></linktext> thrown, next <linktext=1115><style=\"ItemQuality_5\">Nourishing Seed</style></linktext> throws <style=\"accent-gn\">1</style> more projectile."},"537":{"name":"Energy Surge","description":"Every <style=\"accent-gn\">2%</style> haste provides <style=\"accent-gn\">1%</style> <style=\"accent-gn\">energy</style> natural recovery efficiency."},"538":{"name":"Regeneration Bud","description":"When dealing damage with <style=\"accent-gn\">Basic Attacks</style>, <style=\"accent-gn\">10%</style> chance to gain <style=\"accent-gn\">1</style> <linktext=1108><style=\"ItemQuality_5\">Regen Bud</style></linktext>."},"539":{"name":"Omnipotent Breath","description":"When <style=\"accent-gn\">Intellect</style> reaches <style=\"accent-gn\">500</style>, versatility +<style=\"accent-gn\">4%</style>."},"540":{"name":"Shelter","description":"Within <style=\"accent-gn\">5s</style> after Casting <linktext=1530><style=\"ItemQuality_5\">Infusion</style></linktext>, the damage absorption of the <linktext=1111><style=\"ItemQuality_5\">Nature Shield</style></linktext> added by <linktext=1526><style=\"ItemQuality_5\">Wild Bloom</style></linktext> or <linktext=1535><style=\"ItemQuality_5\">Nature Ward</style></linktext> is doubled."},"541":{"name":"Pulse Breath","description":"If equipped with <linktext=1532><style=\"ItemQuality_5\">Regen Pulse</style></linktext> skill, <linktext=1535><style=\"ItemQuality_5\">Nature Ward</style></linktext> and <style=\"accent-gn\">Ultimates</style> will trigger <linktext=1532><style=\"ItemQuality_5\">Regen Pulse</style></linktext> when their CDs are completed."},"542":{"name":"Feral Seed Symbiosis","description":"When active <style=\"accent-gn\">Symbiotic Marks</style> reach <style=\"accent-gn\">5</style> or more, <linktext=1529><style=\"ItemQuality_5\">​Feral Seed​</style></linktext> and <linktext=1116><style=\"ItemQuality_5\">Wild Seed</style></linktext> DMG increases by <style=\"accent-gn\">100%</style>."},"543":{"name":"Wild Protection","description":"The charge count of <linktext=1535><style=\"ItemQuality_5\">Nature Ward</style></linktext> +<style=\"accent-gn\">1</style>.<br>The charge time of <linktext=1535><style=\"ItemQuality_5\">Nature Ward</style></linktext> decreases by <style=\"accent-gn\">5s</style>."},"544":{"name":"Wide-area Thorns","description":"Successful hit of <linktext=1529><style=\"ItemQuality_5\">Feral Seed</style></linktext> on the targets with <linktext=1117><style=\"ItemQuality_5\">Thorn</style></linktext> spreads <linktext=1117><style=\"ItemQuality_5\">Thorn</style></linktext> to other units within <style=\"accent-gn\">10</style> meters.<br>Attacking Elite or stronger targets grants <style=\"accent-gn\">8%</style> Forest Bonus."},"545":{"name":"Thornbreaker","description":"<linktext=1530><style=\"ItemQuality_5\">Infusion</style></linktext> and <linktext=1593><style=\"ItemQuality_5\">Stag Charge</style></linktext> deal <style=\"accent-gn\">100%</style> more Final DMG to <linktext=1117><style=\"ItemQuality_5\">Thorned</style></linktext> targets (each <style=\"accent-gn\">1%</style> of Mastery grants an additional <style=\"accent-gn\">4%</style>), but the healing conversion of <linktext=1530><style=\"ItemQuality_5\">Infusion</style></linktext> and <linktext=1593><style=\"ItemQuality_5\">Stag Charge</style></linktext> is halved."},"546":{"name":"Pulse Duality","description":"When <linktext=1532><style=\"ItemQuality_5\">Regen Pulse</style></linktext> is actively used, it spreads <style=\"accent-gn\">twice</style>."},"547":{"name":"Swift Shelter","description":"<style=\"accent-gn\">Each</style> use or trigger of <linktext=1532><style=\"ItemQuality_5\">Regen Pulse</style></linktext>, reduces the CD of <linktext=1535><style=\"ItemQuality_5\">Nature Ward</style></linktext> by <style=\"accent-gn\">2s</style>."},"548":{"name":"Pulse Retrospect","description":"<linktext=1532><style=\"ItemQuality_5\">Regen Pulse</style></linktext> returns to your position after it reaches the max distance.<br><linktext=1532><style=\"ItemQuality_5\">Regen Pulse</style></linktext> now deals DMG to enemies."},"549":{"name":"Swift Bud","description":"<style=\"accent-gn\">Each</style> <linktext=1108><style=\"ItemQuality_5\">Regen Bud</style></linktext> gained, reduces the CD of <linktext=1529><style=\"ItemQuality_5\">Feral Seed</style></linktext> by <style=\"accent-gn\">1</style> second."},"550":{"name":"Breath of Symbiosis","description":"<style=\"accent-gn\">Symbiotic Mark</style> increases converted healing by <style=\"accent-gn\">2%</style>. Each <style=\"accent-gn\">5%</style> Mastery grants an additional <style=\"accent-gn\">1%</style>.<br><style=\"accent-gn\">Symbiotic Mark</style> also grants <style=\"accent-gn\">2%</style> Max HP for <style=\"accent-gn\">5</style>s (duration cannot be refreshed when reapplied)."},"551":{"name":"Symbiosis Extension","description":"Each <linktext=1116><style=\"ItemQuality_5\">Wild Seed</style></linktext> fired extends the duration of activated <style=\"accent-gn\">Symbiotic Mark</style> by <style=\"accent-gn\">1s</style>."},"552":{"name":"Pulse Echo","description":"When dealing DMG, <linktext=1530><style=\"ItemQuality_5\">Infusion</style></linktext> grants <style=\"accent-gn\">1</style> stack of <style=\"accent-gn\">Pulse Echo</style>. <br><style=\"accent-gn\">Pulse Echo</style>: Increases DMG dealt of <linktext=1532><style=\"ItemQuality_5\">Regen Pulse</style></linktext> by <style=\"accent-gn\">20%</style>, which lasts <style=\"accent-gn\">12s</style> and stacks up to <style=\"accent-gn\">5</style> times."},"553":{"name":"Luck Damage","description":"Lucky Strike DMG Multiplier +<style=\"accent-gn\">5%</style>.<br>Every <style=\"accent-gn\">1%</style> Luck grants <style=\"accent-gn\">1.5%</style> Lucky Strike DMG Multiplier."},"554":{"name":"Verdant Impact","description":"For every <style=\"accent-gn\">20</style> stacks of <style=\"accent-gn\">Pulse Echo</style> gained, the next actively cast <linktext=1532><style=\"ItemQuality_5\">Regen Pulse</style></linktext> triggers a <linktext=1533><style=\"ItemQuality_5\">Blossom Charge</style></linktext> at both the nearest enemy and the Ally with lowest HP."},"555":{"name":"Wild Luck","description":"When <linktext=1526><style=\"ItemQuality_5\">Wild Bloom</style></linktext> or <linktext=1532><style=\"ItemQuality_5\">Regen Pulse</style></linktext> deal DMG, grants a chance (equal to the <style=\"accent-gn\">half</style> percentage of Luck) to gain <style=\"accent-gn\">1</style> <linktext=1108><style=\"ItemQuality_5\">Regen Bud</style></linktext>. If the target is affected by <linktext=1117><style=\"ItemQuality_5\">Thorn</style></linktext>, doubles the chance."},"556":{"name":"Verdant Nourishment","description":"If you're affected with <linktext=1528><style=\"ItemQuality_5\">Nourish</style></linktext>, reduces all DMG taken by <style=\"accent-gn\">10%</style>. <br>If the targets are affected by <linktext=1528><style=\"ItemQuality_5\">Nourish</style></linktext>, enhances their Healing Received from yourself by <style=\"accent-gn\">5%</style>. If the stack of <linktext=1528><style=\"ItemQuality_5\">Nourish</style></linktext> is above or equal to <style=\"accent-gn\">3</style>, additionally enhances Healing Received by <style=\"accent-gn\">3%</style>."},"557":{"name":"Ultimate Inspiration","description":"Doubles the effectiveness of <linktext=1107><style=\"ItemQuality_5\">Inspiration</style></linktext>."},"558":{"name":"Life Bloom","description":"Using <linktext=1533><style=\"ItemQuality_5\">Blossom Charge</style></linktext> enhances the next <linktext=1527><style=\"ItemQuality_5\">Life Bloom</style></linktext>, skipping the cast and increasing the Healing by <style=\"accent-gn\">50%</style>."},"559":{"name":"Vitality","description":"<linktext=1528><style=\"ItemQuality_5\">Nourish</style></linktext> can stack up to <style=\"accent-gn\">5</style> times.<br>Each use of <linktext=1527><style=\"ItemQuality_5\">Life Bloom</style></linktext> grants the targets with <linktext=1528><style=\"ItemQuality_5\">Nourish</style></linktext> <style=\"accent-gn\">1</style> stack of <linktext=1528><style=\"ItemQuality_5\">Nourish</style></linktext>."},"560":{"name":"Flourishing Progress","description":"When holding <style=\"accent-gn\">2</style> or more <linktext=1108><style=\"ItemQuality_5\">Regen Buds</style></linktext>, casting <linktext=1533><style=\"ItemQuality_5\">Blossom Charge</style></linktext> for damage or healing always triggers a corresponding seed (without costing <linktext=1108><style=\"ItemQuality_5\">Regen Buds</style></linktext>) and grants <style=\"accent-gn\">1</style> <linktext=1108><style=\"ItemQuality_5\">Regen Bud</style></linktext>."},"561":{"name":"Blooming Reincarnation","description":"Casting <linktext=1527><style=\"ItemQuality_5\">Life Bloom</style></linktext> increases <linktext=1527><style=\"ItemQuality_5\">Life Bloom</style></linktext>'s healing by <style=\"accent-gn\">20%</style> and its <style=\"accent-gn\">Energy</style> consumed by <style=\"accent-gn\">10%</style> for <style=\"accent-gn\">4s</style>. This effect can stack up to <style=\"accent-gn\">5</style> times."},"562":{"name":"Energy Arcane","description":"During <linktext=1583><style=\"ItemQuality_5\">Fast Growth</style></linktext>, increases <style=\"accent-gn\">Energy</style> REG SPD by <style=\"accent-gn\">50%</style>. <br>Increases <linktext=1534><style=\"ItemQuality_5\">Grove Wish</style></linktext>'s Crit by <style=\"accent-gn\">10%</style>"},"563":{"name":"Transcendence","description":"Every <style=\"accent-gn\">60</style> self-heals from <linktext=1528><style=\"ItemQuality_5\">Nourish</style></linktext> grants <linktext=1195><style=\"ItemQuality_5\">Transcendence</style></linktext>."},"564":{"name":"Flourishing Flower","description":"Within <style=\"accent-gn\">Grass Domain</style>, <style=\"accent-gn\">Flower Stalk</style> appeared <style=\"accent-gn\">50%</style> earlier."},"565":{"name":"Tricolor Revelation","description":"Consumes <linktext=1121><style=\"ItemQuality_5\">Moonlight Solace</style></linktext> to launch <style=\"accent-gn\">Flower Dance - Tricolor Revelation</style>.<br><style=\"accent-gn\">Flower Dance - Tricolor Revelation</style>: Grants all effects of <style=\"accent-gn\">Flower Stalks</style>, once every <style=\"accent-gn\">60s</style>."},"566":{"name":"Flower Time Dance","description":"Every <style=\"accent-gn\">45s</style>, generates <style=\"accent-gn\">1</style> <style=\"accent-gn\">Flower Stalk</style> in the following order: <linktext=1119><style=\"ItemQuality_5\">Crimson Insight</style></linktext>, <linktext=1120><style=\"ItemQuality_5\">Golden Devotion</style></linktext>, and <linktext=1121><style=\"ItemQuality_5\">Moonlight Solace</style></linktext>."},"567":{"name":"Bud to Blossom","description":"When a <style=\"accent-gn\">Flower Stalk</style> appears, grants <style=\"accent-gn\">1</style> <linktext=1108><style=\"ItemQuality_5\">Regen Bud</style></linktext> every <style=\"accent-gn\">2s</style> for <style=\"accent-gn\">10s</style>."},"568":{"name":"Inspire and Strengthen","description":"<linktext=1107><style=\"ItemQuality_5\">Inspiration</style></linktext> grants <style=\"accent-gn\">135</style> bonus <style=\"accent-gn\">Intellect</style>, <style=\"accent-gn\">Strength</style>, <style=\"accent-gn\">Agility</style>, and <style=\"accent-gn\">Endurance</style>."},"569":{"name":"Energy Expansion","description":"Increases Max <style=\"accent-gn\">Energy</style> by <style=\"accent-gn\">20</style>.<br>Using <linktext=1533><style=\"ItemQuality_5\">Blossom Charge</style></linktext> restores <style=\"accent-gn\">30%</style> lost <style=\"accent-gn\">Energy</style>."},"570":{"name":"Rescue","description":"Healing <style=\"accent-gn\">Expertise Skill</style> restore <style=\"accent-gn\">25%</style> more HP to the targets with HP below <style=\"accent-gn\">50%</style>."},"571":{"name":"Instant Bloom","description":"Every <style=\"accent-gn\">5</style> uses of <linktext=1527><style=\"ItemQuality_5\">Life Bloom</style></linktext> accelerates the using of <linktext=1534><style=\"ItemQuality_5\">Grove Wish</style></linktext> or <linktext=1532><style=\"ItemQuality_5\">Regen Pulse</style></linktext> by <style=\"accent-gn\">100%</style> and increases their Healing by <style=\"accent-gn\">50%</style> in <style=\"accent-gn\">15s</style>."},"900":{"name":"Stone Fragment Tide","description":"For <style=\"accent-gn\">8</style>s after you cast <linktext=1536><style=\"ItemQuality_5\">Cracking Echo</style></linktext>, each <style=\"accent-gn\">Basic Attack</style> pulls a target between <style=\"accent-gn\">8</style> and <style=\"accent-gn\">20</style> meters away toward you. The same target cannot be pulled again within <style=\"accent-gn\">3</style>s."},"901":{"name":"Power Conversion","description":"Armor +7000<br><br>Every <style=\"accent-gn\">3</style> Strength grants <style=\"accent-gn\">3.6</style> Armor."},"902":{"name":"Life Suppress","description":"You gain the <linktext=1122><style=\"ItemQuality_5\">Suppress</style></linktext> Expertise effect."},"903":{"name":"Weakness Strike","description":"When dealing DMG, <style=\"accent-gn\">Basic Attacks</style> have a fixed <style=\"accent-gn\">10%</style> chance to trigger <linktext=1123><style=\"ItemQuality_5\">Weakness Strike</style></linktext> once."},"904":{"name":"Enhanced Weakness Strike","description":"<linktext=1123><style=\"ItemQuality_5\">Weakness Strike</style></linktext>'s fixed trigger chance +<style=\"accent-gn\">10%</style>."},"906":{"name":"Block Recovery","description":"Successful <linktext=1170><style=\"ItemQuality_5\">Block</style></linktext> restores <style=\"accent-gn\">1%</style> of your HP and <style=\"accent-gn\">2</style> <style=\"accent-gn\">Rage</style>. This can only occur once <style=\"accent-gn\">per</style> second. <br>Triggering <linktext=1126><style=\"ItemQuality_5\">Lucky Block</style></linktext> restores <style=\"accent-gn\">2%</style> of your HP and <style=\"accent-gn\">4</style> <style=\"accent-gn\">Rage</style>. This can only occur once <style=\"accent-gn\">per</style> second."},"907":{"name":"Countercrush","description":"A successful <linktext=1170><style=\"ItemQuality_5\">Block</style></linktext> triggers a <linktext=1125><style=\"ItemQuality_5\">Countercrush</style></linktext>, once <style=\"accent-gn\">per</style> second.<br>On a <linktext=1126><style=\"ItemQuality_5\">Lucky Block</style></linktext>, randomly triggers <style=\"accent-gn\">1</style> to <style=\"accent-gn\">3</style> <linktext=1125><style=\"ItemQuality_5\">Countercrush</style></linktext>, once <style=\"accent-gn\">per</style> second."},"911":{"name":"Rock Heal","description":"<linktext=1597><style=\"ItemQuality_5\">Stone Fist</style></linktext> restores <style=\"accent-gn\">5%</style> max HP. For every <style=\"accent-gn\">1</style> extra enemy hit, restores an additional <style=\"accent-gn\">2%</style> max HP (up to a total of <style=\"accent-gn\">15%</style>. Excess healing is converted into an equivalent Shield."},"912":{"name":"Healing Sands","description":"Max HP +10%"},"913":{"name":"Fortune Bastion","description":"During <linktext=1543><style=\"ItemQuality_5\">Brave Bastion</style></linktext>, you can <linktext=1170><style=\"ItemQuality_5\">Block</style> </linktext><style=\"magic\">Magic DMG</style>."},"914":{"name":"Slam Shelter","description":"A successful hit with <linktext=1540><style=\"ItemQuality_5\">Shield Bash</style></linktext> reduces the target's DMG dealt to you by <style=\"accent-gn\">3%</style> for <style=\"accent-gn\">10</style>s, stacking up to <style=\"accent-gn\">3</style> times."},"916":{"name":"Resolute Breath","description":"While shielded, use <style=\"accent-gn\">Basic Attack</style> midair to slam down, detonating the shield and dealing damage equal to <style=\"accent-gn\">30%</style> max HP to nearby enemies."},"917":{"name":"Smash Support","description":"Increases the effectiveness of Shield granted by <linktext=1540><style=\"ItemQuality_5\">Shield Bash</style></linktext> by <style=\"accent-gn\">30%</style>."},"918":{"name":"Sandy Shelter","description":"During <linktext=1542><style=\"ItemQuality_5\">Stoneform</style></linktext>, every <style=\"accent-gn\">20</style> <style=\"accent-gn\">Rage</style> gained triggers <linktext=1168><style=\"ItemQuality_5\">Sandy Shelter</style></linktext>."},"919":{"name":"Shield Combo","description":"<style=\"accent-gn\">Basic Attacks</style> have a fixed <style=\"accent-gn\">5%</style> chance to trigger <linktext=1127><style=\"ItemQuality_5\">Shield Combo</style></linktext> upon dealing DMG. Each <style=\"accent-gn\">1%</style> Mastery grants an extra <style=\"accent-gn\">0.2%</style> chance."},"920":{"name":"Breath of Stone","description":"<style=\"accent-gn\">Each</style> <style=\"accent-gn\">Sand Crystal</style> consumed reduces the CD of <linktext=1542><style=\"ItemQuality_5\">Stoneform</style></linktext> by <style=\"accent-gn\">1</style>s."},"921":{"name":"Elemental Harmony","description":"While shielded, <style=\"magic\">MATK Reduction</style> +<style=\"accent-gn\">10%</style>. Each <style=\"accent-gn\">1%</style> of Mastery increases this effect by <style=\"accent-gn\">0.5%</style>, up to a maximum of <style=\"accent-gn\">40%</style>."},"922":{"name":"Shield Echo","description":"During <linktext=1541><style=\"ItemQuality_5\">Sandshroud</style></linktext>, adding a shield to yourself via <linktext=1540><style=\"ItemQuality_5\">Shield Bash</style></linktext> triggers <linktext=1128><style=\"ItemQuality_5\">Shield Echo</style></linktext>."},"923":{"name":"Shattering Rageblow","description":"When dealing DMG, <linktext=1539><style=\"ItemQuality_5\">Granite Fury</style></linktext> has a <style=\"accent-gn\">20%</style> chance to allow your next <style=\"accent-gn\">Basic Attack</style> to evolve into <linktext=1169><style=\"ItemQuality_5\">Rageblow</style></linktext>. Each <style=\"accent-gn\">2%</style> Luck adds <style=\"accent-gn\">1%</style> chance. <br>After casting <linktext=1169><style=\"ItemQuality_5\">Rageblow</style></linktext>, increases <linktext=1170><style=\"ItemQuality_5\">Block</style></linktext> DMG Reduction by <style=\"accent-gn\">10%</style> for <style=\"accent-gn\">10s</style>."},"924":{"name":"Fang of the Alpha","description":"DMG Reduction vs. Bosses +800"},"925":{"name":"Survival Instinct","description":"When HP falls below <style=\"accent-gn\">30%</style>, triggers <linktext=1129><style=\"ItemQuality_5\">Survival Instinct</style></linktext>, once every <style=\"accent-gn\">60</style>s."},"926":{"name":"Shadow Veil","description":"<style=\"accent-gn\">Each</style> enemy within <style=\"accent-gn\">3</style> meters increases your <linktext=1170><style=\"ItemQuality_5\">Block</style></linktext> chance by <style=\"accent-gn\">3%</style>, up to <style=\"accent-gn\">15%</style>. (Doubles the effect against Elite or stronger enemies.) Remains unchanged when Earthfort Spec is active. <br>If <style=\"accent-gn\">Block Spec</style> is activated, the effect becomes: <style=\"accent-gn\">Every</style> enemy within <style=\"accent-gn\">3</style> meters increases <linktext=1170><style=\"ItemQuality_5\">Block</style></linktext> DMG Reduction by <style=\"accent-gn\">1%</style>, up to <style=\"accent-gn\">5%</style>. (Doubles the effect against Elite or stronger enemies.)"},"927":{"name":"Valiant Fury","description":"When <linktext=1135><style=\"ItemQuality_5\">Enraged</style></linktext>, you gain <style=\"accent-gn\">30%</style> bonus Armor, decreasing by <style=\"accent-gn\">5%</style> per second."},"928":{"name":"Group Suppress","description":"Each enemy within <style=\"accent-gn\">3</style> meters enhances the effectiveness of <linktext=1122><style=\"ItemQuality_5\">Suppress</style></linktext> by <style=\"accent-gn\">3%</style>, up to <style=\"accent-gn\">15%</style>. This effect is doubled against Elite or stronger enemies."},"929":{"name":"Rage Awakening","description":"Consuming <style=\"accent-gn\">Rage</style> has a chance to enter <linktext=1135><style=\"ItemQuality_5\">Enraged</style></linktext> state for <style=\"accent-gn\">5s</style>. The more <style=\"accent-gn\">Rage</style> you consume, the higher the chance. <style=\"accent-gn\">Each</style> <style=\"accent-gn\">Rage</style> increases the chance by <style=\"accent-gn\">1%</style>."},"930":{"name":"Block Spec","description":"Replaces <style=\"accent-gn\">Special Attack</style> with <linktext=1538><style=\"ItemQuality_5\">Countercrush</style></linktext>, and enhances the ability. <br>When <linktext=1126><style=\"ItemQuality_5\">Lucky Block</style></linktext> triggers, increases Block DMG Reduction by <style=\"accent-gn\">10%</style>. <br><br><i><style=\"text_third_gray\"><size=20>Try to keep Countercrush active as much as possible. While it's active, part of incoming DMG can be blocked. High Luck allows parry to yield various buffs.</size></style></i>"},"931":{"name":"Earthfort Spec","description":"Further enhances the ability to use <linktext=1540><style=\"ItemQuality_5\">Shield Bash</style></linktext>. <br><style=\"accent-gn\">Each</style> additional enemy hit increases the damage dealt by <linktext=1540><style=\"ItemQuality_5\">Shield Bash</style></linktext> by <style=\"accent-gn\">30%</style>, up to <style=\"accent-gn\">150%</style>. <br>When attacked, increases All-Element Resistance by <style=\"accent-gn\">0.6%</style> for <style=\"accent-gn\">4s</style>, stacking up to <style=\"accent-gn\">10</style> times. Each <style=\"accent-gn\">1%</style> Mastery increases this effect by <style=\"accent-gn\">2%</style>. <br><br><i><style=\"text_third_gray\"><size=20>Maintain shield uptime whenever possible. Besides reducing incoming damage, the shield also applies certain effects when active.</size></style></i>"},"932":{"name":"Resonant Domain","description":"<linktext=1536><style=\"ItemQuality_5\">Cracking Echo</style></linktext> generates a <linktext=1137><style=\"ItemQuality_5\">Sandfield</style></linktext> that lasts for <style=\"accent-gn\">5</style>s."},"933":{"name":"Sandstone Rewind","description":"When <linktext=1169><style=\"ItemQuality_5\">Rageblow</style></linktext> deals DMG, it reduces the CD of <linktext=1543><style=\"ItemQuality_5\">Brave Bastion</style></linktext> by <style=\"accent-gn\">3</style>s.<br>Casting <linktext=1543><style=\"ItemQuality_5\">Brave Bastion</style></linktext> immediately restores <style=\"accent-gn\">50%</style> Max HP. Any excess healing is converted into a shield that lasts 10s."},"934":{"name":"Sandstone Shock","description":"During <linktext=1543><style=\"ItemQuality_5\">Brave Bastion</style></linktext>, casting <linktext=1538><style=\"ItemQuality_5\">Countercrush</style></linktext> or <linktext=1539><style=\"ItemQuality_5\">Granite Fury</style></linktext> triggers <linktext=1136><style=\"ItemQuality_5\">Sand Crystal Shock</style></linktext>."},"935":{"name":"Block Blessing","description":"A successful <linktext=1170><style=\"ItemQuality_5\">Block</style></linktext> grants a fixed <style=\"accent-gn\">30%</style> chance for your next <linktext=1539><style=\"ItemQuality_5\">Granite Fury</style></linktext> cast to consume no <style=\"accent-gn\">Sand Crystals</style>. This effect can occur up to once every <style=\"accent-gn\">3s</style>."},"936":{"name":"Fury Shelter","description":"While <linktext=1135><style=\"ItemQuality_5\">Enraged</style></linktext>, Max HP +<style=\"accent-gn\">20%</style>."},"937":{"name":"Enraged Suppress","description":"While <linktext=1135><style=\"ItemQuality_5\">Enraged</style></linktext>, <linktext=1122><style=\"ItemQuality_5\">Suppress</style></linktext> effect +<style=\"accent-gn\">50%</style>."},"938":{"name":"Enrage Delay","description":"When <style=\"accent-gn\">Strength</style> reaches <style=\"accent-gn\">500</style>, extends the duration of <linktext=1135><style=\"ItemQuality_5\">Enraged</style></linktext> by <style=\"accent-gn\">1</style> second."},"939":{"name":"Sandstone Revival","description":"For each <style=\"accent-gn\">1</style> <style=\"accent-gn\">Sand Crystal</style> consumed, restore <style=\"accent-gn\">1%</style> of Max HP."},"940":{"name":"Enrage Expansion","description":"While <linktext=1135><style=\"ItemQuality_5\">Enraged</style></linktext>, Attack Speed +<style=\"accent-gn\">8%</style>."},"941":{"name":"Rage Burst improvement","description":"The charge count of <linktext=1544><style=\"ItemQuality_5\">Rage Burst</style></linktext> +<style=\"accent-gn\">1</style>.<br>While <linktext=1135><style=\"ItemQuality_5\">Enraged</style></linktext>, <linktext=1544><style=\"ItemQuality_5\">Rage Burst</style></linktext> and <linktext=1134><style=\"ItemQuality_5\">Terra Sunder</style></linktext> become instant cast."},"942":{"name":"Star Fury","description":"Increases <linktext=1537><style=\"ItemQuality_5\">Star Shatter</style></linktext> and <linktext=1594><style=\"ItemQuality_5\">Starfall</style></linktext> DMG by <style=\"accent-gn\">30%</style>, and guarantees <linktext=1135><style=\"ItemQuality_5\">Enraged</style></linktext> status."},"943":{"name":"Stone Domain","description":"Throughout the duration of <linktext=1541><style=\"ItemQuality_5\">Sandshroud</style></linktext>, being attacked reduces the attack speed of enemy targets within a <style=\"accent-gn\">5</style> meter radius by <style=\"accent-gn\">30%</style> for <style=\"accent-gn\">3s</style>.<br>throughout the duration of <linktext=1541><style=\"ItemQuality_5\">Sandshroud</style></linktext>, Armor of allies within an <style=\"accent-gn\">8</style> meter radius +<style=\"accent-gn\">10%</style>."},"944":{"name":"Amplified Earthfort","description":"Upon the triggering of <linktext=1123><style=\"ItemQuality_5\">Weakness Strike</style></linktext>, gains <linktext=1124><style=\"ItemQuality_5\">Amplified Earthfort</style></linktext>."},"945":{"name":"Boulder Shield","description":"During <linktext=1542><style=\"ItemQuality_5\">Stoneform</style></linktext>, reduces all DMG taken by <style=\"accent-gn\">10%</style>."},"946":{"name":"Shield Bash","description":"Enhances Shield effectiveness by <style=\"accent-gn\">10%</style>.<br>During <linktext=1541><style=\"ItemQuality_5\">Sandshroud</style></linktext>, additionally enhances Shield effectiveness by <style=\"accent-gn\">10%</style>."},"947":{"name":"Recovery","description":"<style=\"accent-gn\">Each</style> successful hit of <style=\"accent-gn\">Expertise Skill</style> or <style=\"accent-gn\">Special Attack</style> increases <style=\"accent-gn\">Strength</style> by <style=\"accent-gn\">1%</style> in <style=\"accent-gn\">5s</style>. The effect stacks up to <style=\"accent-gn\">10</style> times. With <style=\"accent-gn\">10</style> stacks, increases <style=\"accent-gn\">Strength</style> by <style=\"accent-gn\">10%</style> for <style=\"accent-gn\">8s</style>. During this effect, the next <style=\"accent-gn\">Expertise Skill</style> heals you for <style=\"accent-gn\">20%</style> of the DMG dealt, yet no additional <style=\"accent-gn\">Strength</style> stacks can be gained."},"948":{"name":"Starfall","description":"For every <style=\"accent-gn\">20</style> <style=\"accent-gn\">Sand Crystals</style> consumed, <linktext=1537><style=\"ItemQuality_5\">Star Shatter</style></linktext> evolves into <linktext=1594><style=\"ItemQuality_5\">Starfall</style></linktext>."},"949":{"name":"Rock Master","description":"Casting <linktext=1594><style=\"ItemQuality_5\">Starfall</style></linktext> grants <style=\"accent-gn\">Rock Master</style>.<br><style=\"accent-gn\">Rock Master</style>: For <style=\"accent-gn\">15s</style>, <style=\"accent-gn\">Basic Attack</style> evolves into <style=\"accent-gn\">1</style> <linktext=1595><style=\"ItemQuality_5\">Rupture</style></linktext>, and <linktext=1544><style=\"ItemQuality_5\">Rage Burst</style></linktext> evolves into <style=\"accent-gn\">1</style> <linktext=1134><style=\"ItemQuality_5\">Terra Sunder</style></linktext>.<br>When <style=\"accent-gn\">Rock Master</style> activates, grants <style=\"accent-gn\">10%</style> Rock Bonus for <style=\"accent-gn\">10s</style>."},"950":{"name":"Shatter Strike","description":"When <linktext=1537><style=\"ItemQuality_5\">Star Shatter</style></linktext> or <linktext=1594><style=\"ItemQuality_5\">Starfall</style></linktext> defeats a target, <linktext=1537><style=\"ItemQuality_5\">Star Shatter </style></linktext>immediately recovers <style=\"accent-gn\">1</style> charge."},"951":{"name":"Enraged Rupture","description":"While <linktext=1135><style=\"ItemQuality_5\">Enraged</style></linktext>, <linktext=1595><style=\"ItemQuality_5\">Rupture</style></linktext> is bound to trigger <linktext=1123><style=\"ItemQuality_5\">Weakness Strike</style></linktext>."},"952":{"name":"Bash Pursuit","description":"Every <style=\"accent-gn\">50</style> times damage is taken, the next <linktext=1540><style=\"ItemQuality_5\">Shield Bash</style></linktext> deals additional fixed damage equal to <style=\"accent-gn\">100%</style> HP + <style=\"accent-gn\">300%</style> of current shield amount (shield amount cannot exceed <style=\"accent-gn\">150%</style> Max HP). Can trigger at most once every <style=\"accent-gn\">20</style>s. Every <style=\"accent-gn\">2%</style> of Mastery reduces the required times of damage taken by <style=\"accent-gn\">1</style>. Every <style=\"accent-gn\">1%</style> of Versatility reduces the trigger interval by <style=\"accent-gn\">1%</style> (up to <style=\"accent-gn\">50%</style>)."},"953":{"name":"Great Rock Master","description":"Casting <linktext=1542><style=\"ItemQuality_5\">Stoneform​</style></linktext> grants <style=\"accent-gn\">Rock Master</style>: For <style=\"accent-gn\">15s</style>, <style=\"accent-gn\">Basic Attack</style> evolves into <style=\"accent-gn\">1</style> <linktext=1595><style=\"ItemQuality_5\">Rupture</style></linktext>, and <linktext=1544><style=\"ItemQuality_5\">Rage Burst</style></linktext> evolves into <style=\"accent-gn\">1</style><linktext=1134> <style=\"ItemQuality_5\">Terra Sunder</style></linktext>."},"954":{"name":"Bravery in Battle","description":"While in combat, overhealing is converted into a shield (total shield cannot exceed <style=\"accent-gn\">50%</style> of Max HP)."},"955":{"name":"Rock Guard","description":"Armor +<style=\"accent-gn\">5%</style>. <br>Each attack of <linktext=1134><style=\"ItemQuality_5\">Terra Sunder</style></linktext> deals an additional instance of <style=\"physical\">Attack DMG</style> to the target, equal to <style=\"accent-gn\">100%</style> Armor."},"956":{"name":"Rampart Fury","description":"When you take DMG, <linktext=1126><style=\"ItemQuality_5\">Lucky Block</style></linktext> reduces DMG taken by <style=\"accent-gn\">2%</style>, lasting for <style=\"accent-gn\">8</style>s, stacking up to <style=\"accent-gn\">3</style> times."},"957":{"name":"Block Shelter","description":"<linktext=1539><style=\"ItemQuality_5\">Granite Fury</style></linktext> DMG enhances <linktext=1126><style=\"ItemQuality_5\">Lucky Block</style></linktext> DMG Reduction by <style=\"accent-gn\">2%</style> for <style=\"accent-gn\">8s</style>. Stacks up to <style=\"accent-gn\">3</style> times."},"958":{"name":"Sand Block","description":"Successfully <linktext=1170><style=\"ItemQuality_5\">Blocking</style></linktext> has a fixed <style=\"accent-gn\">20%</style> chance to gain <style=\"accent-gn\">1</style> <style=\"accent-gn\">Sand Crystal</style>. If it was a <linktext=1126><style=\"ItemQuality_5\">Lucky Block</style></linktext>, gain an additional <style=\"accent-gn\">1</style> <style=\"accent-gn\">Sand Crystal</style>.<linktext=1170><style=\"ItemQuality_5\"></style></linktext>"},"959":{"name":"Rock Heart","description":"Every <style=\"accent-gn\">10</style> casts of <linktext=1539><style=\"ItemQuality_5\">​Granite Fury​</style></linktext> grant <style=\"accent-gn\">Rock Heart</style>.<br><style=\"accent-gn\">Rock Heart</style>: For <style=\"accent-gn\">10s</style>, <linktext=1539><style=\"ItemQuality_5\">​Granite Fury​</style></linktext> evolves into <linktext=1597><style=\"ItemQuality_5\">Stone Fist</style></linktext>.<br>When <style=\"accent-gn\">Rock Heart</style> activates, grants <style=\"accent-gn\">10%</style> Rock Bonus for <style=\"accent-gn\">10s</style>.<br>Casting <linktext=1597><style=\"ItemQuality_5\">Stone Fist</style></linktext> guarantees <linktext=1135><style=\"ItemQuality_5\">Enraged</style></linktext>."},"960":{"name":"Granite","description":"After casting <linktext=1597><style=\"ItemQuality_5\">Stone Fist</style></linktext>, for the next <style=\"accent-gn\">10s</style>, summons <style=\"accent-gn\">1</style> <linktext=1131><style=\"ItemQuality_5\">Granite</style></linktext> every <style=\"accent-gn\">2s</style>."},"961":{"name":"Granite Fury","description":"For every <style=\"accent-gn\">50</style> <style=\"accent-gn\">Rage</style> generated, summons <style=\"accent-gn\">1</style> <linktext=1131><style=\"ItemQuality_5\">Granite</style></linktext>."},"962":{"name":"Granite Fury Pursuit","description":"Every <style=\"accent-gn\">50</style> times damage is taken, the next <linktext=1539><style=\"ItemQuality_5\">Granite Fury</style></linktext> deals additional fixed damage equal to <style=\"accent-gn\">7,000%</style> of Armor. Can trigger at most once every <style=\"accent-gn\">20</style>s. Every <style=\"accent-gn\">2%</style> Mastery reduces the required times of damage taken by <style=\"accent-gn\">1</style>. Every <style=\"accent-gn\">1%</style> Luck reduces the trigger interval by <style=\"accent-gn\">1%</style> (up to <style=\"accent-gn\">50%</style>)."},"963":{"name":"Rampart Fortitude","description":"While <linktext=1543><style=\"ItemQuality_5\">Brave Bastion</style></linktext> is active, taking DMG doubles <linktext=1125><style=\"ItemQuality_5\">Countercrush</style></linktext> DMG."},"964":{"name":"Rage Enhancement","description":"<linktext=1539><style=\"ItemQuality_5\">Granite Fury</style></linktext> consumes <style=\"accent-gn\">1</style> <style=\"accent-gn\">Sand Crystal</style>."},"965":{"name":"Granite Combo","description":"When <linktext=1131><style=\"ItemQuality_5\">Granite</style></linktext> deals DMG, there is a chance, of which equals Luck Chance, to summon <style=\"accent-gn\">an additional</style> <linktext=1131><style=\"ItemQuality_5\">Granite</style></linktext>."},"966":{"name":"Intimidation","description":"When <linktext=1131><style=\"ItemQuality_5\">Granite</style></linktext> hits a target, it reduces all DMG taken by <style=\"accent-gn\">10%</style> for the next <style=\"accent-gn\">5s</style>."},"967":{"name":"Granite Fury","description":"Summoning <style=\"accent-gn\">20</style> <linktext=1131><style=\"ItemQuality_5\">Granites</style></linktext> grants <style=\"accent-gn\">Rock Heart</style>: For <style=\"accent-gn\">10s</style>, <linktext=1539><style=\"ItemQuality_5\">Granite Fury</style></linktext> evolves into <linktext=1597><style=\"ItemQuality_5\">Stone Fist</style></linktext>."},"968":{"name":"Counter Storm","description":"For <style=\"accent-gn\">10s</style> after casting <linktext=1536><style=\"ItemQuality_5\">Cracking Echo</style></linktext>, trigger <style=\"accent-gn\">1</style> <linktext=1125><style=\"ItemQuality_5\">Countercrush</style></linktext> every <style=\"accent-gn\">2s</style>."},"969":{"name":"Rock Luck","description":"Luck Chance +<style=\"accent-gn\">5%</style>. <br><linktext=1125><style=\"ItemQuality_5\">Countercrush</style></linktext> Crit +<style=\"accent-gn\">50%</style>."},"970":{"name":"Rock Mastery","description":"Mastery +<style=\"accent-gn\">6,250</style>.<br>During <linktext=1543><style=\"ItemQuality_5\">Brave Bastion</style></linktext>, Mastery +<style=\"accent-gn\">8%</style>."},"971":{"name":"Enraged Rock Heart","description":"While <linktext=1135><style=\"ItemQuality_5\">Enraged</style></linktext>, increases Luck Chance by <style=\"accent-gn\">10%</style>."},"1100":{"name":"Photon Limit","description":"Increases Max <style=\"accent-gn\">Photon Energy</style> by <style=\"accent-gn\">20</style>, extending the duration of <linktext=1138><style=\"ItemQuality_5\">Photon Reforge</style></linktext>. Unaffected when Wildpack Spec is active. <br>If Falconry Spec is activated, the effect becomes: Max <style=\"accent-gn\">Photon Energy</style> -<style=\"accent-gn\">20</style> but <linktext=1138><style=\"ItemQuality_5\">Photon Reforge</style></linktext> state can be entered more quickly."},"1101":{"name":"Agility Conversion","description":"Every <style=\"accent-gn\">10</style> Agility grants <style=\"accent-gn\">7</style> Haste."},"1102":{"name":"Vulnerable Strike","description":"Dealing DMG grants a fixed <style=\"accent-gn\">30%</style> chance to apply <style=\"accent-gn\">Vulnerability</style> to the enemy. <br><style=\"accent-gn\">Vulnerability</style>: Increases the DMG you deal to the target by <style=\"accent-gn\">10%</style> for <style=\"accent-gn\">5s</style>."},"1103":{"name":"Wolf Pact","description":"Tames a <style=\"accent-gn\">Wild Wolf</style> to fight alongside you. <linktext=1601><style=\"ItemQuality_5\">Storm Arrow</style></linktext> has a <style=\"accent-gn\">30%</style> fixed chance to trigger <style=\"accent-gn\">Coordinated Attack</style>. <br><br><style=\"accent-gn\">Wild Wolf</style><br>A <style=\"accent-gn\">Wild Wolf</style> fights alongside you. <br><style=\"accent-gn\">Basic Attack</style>: Sweeps the enemy, dealing <style=\"physical\">Attack DMG</style> equal to <style=\"accent-gn\">60%</style> ATK (which scales with the Level/Tier of your <style=\"accent-gn\">Basic Attack</style>). <br><style=\"accent-gn\">Coordinated Attack</style>: <style=\"accent-gn\">Wild Wolf</style> leaps to the enemy and bites, dealing <style=\"physical\">Attack DMG</style> equal to <style=\"accent-gn\">100%</style> ATK (which scales with the Level/Tier of your <style=\"accent-gn\">Basic Attack</style>)."},"1104":{"name":"Psychic Surge","description":"For every <style=\"accent-gn\">15</style> <style=\"accent-gn\">Special Attacks</style> cast, <style=\"accent-gn\">Photon Energy</style> granted by the next cast of <linktext=1550><style=\"ItemQuality_5\">Arrow Rain</style></linktext> +<style=\"accent-gn\">100%</style>."},"1105":{"name":"Battle Howl","description":"While <linktext=1549><style=\"ItemQuality_5\">Wildcall</style></linktext> is active, the <style=\"accent-gn\">Wild Wolf</style> is bound to deal Crit DMG on hit."},"1106":{"name":"Direwolf's Hunger","description":"When the <style=\"accent-gn\">Wild Wolf</style> deals Crit DMG, you and your Beast gain <style=\"accent-gn\">2%</style> Haste for <style=\"accent-gn\">10</style>s. This effect stacks up to <style=\"accent-gn\">5</style> times.<br>When Haste exceeds <style=\"accent-gn\">35%</style>, every extra <style=\"accent-gn\">1%</style> of Haste grants <style=\"accent-gn\">0.2%</style> ATK."},"1107":{"name":"Meditation","description":"While in <linktext=1138><style=\"ItemQuality_5\">Photon Reforge</style></linktext>, <style=\"accent-gn\">Photon Energy</style> drain per second is reduced from <style=\"accent-gn\">25</style> to <style=\"accent-gn\">20</style>, allowing the effect to last longer. Unaffected when Wildpack Spec is active. <br>If Falconry Spec is activated, the effect becomes: <style=\"accent-gn\">Photon Energy</style> regeneration is increased from <style=\"accent-gn\">2</style> to <style=\"accent-gn\">3</style> points per second, reducing the time required to enter <linktext=1138><style=\"ItemQuality_5\">Photon Reforge</style></linktext>."},"1108":{"name":"Phantom Wolfstrike","description":"When <style=\"accent-gn\">Wild Wolf</style> launches a <style=\"accent-gn\">Coordinated Attack</style>, or <linktext=1139><style=\"ItemQuality_5\">Tail Sweep</style></linktext>, there is a fixed <style=\"accent-gn\">30%</style> chance to summon a <style=\"accent-gn\">Phantom Direwolf</style> using <linktext=1140><style=\"ItemQuality_5\">Pounce and Bite</style></linktext> to attack the current enemy. <br><linktext=1140><style=\"ItemQuality_5\">Pounce and Bite</style></linktext> inflicts <linktext=1141><style=\"ItemQuality_5\">Bleed</style></linktext>, and if the target is already suffered from <linktext=1141><style=\"ItemQuality_5\">Bleed</style></linktext>, <linktext=1140><style=\"ItemQuality_5\">Pounce and Bite</style></linktext> deals Crit DMG."},"1109":{"name":"Direwolf Bite","description":"<style=\"accent-gn\">Wild Wolf</style>'s <style=\"accent-gn\">Coordinated Attack</style> has a <style=\"accent-gn\">50%</style> fixed chance to inflict <linktext=1141><style=\"ItemQuality_5\">Bleed</style></linktext>."},"1110":{"name":"Demon Wolf Twin","description":"When <linktext=1601><style=\"ItemQuality_5\">Storm Arrow</style></linktext> deals DMG in battle, it has a fixed <style=\"accent-gn\">10%</style> chance to summon a <style=\"accent-gn\">Wild Wolf</style> for <style=\"accent-gn\">8</style>s. This effect can occur once every <style=\"accent-gn\">40s</style>."},"1111":{"name":"Photon Reforge Lore","description":"While <linktext=1138><style=\"ItemQuality_5\">Photon Reforge</style></linktext> is active, all of the <style=\"accent-gn\">Wild Wolf</style>'s attacks nullify the target's Armor."},"1112":{"name":"Twin Arrows","description":"<linktext=1546><style=\"ItemQuality_5\">Luminary Bolt</style></linktext> additionally causes a <style=\"accent-gn\">Photon</style> Explosion, dealing <style=\"physical\">Attack DMG</style> equal to <style=\"accent-gn\">1,500%</style> ATK (which scales with the Level/Tier of Ultimate), and also knocks targets airborne and increases the DMG you deal to them by <style=\"accent-gn\">5%</style> for <style=\"accent-gn\">10s</style>."},"1114":{"name":"Tracer Arrows","description":"While <linktext=1138><style=\"ItemQuality_5\">Photon Reforge</style></linktext> is active, for <style=\"accent-gn\">each</style> beast on the battlefield, <linktext=1601><style=\"ItemQuality_5\">Storm Arrow</style></linktext> fires <style=\"accent-gn\">1</style> extra <linktext=1142><style=\"ItemQuality_5\">Lightseeker Arrow</style></linktext> (up to <style=\"accent-gn\">4</style> arrows)."},"1115":{"name":"Radiant Spirit","description":"Extends the duration of <linktext=1555><style=\"ItemQuality_5\">Focus</style></linktext> by <style=\"accent-gn\">3</style>s."},"1116":{"name":"Swift","description":"Applies <style=\"accent-gn\">Swift</style> to the <style=\"accent-gn\">Falcon</style> when casting <linktext=1143><style=\"ItemQuality_5\">Lightning Strike</style></linktext>.<br><style=\"accent-gn\">Swiftness</style>: Increases Attack SPD by <style=\"accent-gn\">10%</style>. This effect lasts <style=\"accent-gn\">8</style>s and stacks up to <style=\"accent-gn\">3</style> times."},"1117":{"name":"Radiant Sharpshooter","description":"Reduces Max <style=\"accent-gn\">Photon Energy</style> by <style=\"accent-gn\">20</style>."},"1118":{"name":"Falcon Raid","description":"For every <style=\"accent-gn\">3</style> instances of Crit DMG dealt by <style=\"accent-gn\">Special Attacks</style>, the <style=\"accent-gn\">Falcon</style> instantly launches <linktext=1143><style=\"ItemQuality_5\">Lightning Strike</style></linktext>."},"1119":{"name":"Meteor","description":"When the <style=\"accent-gn\">Falcon</style> strikes, grants you a fixed <style=\"accent-gn\">30%</style> chance to gain 1 stack of <style=\"accent-gn\">Weak Point Aim</style>. <br>Using <linktext=1557><style=\"ItemQuality_5\">Quadraflare</style></linktext> leaves behind a <style=\"accent-gn\">Radiance Rift</style> midair. <style=\"accent-gn\">Radiance Rift</style> fires <linktext=1188><style=\"ItemQuality_5\">Photon Arrows</style></linktext> equal to the current number of <style=\"accent-gn\">Weak Point Aim</style> stacks."},"1120":{"name":"Piercing Shot","description":"Increases the Crit of <linktext=1547><style=\"ItemQuality_5\">Double Arrow</style></linktext> and <linktext=1557><style=\"ItemQuality_5\">Quadraflare</style></linktext> by <style=\"accent-gn\">7%</style>."},"1121":{"name":"Falcon's Heart","description":"The <style=\"accent-gn\">Falcon</style> ignores <style=\"accent-gn\">30%</style> of the target's Armor."},"1122":{"name":"Lightfall","description":"Each <style=\"accent-gn\">1%</style> critical rate increases Crit DMG by <style=\"accent-gn\">0.5%</style>.<br>When <linktext=1547><style=\"ItemQuality_5\">Double Arrow</style></linktext> or <linktext=1557><style=\"ItemQuality_5\">Quadraflare</style></linktext> deals Crit DMG, <style=\"accent-gn\">2</style> <style=\"accent-gn\">Photon Energy</style> is restored."},"1123":{"name":"Focused Shot","description":"<style=\"accent-gn\">Every</style> target hit grants <style=\"accent-gn\">1%</style> Light DMG bonus. The bonus lasts <style=\"accent-gn\">3</style>s and can layerup to <style=\"accent-gn\">4</style> times."},"1124":{"name":"Valiant Heart","description":"Companions deal <style=\"accent-gn\">15%</style> more DMG to Elites or stronger enemies."},"1125":{"name":"Overcharge","description":"When <style=\"accent-gn\">Basic Attacks</style> deal DMG, there is a <style=\"accent-gn\">5%</style> fixed chance to instantly grant <style=\"accent-gn\">Special Attack</style> 1 charge, up to the maximum charge limit."},"1126":{"name":"Wildpack Spec","description":"Further enhances <linktext=1601><style=\"ItemQuality_5\">Storm Arrow</style></linktext> and the <style=\"accent-gn\">Wild Wolf</style>'s power.<br><linktext=1601><style=\"ItemQuality_5\">Storm Arrow</style></linktext> always deals <style=\"accent-gn\">200%</style> Crit DMG on critical hits.<br>While <linktext=1138><style=\"ItemQuality_5\">Photon Reforge</style></linktext> is active, the chance for the <style=\"accent-gn\">Wild Wolf</style> to trigger <style=\"accent-gn\">Coordinated Attack</style> is increased to <style=\"accent-gn\">100%</style>.<br><br><i><style=\"text_third_gray\"><size=20>The Wild Wolf becomes empowered, and Haste allows both you and the wolf to attack more frequently.</size></style></i>"},"1127":{"name":"Arrow Barrage","description":"<style=\"accent-gn\">Basic Attacks</style> have a fixed <style=\"accent-gn\">20%</style> chance to fire one arrow at each of up to <style=\"accent-gn\">3</style> enemies near the target."},"1128":{"name":"Sundering Arrow","description":"<style=\"accent-gn\">Basic Attacks</style> have a fixed <style=\"accent-gn\">15%</style> chance to trigger <linktext=1151><style=\"ItemQuality_5\">Split Arrow</style></linktext>, once <style=\"accent-gn\">per</style> second."},"1129":{"name":"Falconry Spec","description":"Replaces <style=\"accent-gn\">Special Attack</style> with <linktext=1547><style=\"ItemQuality_5\">Double Arrow</style></linktext> and enhances the ability to use this skill.<br>Regenerates <style=\"accent-gn\">2</style> <style=\"accent-gn\">Photon Energy</style> per second.<br>Each <style=\"accent-gn\">1%</style> Haste grants <style=\"accent-gn\">1%</style> CD decrease to <linktext=1547><style=\"ItemQuality_5\">Double Arrow</style></linktext>.<br>You can tame a <style=\"accent-gn\">Falcon</style> to assist you in battle.<br><br><style=\"accent-gn\">Falcon</style> always follows the caster. When the caster deals DMG with Class Skills, the <style=\"accent-gn\">Falcon</style> has a fixed <style=\"accent-gn\">23%</style> chance to swiftly strike the target (guaranteed on Crit), dealing <style=\"physical\">Attack DMG</style> equal to <style=\"accent-gn\">150%</style> ATK to the enemy (which scales with the Level/Tier of <style=\"accent-gn\">Basic Attack</style>). Additionally, when the strike count of the <style=\"accent-gn\">Falcon</style> exceeds <style=\"accent-gn\">5</style>, the next strike of the <style=\"accent-gn\">Falcon</style> combines all excess strikes and DMG.<br><br><i><style=\"text_third_gray\"><size=20>The Falcon responds to the caster's attacks. Haste and Crit increase its strike frequency, and after learning Lightning Strike, the Falcon deals significantly more DMG.</size></style></i>"},"1130":{"name":"Wolf Dancer","description":"After you use <linktext=1550><style=\"ItemQuality_5\">Arrow Rain</style></linktext>, the <style=\"accent-gn\">Wild Wolf</style> continuously performs <linktext=1139><style=\"ItemQuality_5\">Tail Sweep</style></linktext> until the <linktext=1550><style=\"ItemQuality_5\">Arrow Rain</style></linktext> ends.<br><style=\"accent-gn\">Wild Wolf</style>'s <linktext=1139><style=\"ItemQuality_5\">Tail Sweep</style></linktext> is bound to deal Crit DMG and to inflict <linktext=1141><style=\"ItemQuality_5\">Bleed</style></linktext>."},"1131":{"name":"Explosive Arrow","description":"When a <style=\"accent-gn\">Basic Attack</style> or <style=\"accent-gn\">Special Attack</style> deals DMG, it has a fixed <style=\"accent-gn\">10%</style> chance to fire an <linktext=1144><style=\"ItemQuality_5\">Explosive Arrow</style></linktext>, once every <style=\"accent-gn\">3s</style>."},"1132":{"name":"Rapid Shot","description":"Every <style=\"accent-gn\">5%</style> Haste provides an additional <style=\"accent-gn\">1%</style> attack speed."},"1133":{"name":"Beast Power","description":"Companion's damage +<style=\"accent-gn\">10%</style>."},"1134":{"name":"Dexterity","description":"When <style=\"accent-gn\">Agility</style> reaches <style=\"accent-gn\">500</style> points, attack speed +<style=\"accent-gn\">5%</style>."},"1135":{"name":"Quick Shot","description":"Attack SPD +3%"},"1136":{"name":"Wolf Sharp Strike","description":"In the state of <linktext=1138><style=\"ItemQuality_5\">Photon Reforge</style></linktext>, <style=\"accent-gn\">Wolf</style> Crit DMG +<style=\"accent-gn\">50%</style>."},"1137":{"name":"Beast Tidal Power","description":"Increases Light Bonus by <style=\"accent-gn\">3%</style>. <br>For <style=\"accent-gn\">5s</style> after casting <linktext=1580><style=\"ItemQuality_5\">Torrent Volley</style></linktext> or its enhanced form <linktext=1602><style=\"ItemQuality_5\">Lumi Torrent</style></linktext>, increases Light Bonus by <style=\"accent-gn\">10%</style>."},"1138":{"name":"Arrow Rain Acceleration","description":"Each time you summon <style=\"accent-gn\">1</style> <style=\"accent-gn\">Wolf</style> or <style=\"accent-gn\">Phantom Wolf</style>, the remaining CD of <linktext=1550><style=\"ItemQuality_5\">Arrow Rain</style></linktext> -<style=\"accent-gn\">0.5s</style>."},"1139":{"name":"Life Hunt","description":"For each additional <linktext=1141><style=\"ItemQuality_5\">Bleed</style></linktext> effect on the target, <style=\"accent-gn\">Wolf</style> deals +<style=\"accent-gn\">3%</style> damage to it."},"1140":{"name":"Wolf Fang Pact","description":"<style=\"accent-gn\">Wild Wolf</style>'s <style=\"accent-gn\">Coordinated Attack</style> or <style=\"accent-gn\">Tail Sweep</style> deals damage (triggers only once even when hitting multiple targets) and reduces the remaining CD of <linktext=1601><style=\"ItemQuality_5\">Storm Arrow</style></linktext> by <style=\"accent-gn\">1</style>s."},"1141":{"name":"Light and Shadow Drain","description":"<linktext=1142><style=\"ItemQuality_5\">Lightseeker Arrow</style></linktext> has a fixed <style=\"accent-gn\">50%</style> chance to apply <linktext=1141><style=\"ItemQuality_5\">Bleed</style></linktext> to the target."},"1142":{"name":"Wolf Evolution","description":"<style=\"accent-gn\">Wild Wolf</style> evolves into its <style=\"accent-gn\">Adult Form</style>, increases DMG by <style=\"accent-gn\">30%</style>, DMG Range by <style=\"accent-gn\">50%</style>."},"1143":{"name":"Legendary Beast","description":"Casting <linktext=1549><style=\"ItemQuality_5\">Wildcall</style></linktext> summons a Legendary Companion based on current <style=\"accent-gn\">Photon Energy</style>: If <style=\"accent-gn\">Photon Energy</style> is below <style=\"accent-gn\">50%</style>, summons <linktext=1146><style=\"ItemQuality_5\">Legendary Eagle</style></linktext>. If <style=\"accent-gn\">Photon Energy</style> reaches <style=\"accent-gn\">50%</style> or more, summons <linktext=1147><style=\"ItemQuality_5\">Legendary Boar</style></linktext>.<br><linktext=1549><style=\"ItemQuality_5\">Wildcall</style></linktext> now holds up to <style=\"accent-gn\">2</style> charges."},"1144":{"name":"Lumi Torrent","description":"While in <linktext=1138><style=\"ItemQuality_5\">Photon Reforge</style></linktext> state, <linktext=1580><style=\"ItemQuality_5\">Torrent Volley</style></linktext> continuously charges. After <style=\"accent-gn\">30s</style> of charging, <linktext=1580><style=\"ItemQuality_5\">Torrent Volley</style></linktext> evolves into <linktext=1602><style=\"ItemQuality_5\">Lumi Torrent</style></linktext>.<br>Upon casting <linktext=1602><style=\"ItemQuality_5\">Lumi Torrent</style></linktext>, immediately gain full <style=\"accent-gn\">Photon Energy</style>."},"1145":{"name":"Wild Call CD","description":"For <style=\"accent-gn\">each</style> <linktext=1142><style=\"ItemQuality_5\">Lightseeker Arrow</style></linktext> fired, reduces the remaining CD of <linktext=1549><style=\"ItemQuality_5\">Wildcall</style></linktext> by <style=\"accent-gn\">0.4</style>s (when Haste exceeds <style=\"accent-gn\">30%</style>, each extra <style=\"accent-gn\">1%</style> Haste reduces an additional <style=\"accent-gn\">0.005</style>s, up to <style=\"accent-gn\">0.8</style>s)."},"1146":{"name":"Mastery of Bleed","description":"Each <style=\"accent-gn\">1%</style> Mastery grants <style=\"accent-gn\">6%</style> <linktext=1141><style=\"ItemQuality_5\">Bleed</style></linktext> DMG."},"1147":{"name":"Light Chasing Sharp","description":"While <linktext=1138><style=\"ItemQuality_5\">Photon Reforge</style></linktext> is active, reduces <linktext=1601><style=\"ItemQuality_5\">Storm Arrow</style></linktext> CD by <style=\"accent-gn\">50%</style>."},"1148":{"name":"Arrow of Light","description":"<linktext=1550><style=\"ItemQuality_5\">Arrow Rain</style></linktext> and <linktext=1142><style=\"ItemQuality_5\">Lightseeker Arrow</style></linktext> are bound to deal Crit DMG."},"1149":{"name":"Light Intent","description":"Increases Max <style=\"accent-gn\">Photon Energy</style> by <style=\"accent-gn\">20</style>."},"1150":{"name":"Wolf's Bite","description":"<style=\"accent-gn\">Wild Wolf</style> deals additionally <style=\"accent-gn\">30%</style> DMG to targets with current HP less than or equal to <style=\"accent-gn\">35%</style>."},"1151":{"name":"Stomp","description":"Casting <linktext=1549><style=\"ItemQuality_5\">Wildcall</style></linktext> again within <style=\"accent-gn\">10s</style> of its initial cast commands all beasts on the field to immediately cast <linktext=1145><style=\"ItemQuality_5\">Stomp</style></linktext>."},"1152":{"name":"Steel Beak","description":"When the caster and the <style=\"accent-gn\">Falcon</style> deal Crit DMG, inflicts <style=\"accent-gn\">1</style> stack of <linktext=1148><style=\"ItemQuality_5\">Steel Beak</style></linktext> to the target.<br>Every <style=\"accent-gn\">10</style> stacks of <linktext=1148><style=\"ItemQuality_5\">Steel Beak</style></linktext> trigger <linktext=1143><style=\"ItemQuality_5\">Lightning Strike</style></linktext>, up to once every <style=\"accent-gn\">3s</style>."},"1153":{"name":"Phantom Falcon","description":"Triggering <style=\"accent-gn\">Implosion</style> <style=\"accent-gn\">5</style> times summons a <linktext=1150><style=\"ItemQuality_5\">Phantom Falcon</style></linktext> to charge at the target. For each additional target hit by the <linktext=1150><style=\"ItemQuality_5\">Phantom Falcon</style></linktext>, its DMG increases by <style=\"accent-gn\">20%</style>, up to <style=\"accent-gn\">200%</style>."},"1154":{"name":"Focused Concentration","description":"Throughout the duration of <linktext=1555><style=\"ItemQuality_5\">Focus</style></linktext>, gains <style=\"accent-gn\">0.5%</style> Crit and <style=\"accent-gn\">1%</style> Crit DMG every <style=\"accent-gn\">0.5s</style>, stacking up to <style=\"accent-gn\">15</style> times."},"1155":{"name":"Dual Arrow Mastery","description":"When a <style=\"accent-gn\">Special Attack</style> deals Crit DMG, reduces the remaining CD of <linktext=1548><style=\"ItemQuality_5\">Blast Shot</style></linktext> and <linktext=1582><style=\"ItemQuality_5\">Powerdraw</style></linktext> by <style=\"accent-gn\">1</style> second."},"1156":{"name":"Sharp Double Arrow I","description":"Increases the Crit DMG of <linktext=1547><style=\"ItemQuality_5\">Double Arrow</style></linktext> and <linktext=1557><style=\"ItemQuality_5\">Quadraflare</style></linktext> by <style=\"accent-gn\">15%</style>."},"1157":{"name":"Light Energy Stasis","description":"When <linktext=1581><style=\"ItemQuality_5\">Radiance Barrage</style></linktext> hits a target, it applies <style=\"accent-gn\">Light Energy Stasis</style> to them.<br><style=\"accent-gn\">Light Energy Stasis</style>: movement speed -<style=\"accent-gn\">30%</style>. Being hit by <linktext=1582><style=\"ItemQuality_5\">Powerdraw</style></linktext> is bound to deal Crit DMG. Lasts for <style=\"accent-gn\">5s</style>."},"1158":{"name":"Falcon Break","description":"The <style=\"accent-gn\">Falcon</style> ignores <style=\"accent-gn\">20%</style> of the target's Armor, and <style=\"accent-gn\">40%</style> when dealing Crit DMG."},"1159":{"name":"Eagle Eye","description":"When <style=\"accent-gn\">Photon Energy</style> is above <style=\"accent-gn\">50%</style>, casting <linktext=1581><style=\"ItemQuality_5\">Radiance Barrage</style></linktext> counts as <linktext=1138><style=\"ItemQuality_5\">Photon Reforge</style></linktext>."},"1160":{"name":"Celestial Eagle","description":"While <linktext=1555><style=\"ItemQuality_5\">Focus</style></linktext> is active, <linktext=1581><style=\"ItemQuality_5\">Radiance Barrage</style></linktext> summons <style=\"accent-gn\">1</style> <linktext=1149><style=\"ItemQuality_5\">Celestial Eagle</style></linktext> at the target's location.<br>Now, each <style=\"accent-gn\">1%</style> of Haste increases the CD Boost of Focus by <style=\"accent-gn\">1%</style>."},"1161":{"name":"Radiant Charge","description":"When an arrow fired from <style=\"accent-gn\">Radiance Rift</style> deals DMG for <style=\"accent-gn\">1</style> time, increases the DMG of the next <linktext=1548><style=\"ItemQuality_5\">Blast Shot</style></linktext> by <style=\"accent-gn\">20%</style>, up to a maximum of <style=\"accent-gn\">100%</style>."},"1162":{"name":"Light Prism","description":"When <linktext=1143><style=\"ItemQuality_5\">Lightning Strike</style></linktext> hits a target, it triggers <style=\"accent-gn\">Light Prism</style>.<br><style=\"accent-gn\">Light Prism</style>: Deals area damage equal to <style=\"accent-gn\">100%</style> ATK to up to <style=\"accent-gn\">5</style> surrounding enemy targets, and additionally applies <style=\"accent-gn\">3</style> stacks of <linktext=1148><style=\"ItemQuality_5\">Steel Beak</style></linktext>."},"1163":{"name":"Lightning Strike","description":"Increases <linktext=1143><style=\"ItemQuality_5\">Lightning Strike</style></linktext> DMG by <style=\"accent-gn\">30%</style>."},"1164":{"name":"Energy Gathering Power","description":"<linktext=1582><style=\"ItemQuality_5\">Powerdraw</style></linktext> CD -<style=\"accent-gn\">50%</style>.<br>When <style=\"accent-gn\">Photon Energy</style> is above <style=\"accent-gn\">50%</style>, casting <linktext=1582><style=\"ItemQuality_5\">Powerdraw</style></linktext> counts as <linktext=1138><style=\"ItemQuality_5\">Photon Reforge</style></linktext>."},"1165":{"name":"Steel Beak Strike","description":"When <linktext=1582><style=\"ItemQuality_5\">Powerdraw</style></linktext> hits a target, it applies <style=\"accent-gn\">2</style> stacks of <linktext=1148><style=\"ItemQuality_5\">Steel Beak</style></linktext>. If it deals Crit DMG, it applies <style=\"accent-gn\">5</style> stacks of <linktext=1148><style=\"ItemQuality_5\">Steel Beak</style></linktext>."},"1166":{"name":"Steel Beak Gathering","description":"When <linktext=1149><style=\"ItemQuality_5\">Celestial Eagle</style></linktext> hits a target, it prevents the target's <linktext=1148><style=\"ItemQuality_5\">Steel Beak</style></linktext> from naturally decaying."},"1167":{"name":"Chain Explosion","description":"<linktext=1548><style=\"ItemQuality_5\">Blast Shot</style></linktext> Upon detonation, inflicts <style=\"accent-gn\">10</style> stacks of <linktext=1148><style=\"ItemQuality_5\">Steel Beak</style></linktext> on all targets hit."},"1200":{"name":"Lightforged Body","description":"Every <style=\"accent-gn\">1</style> <style=\"accent-gn\">Holy Sigil</style> consumed grants a <linktext=1172><style=\"ItemQuality_5\">Radiant Shield</style></linktext> equal to <style=\"accent-gn\">45%</style> ATK (depending on Adventurer Level, up to <style=\"accent-gn\">90%</style>)."},"1201":{"name":"Condemn","description":"When casting a skill that consumes <style=\"accent-gn\">Photon Energy</style>, there is a <style=\"accent-gn\">30%</style> fixed chance for <style=\"accent-gn\">Basic Attacks</style> to evolve into <linktext=1598><style=\"ItemQuality_5\">Condemn</style></linktext>."},"1202":{"name":"Blessing of Holy Sigil","description":"When using a Skill that consumes <style=\"accent-gn\">Holy Sigils</style>, <style=\"accent-gn\">20%</style> chance for your next <style=\"accent-gn\">Holy Sigil</style>-consuming skill to consume no <style=\"accent-gn\">Holy Sigils</style>. The effect lasts for <style=\"accent-gn\">8</style>s or until a <style=\"accent-gn\">Holy Sigil</style>-consuming skill is cast."},"1203":{"name":"Ring of Judgment","description":"Casting <linktext=1564><style=\"ItemQuality_5\">Judgment</style></linktext> generates a <linktext=1560><style=\"ItemQuality_5\">Divine Circle</style></linktext>, with a CD of <style=\"accent-gn\">30</style>s.<br><style=\"accent-gn\">Each</style> <style=\"accent-gn\">Holy Sigil</style> consumed reduces the remaining CD by <style=\"accent-gn\">1</style>s."},"1204":{"name":"Lightforge Continuum","description":"For every <style=\"accent-gn\">20</style> <style=\"accent-gn\">Photon Energy</style> consumed, gains <linktext=1172><style=\"ItemQuality_5\">Radiant Shield</style></linktext> equal to <style=\"accent-gn\">45%</style> ATK (this ratio is affected by Adventurer Level, up to <style=\"accent-gn\">90%</style>)."},"1205":{"name":"Haste Sigil","description":"Each <style=\"accent-gn\">1%</style> Haste increases the recovery speed of <style=\"accent-gn\">Holy Sigil</style> by <style=\"accent-gn\">1%</style>. Recovery time = Initial recovery time / (<style=\"accent-gn\">1</style> + recovery speed bonus)."},"1206":{"name":"Power Conversion","description":"Armor +7000<br><br>Every <style=\"accent-gn\">3</style> Strength grants <style=\"accent-gn\">3.6</style> Armor."},"1207":{"name":"Light of Condemn","description":"While inside a <linktext=1560><style=\"ItemQuality_5\">Divine Circle</style></linktext>, your <linktext=1598><style=\"ItemQuality_5\">Condemn</style></linktext> is enhanced, thrusting a blade of light forward and dealing double DMG."},"1208":{"name":"Recovery Spec","description":"Further enhances your ability to use <linktext=1561><style=\"ItemQuality_5\">Valor Bash</style></linktext>. <br><linktext=1561><style=\"ItemQuality_5\">Valor Bash</style></linktext> is accompanied by <linktext=1174><style=\"ItemQuality_5\">Radiant Impact</style></linktext>.<br><br><i><style=\"text_third_gray\"><size=20>Try to maintain the Armor bonus from Valor Bash, and trigger Inferno Reckon through high Crits to gain more Photon Energy. Sufficient Photon Energy means continuous self-healing under the blessing of Judgment and Scorching Judgment.</size></style></i>"},"1209":{"name":"Oracle","description":"When a skill that consumes <style=\"accent-gn\">Holy Sigil</style> critically hits, gain an additional <style=\"accent-gn\">30%</style> <style=\"accent-gn\">Photon Energy</style>. <br>Crit DMG of skills that consume <style=\"accent-gn\">Photon Energy</style> +<style=\"accent-gn\">30%</style>."},"1210":{"name":"Judgment Revelation","description":"When <linktext=1177><style=\"ItemQuality_5\">Divine Strike</style></linktext> Crits, there's a <style=\"accent-gn\">50%</style> fixed chance to automatically cast <linktext=1564><style=\"ItemQuality_5\">Judgment</style></linktext> on the target (this <linktext=1564><style=\"ItemQuality_5\">Judgment</style></linktext> cannot trigger <linktext=1177><style=\"ItemQuality_5\">Divine Strike</style></linktext>)."},"1211":{"name":"Divine Circle Defender","description":"While within the <linktext=1560><style=\"ItemQuality_5\">Divine Circle</style></linktext>, the Armor effect provided by <linktext=1561><style=\"ItemQuality_5\">Valor Bash</style></linktext> +<style=\"accent-gn\">30%</style>."},"1212":{"name":"Radiant Guard","description":"Casting <linktext=1562><style=\"ItemQuality_5\">Shield Toss</style></linktext> immediately grants a <linktext=1172><style=\"ItemQuality_5\">Radiant Shield</style></linktext> equal to <style=\"accent-gn\">55%</style> Armor (affected by Versatility and Element bonuses).<br>The charge count of <linktext=1562><style=\"ItemQuality_5\">Shield Toss</style></linktext> +<style=\"accent-gn\">1</style>."},"1213":{"name":"Aegis Ward's Anthem","description":"For every <style=\"accent-gn\">2</style> <style=\"accent-gn\">Holy Sigils</style> consumed, the remaining CD of <linktext=1565><style=\"ItemQuality_5\">Aegis Ward</style></linktext> -<style=\"accent-gn\">1</style> second."},"1214":{"name":"Fearless Shield","description":"Each time <linktext=1562><style=\"ItemQuality_5\">Shield Toss</style></linktext> deals DMG, gain a <linktext=1172><style=\"ItemQuality_5\">Radiant Shield</style></linktext> equal to <style=\"accent-gn\">13.75%</style> Armor (affected by Versatility and Element bonuses)."},"1215":{"name":"Aegis Ward's Retribution","description":"During <linktext=1565><style=\"ItemQuality_5\">Aegis Ward</style></linktext>, <linktext=1170><style=\"ItemQuality_5\">Block</style></linktext> chance is increased to <style=\"accent-gn\">1.5</style> times. <br>When attacked, reduces <linktext=1565><style=\"ItemQuality_5\">Aegis Ward</style></linktext>'s remaining CD by <style=\"accent-gn\">0.5s</style>. This effect can only trigger once <style=\"accent-gn\">per</style> second."},"1216":{"name":"Lightforged Greatsword","description":"After every <style=\"accent-gn\">10</style> casts of <linktext=1564><style=\"ItemQuality_5\">Judgment</style></linktext>, the next <linktext=1564><style=\"ItemQuality_5\">Judgment</style></linktext> is enhanced into <style=\"accent-gn\">Scorching Judgment</style>. <br><style=\"accent-gn\">Scorching Judgment</style>: Summon a holy greatsword to descend upon the target area for <style=\"accent-gn\">5s</style>, healing yourself (Healing equal to that of <linktext=1564><style=\"ItemQuality_5\">Judgment</style></linktext>) while dealing damage over time to nearby enemies and inflicting <style=\"accent-gn\">Scorch</style>, totally dealing <style=\"physical\">Attack DMG</style> equal to <style=\"accent-gn\">600%</style> ATK (scales with <linktext=1564><style=\"ItemQuality_5\">Judgment</style></linktext> level/rank). <br><style=\"accent-gn\">Scorch</style>: Reduces damage taken from the target by <style=\"accent-gn\">3%</style> for <style=\"accent-gn\">10s</style>. Stacks up to <style=\"accent-gn\">10</style> times. Grants <style=\"accent-gn\">3</style> stacks of <style=\"accent-gn\">Scorch</style> on Crit."},"1217":{"name":"Holy Barrier","description":"Using <style=\"accent-gn\">Ultimate Skill</style> creates a <style=\"accent-gn\">Holy Barrier</style>, shielding nearby allies from DMG. The <style=\"accent-gn\">Holy Barrier</style> lasts for <style=\"accent-gn\">15s</style> or until it absorbs Total DMG equal to <style=\"accent-gn\">150%</style> Max HP +<style=\"accent-gn\">3000%</style> Armor."},"1218":{"name":"Shield Spec","description":"Replaces Special Attack with <linktext=1566><style=\"ItemQuality_5\">Vanguard Strike</style></linktext> and enhances its power.<br><style=\"accent-gn\">Each</style> additional enemy hit by <linktext=1566><style=\"ItemQuality_5\">Vanguard Strike</style></linktext> grants <style=\"accent-gn\">2</style> extra Photon Energy, up to <style=\"accent-gn\">10</style>.<br>Successfully Block prevents losing the stacks of <style=\"accent-gn\">Lightforged Barrier</style>.<br><br><style=\"accent-gn\">Lightforged Barrier</style>: Each stack increases Max HP by <style=\"accent-gn\">2%</style>, up to <style=\"accent-gn\">10</style> stacks, with each instance of DMG removing <style=\"accent-gn\">1</style> stack. It lasts <style=\"accent-gn\">25s</style> or until all stacks are consumed. gaining stacks resets the duration.<br><br><i><style=\"text_third_gray\"><size=20>Managing Lightforged Barrier is crucial for sustaining high HP and triggering self-healing and DMG Reduction effects from Judgment, Zeal Crusade, and Radiance.</size></style></i>"},"1219":{"name":"Light Barrier","description":"<linktext=1175><style=\"ItemQuality_5\">Lightforged Barrier</style></linktext> cap +<style=\"accent-gn\">2</style>."},"1220":{"name":"Ascension of the Lightforged Barrier","description":"<style=\"accent-gn\">Photon Energy</style> cap +<style=\"accent-gn\">20</style>.<br>When you have at least <style=\"accent-gn\">5</style> stacks of <linktext=1175><style=\"ItemQuality_5\">Lightforged Barrier</style></linktext>, <linktext=1564><style=\"ItemQuality_5\">Judgment</style></linktext> consumes <style=\"accent-gn\">5</style> less <style=\"accent-gn\">Photon Energy</style>."},"1221":{"name":"Divine Circle Chant","description":"The recovery rate of <style=\"accent-gn\">Holy Sigils</style> from Haste +<style=\"accent-gn\">100%</style>."},"1222":{"name":"Holy Strike","description":"Each time <style=\"accent-gn\">1</style> stack of <linktext=1175><style=\"ItemQuality_5\">Lightforged Barrier</style></linktext> is consumed or deducted, <style=\"accent-gn\">10%</style> chance to obtain <style=\"accent-gn\">1</style> <style=\"accent-gn\">Holy Sigil</style>."},"1223":{"name":"Holy Radiance","description":"When <linktext=1559><style=\"ItemQuality_5\">Sacred Blade</style></linktext> hits an enemy target, it applies a <linktext=1199><style=\"ItemQuality_5\">Holy Mark</style></linktext> to the target.<br><linktext=1566><style=\"ItemQuality_5\">Vanguard Strike</style></linktext> can spread this <linktext=1199><style=\"ItemQuality_5\">Holy Mark</style></linktext> to hit enemy targets."},"1224":{"name":"Determination Slash","description":"When <linktext=1175><style=\"ItemQuality_5\">Lightforged Barrier</style></linktext> has <style=\"accent-gn\">5</style> or fewer stacks, taking DMG no longer reduces its stacks. When <linktext=1175><style=\"ItemQuality_5\">Lightforged Barrier</style></linktext> has more than <style=\"accent-gn\">5</style> stacks, taking DMG has a <style=\"accent-gn\">50%</style> fixed chance not to reduce its stacks."},"1225":{"name":"Lightforged Drive","description":"When casting <linktext=1568><style=\"ItemQuality_5\">Radiance</style></linktext>, it automatically releases <linktext=1564><style=\"ItemQuality_5\">Judgment</style></linktext> to up to <style=\"accent-gn\">5</style> nearby enemy targets."},"1226":{"name":"Ruthless Rewind","description":"During <linktext=1567><style=\"ItemQuality_5\">Zeal Crusade</style></linktext>, <style=\"accent-gn\">each</style> <style=\"accent-gn\">Holy Sigil</style> consumed grants <linktext=1567><style=\"ItemQuality_5\">Zeal Crusade</style></linktext> <style=\"accent-gn\">1</style> stack of charge. When the charge reaches <style=\"accent-gn\">3</style> stacks, <linktext=1567><style=\"ItemQuality_5\">Zeal Crusade</style></linktext> bursts outward, dealing DMG equal to <style=\"accent-gn\">6%</style> max HP."},"1227":{"name":"Divine Circle Resonance","description":"For <style=\"accent-gn\">each</style> enemy inside <linktext=1560><style=\"ItemQuality_5\">Divine Circle</style></linktext>, increases <linktext=1560><style=\"ItemQuality_5\">Divine Circle</style></linktext> DMG by <style=\"accent-gn\">25%</style> and <linktext=1560><style=\"ItemQuality_5\">Divine Circle</style></linktext> Healing by <style=\"accent-gn\">5%</style> (caps at <style=\"accent-gn\">10</style> enemies)."},"1228":{"name":"Judgment Pursuit","description":"Every <style=\"accent-gn\">50</style> times damage is taken, the next <linktext=1564><style=\"ItemQuality_5\">Judgment</style></linktext> deals additional fixed damage equal to <style=\"accent-gn\">200%</style> Max HP. Can trigger at most once every <style=\"accent-gn\">20</style>s. Every <style=\"accent-gn\">2%</style> of Mastery reduces the required times of damage taken by <style=\"accent-gn\">1</style>. Every <style=\"accent-gn\">1%</style> of Haste reduces the trigger interval by <style=\"accent-gn\">1%</style> (up to <style=\"accent-gn\">50%</style>)."},"1229":{"name":"Divine Circle Blessing","description":"While within the <linktext=1560><style=\"ItemQuality_5\">Divine Circle</style></linktext>, your Healing Received +<style=\"accent-gn\">10%</style>."},"1230":{"name":"Lightforged Balance","description":"When your HP percentage is higher than your target's, DMG taken from that target -<style=\"accent-gn\">5%</style>.<br>When your HP percentage is lower than your target's, <linktext=1564><style=\"ItemQuality_5\">Judgment</style></linktext> deals <style=\"accent-gn\">50%</style> more DMG."},"1231":{"name":"Lightforged Fortitude","description":"Throughout the duration of <linktext=1172><style=\"ItemQuality_5\">Radiant Shield</style></linktext>, <linktext=1170><style=\"ItemQuality_5\">Block</style></linktext> chance +<style=\"accent-gn\">10%</style>."},"1232":{"name":"Energy Guard","description":"After casting an <style=\"accent-gn\">Ultimate</style>, all allies' Max HP is increased by <style=\"accent-gn\">10%</style> for <style=\"accent-gn\">10s</style> (this effect does not stack)."},"1233":{"name":"Life Enhancement","description":"When <style=\"accent-gn\">Strength</style> reaches <style=\"accent-gn\">500</style> points, Max HP +<style=\"accent-gn\">12%</style>."},"1234":{"name":"Condemn Time Limit","description":"When <linktext=1598><style=\"ItemQuality_5\">Condemn</style></linktext> deals damage, it immediately cools down <style=\"accent-gn\">1</style> <style=\"accent-gn\">Holy Sigil</style> (prioritizing the <style=\"accent-gn\">Holy Sigil</style> with the longest remaining CD)."},"1235":{"name":"Sword Dance","description":"When a <style=\"accent-gn\">Expertise Skill</style> critically heals, gain a <style=\"accent-gn\">15%</style> healing bonus."},"1236":{"name":"Shield Impact","description":"Hold <linktext=1561><style=\"ItemQuality_5\">Valor Bash</style></linktext> to charge, then dash forward a short distance."},"1237":{"name":"Reckon Shield","description":"Each time <linktext=1600><style=\"ItemQuality_5\">Inferno Reckon</style></linktext> or <linktext=1563><style=\"ItemQuality_5\">Reckoning</style></linktext> deals Crit DMG to <style=\"accent-gn\">1</style> enemy target, <linktext=1170><style=\"ItemQuality_5\">Block</style></linktext> chance +<style=\"accent-gn\">5%</style>, lasting for <style=\"accent-gn\">10s</style>, stacking up to <style=\"accent-gn\">5</style> times."},"1238":{"name":"Holy Light Time Limit","description":"During <linktext=1565><style=\"ItemQuality_5\">Aegis Ward</style></linktext>, when an <style=\"accent-gn\">Expertise Skill</style> deals Crit DMG, there's a <style=\"accent-gn\">50%</style> fixed chance to instantly reset <style=\"accent-gn\">1</style> <style=\"accent-gn\">Holy Sigil</style> CD (prioritizing <style=\"accent-gn\">Holy Sigil</style> with the longest remaining CD). This effect triggers only once when multiple targets are hit."},"1239":{"name":"Holy Summon","description":"When <linktext=1562><style=\"ItemQuality_5\">Shield Toss</style></linktext> or <linktext=1564><style=\"ItemQuality_5\">Judgment</style></linktext> deals DMG, <style=\"accent-gn\">10%</style> chance to trigger <linktext=1177><style=\"ItemQuality_5\">Divine Strike</style></linktext>. If Crit DMG is dealt, the chance increases to <style=\"accent-gn\">50%</style>."},"1240":{"name":"Light Chain","description":"While <linktext=1565><style=\"ItemQuality_5\">Aegis Ward</style></linktext> is active, the chance of <linktext=1177><style=\"ItemQuality_5\">Divine Strike</style></linktext> is doubled.<br>Every <style=\"accent-gn\">3</style> times <linktext=1177><style=\"ItemQuality_5\">Divine Strike</style></linktext> is triggered, the duration of <linktext=1565><style=\"ItemQuality_5\">Aegis Ward</style></linktext> is extended by <style=\"accent-gn\">1</style> second."},"1241":{"name":"Reckon Blaze","description":"When <linktext=1561><style=\"ItemQuality_5\">Valor Bash</style></linktext> deals Crit DMG, gain <style=\"accent-gn\">Blazing</style>.<br>Casting <linktext=1565><style=\"ItemQuality_5\">Aegis Ward</style></linktext> guarantees <style=\"accent-gn\">Blazing</style>.<br><style=\"accent-gn\">Scorching Heat</style>: For the next <style=\"accent-gn\">10s</style>, <linktext=1563><style=\"ItemQuality_5\">Reckoning</style></linktext> evolves into <linktext=1600><style=\"ItemQuality_5\">Inferno Reckon</style></linktext>."},"1242":{"name":"Holy Heal","description":"While having <linktext=1172><style=\"ItemQuality_5\">Radiant Shield</style></linktext>, gains <style=\"accent-gn\">12%</style> healing bonus."},"1243":{"name":"Light Protection","description":"While having <linktext=1172><style=\"ItemQuality_5\">Radiant Shield</style></linktext>, gain <style=\"accent-gn\">5%</style> Light bonus."},"1244":{"name":"Ultimate Guard","description":"For <style=\"accent-gn\">10s</style> after casting <linktext=1562><style=\"ItemQuality_5\">Shield Toss</style></linktext>, increases <linktext=1170><style=\"ItemQuality_5\">Block Chance</style></linktext> by <style=\"accent-gn\">15%</style>."},"1245":{"name":"Shield Guard","description":"<linktext=1561><style=\"ItemQuality_5\">Valor Bash</style></linktext> heals for <style=\"accent-gn\">120%</style> ATK when it deals DMG, and increases DMG dealt by <style=\"accent-gn\">8%</style> for <style=\"accent-gn\">8s</style>."},"1246":{"name":"Radiant Heal","description":"Increases <linktext=1564><style=\"ItemQuality_5\">Judgment</style></linktext> Healing by <style=\"accent-gn\">25%</style>."},"1247":{"name":"Ultimate Strike","description":"When <linktext=1177><style=\"ItemQuality_5\">Divine Strike</style></linktext> deals DMG, increases <style=\"accent-gn\">Strength</style> by <style=\"accent-gn\">2%</style> for <style=\"accent-gn\">10s</style>, stacking up to <style=\"accent-gn\">5</style> times."},"1248":{"name":"Magic Guard","description":"While <linktext=1565><style=\"ItemQuality_5\">Aegis Ward</style></linktext> is active, each <style=\"accent-gn\">1%</style> Mastery grants <style=\"accent-gn\">0.5%</style> MATK Reduction, up to <style=\"accent-gn\">30%</style>."},"1249":{"name":"Ultimate Conquest","description":"Increases <linktext=1567><style=\"ItemQuality_5\">Zeal Crusade</style></linktext> DMG by <style=\"accent-gn\">50%</style>."},"1250":{"name":"Light's Crit","description":"Crit +500"},"1251":{"name":"Adversity Enhancement","description":"<style=\"accent-gn\">Special Attack</style> and damaging <style=\"accent-gn\">Expertise</style> are enhanced based on missing HP. For every <style=\"accent-gn\">1%</style> HP lost, increases their DMG by <style=\"accent-gn\">1%</style>."},"1252":{"name":"Wide Raid","description":"Increases <linktext=1567><style=\"ItemQuality_5\">Zeal Crusade</style></linktext> range by <style=\"accent-gn\">100%</style>. While <br><linktext=1567><style=\"ItemQuality_5\">Zeal Crusade</style></linktext> is active, the effect of <style=\"accent-gn\">Bold Fearless</style> is doubled."},"1253":{"name":"Bold Fearless","description":"When <linktext=1559><style=\"ItemQuality_5\">Sacred Blade</style></linktext> or <linktext=1564><style=\"ItemQuality_5\">Judgment</style></linktext> deals DMG, there is a fixed <style=\"accent-gn\">25%</style> chance to cause <linktext=1566><style=\"ItemQuality_5\">Vanguard Strike</style></linktext> to evolve into <linktext=1176><style=\"ItemQuality_5\">Vanguard Hunt</style></linktext>. <br><linktext=1176><style=\"ItemQuality_5\">Vanguard Hunt</style></linktext>: Deals <style=\"physical\">Attack DMG</style> equal to <style=\"accent-gn\">240%</style> ATK to the target, restores <style=\"accent-gn\">2%</style> of your max HP, and gains <style=\"accent-gn\">Bold Fearless</style>. <br><style=\"accent-gn\">Bold Fearless</style>: Increases Haste by <style=\"accent-gn\">3%</style> for <style=\"accent-gn\">10s</style>, stacking up to <style=\"accent-gn\">10</style> times."},"1254":{"name":"Radiant Core","description":"<linktext=1176><style=\"ItemQuality_5\">Vanguard Hunt</style></linktext> can grant <linktext=1198><style=\"ItemQuality_5\">Radiant Core</style></linktext>.<br>Gaining <linktext=1198><style=\"ItemQuality_5\">Radiant Core</style></linktext> again reduces its burst time by <style=\"accent-gn\">2s</style>."},"1255":{"name":"Conquest Pursuit","description":"While <linktext=1567><style=\"ItemQuality_5\">Zeal Crusade</style></linktext> is active, <linktext=1566><style=\"ItemQuality_5\">Vanguard Strike</style></linktext> evolves into <linktext=1176><style=\"ItemQuality_5\">Vanguard Hunt</style></linktext>."},"1256":{"name":"Decisive Blade","description":"After <linktext=1198><style=\"ItemQuality_5\">Radiant Core</style></linktext> explosion, <linktext=1559><style=\"ItemQuality_5\">Sacred Blade</style></linktext> DMG +<style=\"accent-gn\">100%</style> for <style=\"accent-gn\">20s</style>. Holds up to <style=\"accent-gn\">3</style> charges, casting <linktext=1559><style=\"ItemQuality_5\">Sacred Blade</style></linktext> consumes one charge."},"1257":{"name":"Zeal Haste","description":"For every <style=\"accent-gn\">15</style> points of <style=\"accent-gn\">Photon Energy</style> consumed, the remaining CD of <linktext=1567><style=\"ItemQuality_5\">Zeal Crusade</style></linktext> -<style=\"accent-gn\">1</style> second."},"1258":{"name":"Holy Sigil Enhancement","description":"When <linktext=1564><style=\"ItemQuality_5\">Judgment</style></linktext> deals DMG, the target takes double DMG from <linktext=1199><style=\"ItemQuality_5\">Holy Mark</style></linktext> for the next <style=\"accent-gn\">5s</style>."},"1259":{"name":"Divine Guard","description":"When in the <linktext=1560><style=\"ItemQuality_5\">Divine Circle</style></linktext>, reduces all DMG taken by <style=\"accent-gn\">10%</style>.<br>For <style=\"accent-gn\">each</style> enemy within <style=\"accent-gn\">10m</style>, ATK Reduction increases by <style=\"accent-gn\">1.5%</style> (up to <style=\"accent-gn\">9%</style>), and MATK Reduction increases by <style=\"accent-gn\">0.75%</style> (up to <style=\"accent-gn\">4.5%</style>)."},"1260":{"name":"Judgment Improvement","description":"For each <style=\"accent-gn\">1</style> stack of <linktext=1175><style=\"ItemQuality_5\">Lightforged Barrier</style></linktext> you possess, <linktext=1564><style=\"ItemQuality_5\">Judgment</style></linktext> gains <style=\"accent-gn\">2%</style> healing bonus. When <linktext=1175><style=\"ItemQuality_5\">Lightforged Barrier</style></linktext>≥<style=\"accent-gn\">5</style> stacks, DMG Reduction +<style=\"accent-gn\">8%</style>."},"1261":{"name":"Sigil Pursuit","description":"DMG dealt by <linktext=1176><style=\"ItemQuality_5\">Vanguard Hunt</style></linktext> and <linktext=1559><style=\"ItemQuality_5\">Sacred Blade</style></linktext> to targets with <linktext=1199><style=\"ItemQuality_5\">Holy Mark</style></linktext> increases by <style=\"accent-gn\">20%</style>."},"1262":{"name":"Overflow Healwall","description":"When your accumulated overhealing reaches <style=\"accent-gn\">10%</style> of your Max HP, gains <style=\"accent-gn\">1</style> stack of <linktext=1175><style=\"ItemQuality_5\">Lightforged Barrier</style></linktext>."},"1263":{"name":"Light Healing","description":"While having <linktext=1172><style=\"ItemQuality_5\">Radiant Shield</style></linktext>, gains <style=\"accent-gn\">12%</style> healing bonus."},"1264":{"name":"Light Protection","description":"While having <linktext=1172><style=\"ItemQuality_5\">Radiant shield</style></linktext>, gain <style=\"accent-gn\">5%</style> Light bonus."},"1265":{"name":"Resolved to Return","description":"Each time <style=\"accent-gn\">1</style> stack of <linktext=1175><style=\"ItemQuality_5\">Lightforged Barrier</style></linktext> is consumed or deducted, reduces the remaining CD of <linktext=1568><style=\"ItemQuality_5\">Radiance</style></linktext> by <style=\"accent-gn\">1</style> second."},"1266":{"name":"Halo","description":"<linktext=1560><style=\"ItemQuality_5\">Divine Circle</style></linktext> now has a halo effect, <linktext=3005><style=\"ItemQuality_5\">stunning</style></linktext> enemy targets for <style=\"accent-gn\">3s</style> the first time it deals DMG."},"1267":{"name":"Judgment Pursuit","description":"Every <style=\"accent-gn\">50</style> times damage is taken, the next <linktext=1564><style=\"ItemQuality_5\">Judgment</style></linktext> deals additional fixed damage equal to <style=\"accent-gn\">5000%</style> of Armor. Can trigger at most once every <style=\"accent-gn\">20</style>s. Every <style=\"accent-gn\">2%</style> Mastery reduces the required times of damage taken by <style=\"accent-gn\">1</style>. Every <style=\"accent-gn\">1%</style> Crit reduces the trigger interval by <style=\"accent-gn\">1%</style> (up to <style=\"accent-gn\">50%</style>)."},"1300":{"name":"Passion Surge","description":"When <linktext=1133><style=\"ItemQuality_5\">Melody</style></linktext> is active, there is a <style=\"accent-gn\">15%</style> fixed chance per second to gain <style=\"accent-gn\">Passion Surge</style>. <br><br><style=\"accent-gn\">Passion Surge</style>: <style=\"accent-gn\">Special Attack</style> costs zero <style=\"accent-gn\">Performance Passion</style> for <style=\"accent-gn\">10s</style>. Removed after <style=\"accent-gn\">Special Attack</style> is cast."},"1301":{"name":"String Expansion","description":"<style=\"accent-gn\">Performance Passion</style> max limit +<style=\"accent-gn\">1</style>."},"1302":{"name":"Heat Surge","description":"When <linktext=1133><style=\"ItemQuality_5\">Melody</style></linktext> is activated, the trigger chance for <style=\"accent-gn\">Passion Surge</style> +an extra <style=\"accent-gn\">3%</style> every <style=\"accent-gn\">1</style> second (up to <style=\"accent-gn\">30%</style>). <br><br><style=\"accent-gn\">Passion Surge</style>: <style=\"accent-gn\">Special Attack</style> costs zero <style=\"accent-gn\">Performance Passion</style> for <style=\"accent-gn\">10s</style>. Removed after <style=\"accent-gn\">Special Attack</style> is cast."},"1303":{"name":"Intellect Conversion","description":"Every <style=\"accent-gn\">10</style> points of Intellect provides <style=\"accent-gn\">1</style> point of MATK."},"1304":{"name":"Arcane Ascension","description":"<style=\"accent-gn\">Special Attack</style> costs <style=\"accent-gn\">1</style> less <style=\"accent-gn\">Performance Passion</style>."},"1305":{"name":"Melody: Heat Core","description":"<linktext=1133><style=\"ItemQuality_5\">Melody</style></linktext> heals ally targets below <style=\"accent-gn\">50%</style> HP with <style=\"accent-gn\">100%</style> bonus effect."},"1306":{"name":"Flame Pursuit","description":"After using <style=\"accent-gn\">3</style> <style=\"accent-gn\">Special Attack</style>s, the next <style=\"accent-gn\">Basic Attack</style> hit triggers <linktext=1190><style=\"ItemQuality_5\">Flame Pillar Blast</style></linktext>."},"1307":{"name":"Flame Pursuit II","description":"<linktext=1190><style=\"ItemQuality_5\">Flame Pillar Blast</style></linktext> becomes a two-hit combo."},"1308":{"name":"Dissonance Spec","description":"While in <linktext=1603><style=\"ItemQuality_5\">Rhapsody of Flame</style></linktext>, increases all Luck Chance acquired by any means by <style=\"accent-gn\">50%</style> and increases DMG Reduction by <style=\"accent-gn\">25%</style>.<br><br><style=\"accent-gn\">Healing of Stillness</style>: If you deal no DMG to enemies for <style=\"accent-gn\">5s</style>, each hit of your <style=\"accent-gn\">Basic Attack</style> will heal up to <style=\"accent-gn\">10</style> allies (party members prioritized), with the full 4-hit combo restoring <style=\"accent-gn\">15.75%</style> of their max HP in total. After casting an Ultimate, Basic Attacks immediately start healing, and <linktext=1615><style=\"ItemQuality_5\">Fierce Strike</style></linktext> can trigger the 4th hit healing effect, but this is disabled upon dealing DMG to enemies.<br><br><i><style=\"text_third_gray\"><size=20>Maintaining Heroic Melody and Rhapsody of Flame is crucial. Heroic Melody enhances healing while consecutive Fierce Strikes accelerate Harmonic Anthem casting frequency.</size></style></i>"},"1309":{"name":"Lucky Soundwave","description":"Gains <style=\"accent-gn\">1</style> <style=\"accent-gn\">Soundwave Energy</style> whenever <style=\"accent-gn\">Expertise Skill</style>s or <linktext=1604><style=\"ItemQuality_5\">Amplified Beat</style></linktext> trigger a Lucky Strike."},"1310":{"name":"Trio Rhapsody","description":"<linktext=1603><style=\"ItemQuality_5\">Rhapsody of Flame</style></linktext> always appears in its most powerful form.<br>While in <linktext=1603><style=\"ItemQuality_5\">Rhapsody of Flame</style></linktext>, ATK increases by <style=\"accent-gn\">Haste % x 0.6</style>."},"1311":{"name":"Severed Chapter","description":"Increases Resilience Break Efficiency of self and Allies within <style=\"accent-gn\">30</style> meters by <style=\"accent-gn\">10%</style>. This effect cannot stack. <br>After activating <linktext=1614><style=\"ItemQuality_5\">Heroic Melody</style></linktext>, you and Allies within <style=\"accent-gn\">30</style> meters have an resilience break efficiency +<style=\"accent-gn\">30%</style> and deal <style=\"accent-gn\">15%</style> more DMG to Resilience Broken targets. This effect cannot stack."},"1312":{"name":"Sound Blaze","description":"Gain <style=\"accent-gn\">1</style> <style=\"accent-gn\">Soundwave Energy</style> each time you deal DMG equal to <style=\"accent-gn\">10</style> times ATK. <br><style=\"accent-gn\">Soundwave Energy</style> stores up to <style=\"accent-gn\">50</style>. <br>Skills consuming <style=\"accent-gn\">Performance Passion</style> trigger <linktext=1191><style=\"ItemQuality_5\">Scorching Impact</style></linktext> when dealing DMG, consuming all <style=\"accent-gn\">Soundwave Energy</style>. Each <style=\"accent-gn\">1</style> <style=\"accent-gn\">Soundwave Energy</style> increases <linktext=1191><style=\"ItemQuality_5\">Scorching Impact</style></linktext> DMG by <style=\"accent-gn\">16%</style>."},"1313":{"name":"Healing Note","description":"<style=\"accent-gn\">Basic Attack</style> deals an extra instance of DMG. <br>For every <style=\"accent-gn\">5</style> <style=\"accent-gn\">Soundwave Energy</style> obtained, creates a <linktext=1192><style=\"ItemQuality_5\">Note</style></linktext> for the ally with the lowest HP."},"1314":{"name":"Blazing Heal","description":"Stores excess Healing (up to <style=\"accent-gn\">500%</style> of Max HP). After activating <linktext=1614><style=\"ItemQuality_5\">Heroic Melody</style></linktext>, consumes stored Healing to recover allies' HP every <style=\"accent-gn\">1</style> second, up to <style=\"accent-gn\">15%</style> of Max HP per second."},"1315":{"name":"Concerto","description":"During <linktext=1603><style=\"ItemQuality_5\">Rhapsody of Flame</style></linktext>, <linktext=1604><style=\"ItemQuality_5\">Amplified Beat</style></linktext> gains <style=\"accent-gn\">1</style> additional attack.<br><linktext=1604><style=\"ItemQuality_5\">Amplified Beat</style></linktext>'s DMG -<style=\"accent-gn\">20%</style>."},"1316":{"name":"Restart","description":"When <linktext=1605><style=\"ItemQuality_5\">Harmonic Anthem</style></linktext> or <linktext=1615><style=\"ItemQuality_5\">Fierce Strike</style></linktext> triggers a Lucky Strike, limited to a single activation when striking multiple targets, immediately resets <linktext=1603><style=\"ItemQuality_5\">Rhapsody of Flame</style></linktext>'s CD and allows <linktext=1603><style=\"ItemQuality_5\">Rhapsody of Flame</style></linktext> not to consume <style=\"accent-gn\">Performance Passion</style> for <style=\"accent-gn\">10s</style>, this effect is nullified upon casting <linktext=1603><style=\"ItemQuality_5\">Rhapsody of Flame</style></linktext>."},"1317":{"name":"Concerto Spec","description":"Replaces <style=\"accent-gn\">Special Attack</style> with <linktext=1609><style=\"ItemQuality_5\">Healing Beat</style></linktext>. While<br><linktext=1606><style=\"ItemQuality_5\">Healing Melody</style></linktext> is active, reduces the remaining CD of <linktext=1607><style=\"ItemQuality_5\">Fivefold Crescendo</style></linktext> and <linktext=1608><style=\"ItemQuality_5\">Passion Burst</style></linktext> by <style=\"accent-gn\">1</style> second <style=\"accent-gn\">per</style> second. <br><br><i><style=\"text_third_gray\"><size=20>Precisely placing the speaker ensures it echoes your Expertise whenever they are cast.</size></style></i>"},"1318":{"name":"Brilliant Charge","description":"When <linktext=1609><style=\"ItemQuality_5\">Healing Beat</style></linktext> or <linktext=1608><style=\"ItemQuality_5\">Passion Burst</style></linktext> applies Crit Healing or deals Crit DMG (triggers only once when hitting multiple targets), gains <style=\"accent-gn\">1</style> <style=\"accent-gn\">Performance Passion</style>."},"1319":{"name":"Double Recovery Note","description":"<linktext=1609><style=\"ItemQuality_5\">Healing Beat</style></linktext> provides an additional equal Healing to targets under the influence of <linktext=1606><style=\"ItemQuality_5\">Healing Melody</style></linktext>."},"1320":{"name":"Crit Healing","description":"Increases Crit Healing by <style=\"accent-gn\">25%</style>."},"1321":{"name":"Fiery Beat","description":"<linktext=1609><style=\"ItemQuality_5\">Healing Beat</style></linktext> Crit Rate +<style=\"accent-gn\">10%</style>. <br><linktext=1609><style=\"ItemQuality_5\">Healing Beat</style> </linktext>Healing +<style=\"accent-gn\">10%</style>."},"1322":{"name":"Critical Encore","description":"Every <style=\"accent-gn\">1%</style> Crit Rate grants <style=\"accent-gn\">1%</style> trigger chance for <linktext=1193><style=\"ItemQuality_5\">Encore Strings</style></linktext>."},"1323":{"name":"Passion Fury","description":"For each <style=\"accent-gn\">10</style> <style=\"accent-gn\">Performance Passion</style> consumed, enhances <linktext=1608><style=\"ItemQuality_5\">Passion Burst</style></linktext> to <linktext=1617><style=\"ItemQuality_5\">Passion Fury</style></linktext> for <style=\"accent-gn\">10s</style>."},"1324":{"name":"Stat Resonance","description":"While <linktext=1606><style=\"ItemQuality_5\">Healing Melody</style></linktext> is active, grants allies appropriate buffs (<style=\"accent-gn\">Strength</style>, <style=\"accent-gn\">Intellect</style>, <style=\"accent-gn\">Agility</style>) equal to <style=\"accent-gn\">8%</style> of <style=\"accent-gn\">Intellect</style>. (Buffs from different Beat Performers cannot stack. Only one with the highest value applies.)"},"1325":{"name":"Stat Resonance Crit","description":"For <style=\"accent-gn\">10s</style></linktext> after using <linktext=1608><style=\"ItemQuality_5\">Passion Burst</style></linktext> or its enhanced form (<linktext=1617><style=\"ItemQuality_5\">Passion Fury</style>), doubles the buffs that <linktext=1606><style=\"ItemQuality_5\">Healing Melody</style></linktext> provides to allies. While channeling <linktext=1617><style=\"ItemQuality_5\">Passion Fury</style></linktext>, DMG Reduction +<style=\"accent-gn\">10%</style>. The duration of the doubled stat buffs is refreshed and extended by <style=\"accent-gn\">0.4</style>s for every <style=\"accent-gn\">0.2</style>s channeled."},"1326":{"name":"Fire Day","description":"Increases Fire Bonus by <style=\"accent-gn\">8%</style> when attacking Elite or higher targets."},"1327":{"name":"Critical Acclaim","description":"During <linktext=1610><style=\"ItemQuality_5\">Center Stage</style></linktext>, triggering <linktext=1193><style=\"ItemQuality_5\">Encore Strings</style></linktext> has a <style=\"accent-gn\">30%</style> fixed chance to grant <style=\"accent-gn\">Passion Surge</style>. <br><br><style=\"accent-gn\">Passion Surge</style>: <style=\"accent-gn\">Special Attack</style> costs zero <style=\"accent-gn\">Performance Passion</style> for <style=\"accent-gn\">10s</style>. Removed after <style=\"accent-gn\">Special Attack</style> is cast."},"1328":{"name":"Rhythm Spirit","description":"Defeating an enemy has a fixed <style=\"accent-gn\">50%</style> chance to grant you <style=\"accent-gn\">1</style> <style=\"accent-gn\">Performance Passion</style>."},"1329":{"name":"Infinite Rhapsody","description":"Replace <style=\"accent-gn\">Ultimate </style><linktext=1579><style=\"ItemQuality_5\">Rock the Stage</style></linktext> with <linktext=1612><style=\"ItemQuality_5\">Infinite Rhapsody</style></linktext>."},"1330":{"name":"Concert Circuit","description":"Replace <style=\"accent-gn\">Ultimate</style> <linktext=1579><style=\"ItemQuality_5\">Rock the Stage</style></linktext> with <linktext=1613><style=\"ItemQuality_5\">Concert Circuit</style></linktext>."},"1331":{"name":"Encore Chain","description":"When <linktext=1193><style=\"ItemQuality_5\">Encore Strings</style></linktext> triggers, it activates a second time on the same target."},"1332":{"name":"Heat Boost","description":"When <style=\"accent-gn\">Intellect</style> reaches <style=\"accent-gn\">500</style>, the <style=\"accent-gn\">Performance Energy</style> cap +<style=\"accent-gn\">20%</style>."},"1333":{"name":"Variation","description":"Increases Max HP by <style=\"accent-gn\">20%</style> and activates <style=\"accent-gn\">Dissonance Spec</style> with its original effect intact. <br>If Concerto Spec is activated, its effect is adjusted to replace <style=\"accent-gn\">Basic Attack</style> with <linktext=1618><style=\"ItemQuality_5\">Resonant Strings</style></linktext>."},"1334":{"name":"Melody Chord","description":"<linktext=1133><style=\"ItemQuality_5\">Melody</style></linktext> Healing +<style=\"accent-gn\">20%</style>. <br>Each <style=\"accent-gn\">1%</style> Haste increases the REG SPD of <style=\"accent-gn\">Performance Passion</style> by <style=\"accent-gn\">1%</style>."},"1335":{"name":"Exaltation","description":"<style=\"accent-gn\">Performance Energy</style> REG SPD +<style=\"accent-gn\">10%</style>."},"1336":{"name":"Indomitable Chord","description":"While <linktext=1614><style=\"ItemQuality_5\">Heroic Melody</style></linktext> is active, grants <linktext=1102><style=\"ItemQuality_5\">Super Armor</style></linktext>, increases DMG Reduction by <style=\"accent-gn\">25%</style>, and boosts Movement Speed by <style=\"accent-gn\">10%</style>.<br><linktext=1614>While <style=\"ItemQuality_5\">Heroic Melody</style></linktext> is active, grants Tenacity Chord. Each stack of Tenacity Chord additionally increases Max HP by <style=\"accent-gn\">0.5%</style> (up to <style=\"accent-gn\">2.5%</style> Max HP) for <style=\"accent-gn\">5</style>s (duration cannot be refreshed once <style=\"accent-gn\">5</style> stacks are reached)."},"1337":{"name":"Swing Reflux","description":"Hitting a target with <linktext=1615><style=\"ItemQuality_5\">Fierce Strike</style></linktext> recovers <style=\"accent-gn\">5</style> <style=\"accent-gn\">Performance Energy</style>. <style=\"accent-gn\">Each</style> additional target hit provides <style=\"accent-gn\">1</style> extra <style=\"accent-gn\">Performance Energy</style>, up to <style=\"accent-gn\">10</style> total."},"1338":{"name":"Luck Multiplier","description":"Every <style=\"accent-gn\">1%</style> Luck grants <style=\"accent-gn\">0.5%</style> Lucky Strike DMG Multiplier. <br>After activating <linktext=1614><style=\"ItemQuality_5\">Heroic Melody</style></linktext>, doubles its conversion efficiency."},"1339":{"name":"Resonant Counterpoint","description":"When a <linktext=1192><style=\"ItemQuality_5\">Note</style></linktext> forms, there's a <style=\"accent-gn\">50%</style> fixed chance to create an extra <linktext=1192><style=\"ItemQuality_5\">Note</style></linktext> for a different target."},"1340":{"name":"Sonic Cure","description":"When <style=\"accent-gn\">Expertise</style> deal DMG (only triggers once when hitting multiple targets), additionally heal targets with <linktext=1192><style=\"ItemQuality_5\">Note</style></linktext>."},"1341":{"name":"Sonic Therapy","description":"Converted healing from DMG +<style=\"accent-gn\">20%</style> for targets affected by <linktext=1192><style=\"ItemQuality_5\">Note</style></linktext>."},"1342":{"name":"Flame's Rampage","description":"When <linktext=1614><style=\"ItemQuality_5\">Heroic Melody</style></linktext> is active, <linktext=1603><style=\"ItemQuality_5\">Rhapsody of Flame</style></linktext> will erupt, dealing <style=\"magic\">Magic DMG</style> equal to <style=\"accent-gn\">350%</style> ATK every <style=\"accent-gn\">3s</style> to targets it touches (DMG interval affected by Haste). This DMG can trigger Lucky Strike.<br>While in <linktext=1603><style=\"ItemQuality_5\">Rhapsody of Flame</style></linktext>, each hit of <linktext=1605><style=\"ItemQuality_5\">Harmonic Anthem</style></linktext> also heals <style=\"accent-gn\">1</style> ally with the lowest HP for <style=\"accent-gn\">30%</style> of the DMG dealt (this value scales proportionally when hitting multiple targets)."},"1343":{"name":"Flame Note","description":"When you use an <style=\"accent-gn\">Expertise Skill</style>, <linktext=1603><style=\"ItemQuality_5\">Rhapsody of Flame</style></linktext> will erupt with Rhythm, dealing <style=\"magic\">Magic DMG</style> equal to <style=\"accent-gn\">700%</style> of ATK and granting <linktext=1192><style=\"ItemQuality_5\">Note</style></linktext> to allies it touches."},"1344":{"name":"Finale Command","description":"Within <style=\"accent-gn\">10s</style> of casting <linktext=1616><style=\"ItemQuality_5\">Encore</style></linktext>, each use of <linktext=1603><style=\"ItemQuality_5\">Rhapsody of Flame</style></linktext> caused targets affected by <linktext=1616><style=\"ItemQuality_5\">Encore</style></linktext> to trigger <linktext=1193><style=\"ItemQuality_5\">Encore Strings</style></linktext>."},"1345":{"name":"Encore Persistence","description":"Permanently benefits from <linktext=1616><style=\"ItemQuality_5\">Encore</style></linktext> effect. <br>For every <style=\"accent-gn\">5</style> triggers of <linktext=1193><style=\"ItemQuality_5\">Encore Strings</style></linktext>, the next <linktext=1604><style=\"ItemQuality_5\">Amplified Beat</style></linktext> and <linktext=1605><style=\"ItemQuality_5\">Harmonic Anthem</style></linktext> deal <style=\"accent-gn\">50%</style> more DMG."},"1346":{"name":"Encore Luck Boost","description":"Every <style=\"accent-gn\">1%</style> Luck Chance grants <style=\"accent-gn\">1%</style> trigger chance for <linktext=1193><style=\"ItemQuality_5\">Encore Strings</style></linktext>."},"1347":{"name":"Encore Sharp Strike","description":"Triggering <linktext=1193><style=\"ItemQuality_5\">Encore Strings</style></linktext> to deal DMG or healing grants <style=\"accent-gn\">2</style> <style=\"accent-gn\">Performance Energy</style>. If the <linktext=1193><style=\"ItemQuality_5\">Encore Strings</style></linktext> triggers Lucky Strike, grants <style=\"accent-gn\">3</style> additional <style=\"accent-gn\">Performance Energy</style>."},"1348":{"name":"Absolute Center Stage","description":"After you use <linktext=1610><style=\"ItemQuality_5\">Center Stage</style></linktext>, the number of enhanced skills increases from <style=\"accent-gn\">1</style> to <style=\"accent-gn\">2</style>."},"1349":{"name":"Center Stage: Mad Tune","description":"<style=\"accent-gn\">Each</style> <style=\"accent-gn\">Performance Passion</style> consumed reduces the CD of <linktext=1610><style=\"ItemQuality_5\">Center Stage</style></linktext> by <style=\"accent-gn\">1</style> second."},"1350":{"name":"Tower Multiwave","description":"Casting <linktext=1610><style=\"ItemQuality_5\">Center Stage</style></linktext> immediately extends <linktext=1614><style=\"ItemQuality_5\">Heroic Melody</style></linktext> by <style=\"accent-gn\">5s</style>."},"1351":{"name":"Soundwave Overclock","description":"Upon casting <linktext=1610><style=\"ItemQuality_5\">Center Stage</style></linktext>, grants <style=\"accent-gn\">15</style> <style=\"accent-gn\">Soundwave Energy</style>, and doubles all the <style=\"accent-gn\">Soundwave Energy</style> gained in the next <style=\"accent-gn\">10s</style>."},"1352":{"name":"Crit Charge Rhythm","description":"<linktext=1607><style=\"ItemQuality_5\">Fivefold Crescendo</style></linktext> deals Crit DMG or healing (only triggers once for multiple targets), grants <style=\"accent-gn\">2</style> <style=\"accent-gn\">Performance Energy</style>. When <br><linktext=1606><style=\"ItemQuality_5\">Healing Melody</style></linktext> lands a Crit Hit, grants <style=\"accent-gn\">1</style> <style=\"accent-gn\">Performance Energy</style>(only triggers once for multiple targets)."},"1353":{"name":"Tower Flame Blast","description":"The speaker releases a <linktext=1197><style=\"ItemQuality_5\">Flame Shock</style></linktext> every <style=\"accent-gn\">5s</style>."},"1354":{"name":"Multi-Target Heat Amp","description":"<linktext=1608><style=\"ItemQuality_5\">Passion Burst</style></linktext> and its enhanced version (<linktext=1617><style=\"ItemQuality_5\">Passion Fury</style></linktext>) deal <style=\"accent-gn\">5%</style> more DMG <style=\"accent-gn\">per</style> additional target hit, up to <style=\"accent-gn\">25%</style>."},"1355":{"name":"Heated Tower Flame Blast","description":"When <linktext=1608><style=\"ItemQuality_5\">Passion Burst</style></linktext> and its enhanced version (<linktext=1617><style=\"ItemQuality_5\">Passion Fury</style></linktext>) hit the speaker, it immediately releases a <linktext=1197><style=\"ItemQuality_5\">Flame Shock</style></linktext>."},"1356":{"name":"Sonic Verdict","description":"While <linktext=1606><style=\"ItemQuality_5\">Healing Melody</style></linktext> is active, <linktext=1607><style=\"ItemQuality_5\">Fivefold Crescendo</style></linktext> also deals DMG, with its total DMG scaling equal to its healing multiplier.<br><linktext=1606><style=\"ItemQuality_5\">While Healing Melody</style></linktext> is active, reduces the caster's DMG taken by <style=\"accent-gn\">(10% + Haste % x 0.4) (max -30%)</style>."},"1357":{"name":"Harmonic Amplifier","description":"Increases the DMG dealt and healing of skills triggered by the speaker by <style=\"accent-gn\">30%</style>."},"1358":{"name":"Crescendo Healing Chord","description":"<linktext=1606><style=\"ItemQuality_5\">Healing Melody</style></linktext> gains <style=\"accent-gn\">7%</style> Healing Strength for every <style=\"accent-gn\">second</style> it remains active, stacking up to <style=\"accent-gn\">5</style> times.<br><linktext=1606><style=\"ItemQuality_5\">Healing Melody</style></linktext> additionally restores a fixed amount equal to <style=\"accent-gn\">0.3%</style> of the target's Max HP when healing."},"1359":{"name":"Crit Scale","description":"Increases Crit Rate by <style=\"accent-gn\">10%</style> against enemies above <style=\"accent-gn\">50%</style> HP. <br>Increases Crit Rate by <style=\"accent-gn\">10%</style> against enemies below <style=\"accent-gn\">50%</style> HP."},"1360":{"name":"Symphonic Aria","description":"Enhances Healing by <style=\"accent-gn\">10%</style> for targets affected by <linktext=1606><style=\"ItemQuality_5\">Healing Melody</style></linktext>."},"1361":{"name":"Vitality Unleash","description":"<style=\"accent-gn\">7%</style> of DMG dealt and <style=\"accent-gn\">15%</style> of healing done is stored as Rhythm. Within <style=\"accent-gn\">10s</style> after you cast <linktext=1610><style=\"ItemQuality_5\">Center Stage</style></linktext>, the use of <style=\"accent-gn\">Expertise</style> and <linktext=1609><style=\"ItemQuality_5\">Healing Beat</style></linktext> consumes Rhythm to grant up to <style=\"accent-gn\">40%</style> bonus healing. The cap for Rhythm storage is <style=\"accent-gn\">30</style> times MATK."},"1362":{"name":"Encore Chain","description":"Within <style=\"accent-gn\">10s</style> after you cast <linktext=1616><style=\"ItemQuality_5\">Encore</style></linktext>, each use of <style=\"accent-gn\">Expertise Skill</style> triggers <linktext=1193><style=\"ItemQuality_5\">Encore Strings</style></linktext> for targets affected by <linktext=1616><style=\"ItemQuality_5\">Encore</style></linktext>."},"1363":{"name":"Tower Resonance","description":"Permanently benefits from <linktext=1616><style=\"ItemQuality_5\">Encore</style></linktext> effect. <br><style=\"accent-gn\">Each</style> trigger of <linktext=1193><style=\"ItemQuality_5\">Encore Strings</style></linktext> reduces the remaining CD of <style=\"accent-gn\">Expertise</style> by <style=\"accent-gn\">1</style> second."},"1364":{"name":"Stat Resonance Overload","description":"For <style=\"accent-gn\">15s</style> after actively casting <linktext=1616><style=\"ItemQuality_5\">Encore</style></linktext>, the stat bonuses provided by <linktext=1606><style=\"ItemQuality_5\">Healing Melody</style></linktext> are +<style=\"accent-gn\">100%</style>."},"1365":{"name":"Center Stage: Concerto","description":"The charges of <linktext=1610><style=\"ItemQuality_5\">Center Stage</style></linktext> increase by <style=\"accent-gn\">1</style>."},"1366":{"name":"Absolute Center Stage","description":"After you use <linktext=1610><style=\"ItemQuality_5\">Center Stage</style></linktext>, the number of enhanced skills increases from <style=\"accent-gn\">1</style> to <style=\"accent-gn\">2</style>."},"1367":{"name":"Spiral Flame","description":"After casting <linktext=1610><style=\"ItemQuality_5\">Center Stage</style></linktext>, summon a wave of <linktext=1173><style=\"ItemQuality_5\">Sonic Surge</style></linktext>."}},"seasonTalents":{"templates":{"1":"Fantasia Impact","2":"Phantom Execution","3":"Phantom Arrow","4":"Mirage Dream","5":"Dreamforce","6":"Oblivion Dream","7":"Shattered Illusion","8":"Endless Mind","20001":"Overload Crit","20002":"Torrent of Fate","20003":"Imagine Acceleration","20004":"Coordinated Strike","20005":"High-Energy Pulse","20006":"Mastery Boost"},"ordinaryEffects":{"1001":"Fantasia Impact","1002":"Linkage","1003":"Reconstruct","1004":"Time-Step","1005":"Multi-Phasic Strike","1006":"Ripple of Fate","1007":"Dual","1008":"Chrono Elixir","1009":"Blink Breath","1010":"Ultimate Fortune","1101":"Phantom Execution","1102":"Mirage Edge","1103":"Execution Force","1104":"Time-Slit","1105":"Instant","1106":"Nirvana Leap","1107":"Cinder of Reverie","1108":"Chrono Elixir","1109":"Blink Breath","1110":"Swift-Calc","1201":"Phantom Arrow","1202":"Dual Time","1203":"Dreamarrow Storm","1204":"Mirage Shot","1205":"Eightfold Skyflow","1206":"Beauty of Refinement","1207":"Phantom Pierce","1208":"Chrono Elixir","1209":"Blink Breath","1210":"Expert Technique","1301":"Mirage Dream","1302":"Dual Ascension Formation","1303":"Battlestart - Rare","1304":"Cross the Mirage","1305":"