"2520","2628","2736","2844","2952","3060","3186","3294"]}," (Resilience Break: 216)"]],["CD",["30s"]]]},"1245":{"name":"Frost Shelter","description":"Encases yourself in ice, rendering you immune to all DMG but immobilized for the duration. Deals <style=\"magic\">Magic Damage</style> to all nearby enemies, and inflicts <linktext=3011><style=\"ItemQuality_5\">Slow</style></linktext> until they are <linktext=1171><style=\"ItemQuality_5\">Frozen</style></linktext>. <br><br><size=22><style=\"tipsYellow\">Tips: Equip this skill in high-pressure situations to increase survivability.</style></size>","skillLabel":["Expertise Skill","Magic","Ice","Direct DMG","AoE","Protect","Frozen"],"activeEffectParams":[["Total DMG",[{"r":["150%","156%","162%","180%","186%","192%","210%"]}," MATK +",{"l":["18","48","78","108","138","168","204","234","264","294","324","354","384","414","444","474","504","534","564","594","624","654","684","714","744","774","804","834","864","900"]}]],["Duration",["5s"]],["Charge Time",["45s"]]]},"1246":{"name":"Tidepool","description":"Summons a surging Tidal Vortex at the target location, dealing <style=\"magic\">Magic DMG</style> on impact. Channels for <style=\"accent-gn\">5s</style> after casting. Recast to end early.<br><br><style=\"accent-gn\">Ultra Cold: Tidepool</style><br>In the <style=\"accent-gn\">Ultra Cold</style> state, the vortex freezes and violently explodes upon ending, dealing higher <style=\"magic\">Magic DMG</style> to all enemies within range.<br><br><size=22><style=\"tipsYellow\">Tips: You cannot move or cast other skills while channeling. Best paired with allies' AoE skills in coordinated attacks.</style></size>","skillLabel":["Expertise Skill","Magic","Ice","DoT","AoE","Channelling","Ranged"],"activeEffectParams":[["Tidal Vortex DMG per hit",[{"r":["103.2%","107.32%","111.45%","123.84%","127.96%","132.09%","144.48%"]}," MATK +",{"l":["12","30","47","64","82","99","116","133","151","168","185","203","220","237","254","272","289","306","324","341","358","376","393","410","427","445","462","479","497","514"]}," (Resilience Break: 6)"]],["Ice Damage",[{"r":["288%","299.52%","311.04%","345.6%","357.12%","368.64%","403.2%"]}," MATK +",{"l":["36","84","132","181","229","278","326","374","423","471","520","568","616","665","713","762","810","859","907","955","1004","1052","1101","1149","1197","1246","1294","1343","1391","1440"]}," (Resilience Break: 17)"]],["CD",["30s"]]]},"1248":{"name":"Glacier Hymn","description":"Summons the ice's blessing to unfold an <style=\"accent-gn\">Ice Domain</style>, knocking all enemies back within range. Then summons a comet to strike the targets, dealing <style=\"magic\">Magic DMG</style> and inflicting <linktext=1171><style=\"ItemQuality_5\">Frozen</style></linktext> on all affected enemies. <br><style=\"accent-gn\">Ice Domain</style><br>Within the Domain, restores <style=\"accent-gn\">220</style> <style=\"accent-gn\">Ice Energy</style> over time and gains <style=\"accent-gn\">Ultra Cold</style>. Enemies within the domain are continuously <linktext=3011><style=\"ItemQuality_5\">Slowed</style></linktext> until <linktext=1171><style=\"ItemQuality_5\">Frozen</style></linktext>. <br>While in <style=\"accent-gn\">Ultra Cold</style>, targets are treated as <linktext=1171><style=\"ItemQuality_5\">Frozen</style></linktext>. <br><br><size=22><style=\"tipsYellow\">Tips: Don't use this skill when Ice Energy is about to cap. If you do, burn the Ice Energy quickly afterward. Skills enhanced by the Ultra Cold state are most effective when cast within this skill's duration.</style></size>","skillLabel":["Ultimate","Magic","Ice","Direct DMG","AoE","Energy Restore","Frozen","Ranged"],"activeEffectParams":[["Domain Damage",[{"r":["100%","104%","108%","120%","124%","128%","140%"]}," MATK +",{"l":["15","35","55","75","95","115","136","156","176","196","216","236","257","277","297","317","337","357","378","398","418","438","458","478","499","519","539","559","579","600"]}]],["Meteor damage",[{"r":["800%","832%","864%","960%","992%","1024%","1120%"]}," MATK +",{"l":["120","281","442","604","765","926","1088","1249","1411","1572","1733","1895","2056","2217","2379","2540","2702","2863","3024","3186","3347","3508","3670","3831","3993","4154","4315","4477","4638","4800"]}," (Resilience Break: 263)"]],["CD",["60s"]]]},"1401":{"name":"Windborne Grace","description":"<style=\"accent-gn\">Courage</style><br>A key resource for unleashing <style=\"accent-gn\">Special Attacks</style> and select <style=\"accent-gn\">Expertise Skills</style>. Regenerates <style=\"accent-gn\">3</style> points per second, with a starting maximum of <style=\"accent-gn\">100</style>. <br><br><style=\"accent-gn\">Basic Attack: Windborne Grace</style><br>Executes a sequence of up to four attacks, dealing <style=\"physical\">Attack DMG</style><br><br><size=22><style=\"tipsYellow\">Tips: Fill the gaps with Basic Attacks when Courage is too low for other offensive skills.</style></size>","skillLabel":["Basic Attack","Physical","Wind","Direct DMG","Single Target","Melee"],"activeEffectParams":[["Strike I",[{"r":["30%","31.2%","32.4%","36%","37.2%","38.4%","42%"]}," ATK +",{"l":["3","7","11","15","19","23","27","31","35","39","43","47","51","55","59","63","67","71","75","79","83","87","91","95","99","103","107","111","115","120"]}," (Resilience Break: 9)"]],["Strike II",[{"r":["50%","52%","54%","60%","62%","64%","70%"]}," ATK +",{"l":["4","10","18","24","30","38","44","52","58","64","72","78","84","92","98","104","112","118","126","132","138","146","152","158","166","172","178","186","192","200"]}," (Resilience Break: 16)"]],["Strike III",[{"r":["54%","56.16%","58.32%","64.8%","66.96%","69.12%","75.6%"]}," ATK +",{"l":["3","12","18","27","33","39","48","54","63","69","78","84","90","99","105","114","120","126","135","141","150","156","165","171","177","186","192","201","207","216"]}," (Resilience Break: 15)"]],["Strike IV",[{"r":["66%","68.64%","71.28%","79.2%","81.84%","84.48%","92.4%"]}," ATK +",{"l":["6","15","24","33","42","50","59","68","77","86","95","104","113","121","130","139","148","157","166","175","184","192","201","210","219","228","237","246","255","264"]}," (Resilience Break: 21)"]],["Red Light Counter",[{"r":["100%","104%","108%","120%","124%","128%","140%"]}," ATK +",{"l":["10","23","36","50","63","77","90","104","117","131","144","157","171","184","198","211","225","238","252","265","278","292","305","319","332","346","359","373","386","400"]}," (Resilience Break: 100)"]]]},"1407":{"name":"Typhoon","description":"场地标记01","skillLabel":["Special Attack","Direct DMG","Shield","Wind"]},"1409":{"name":"Typhoon Cleave","description":"Launches into enemy lines, dealing <style=\"physical\">Attack DMG</style> to enemies in range and knocking them <style=\"accent-gn\">Airborne</style>. Restores <style=\"accent-gn\">100</style> <style=\"accent-gn\">Courage</style>.<br><i><style=\"text_third_gray\"><br>\"Endless storm, unlock thy mighty power at my knight's command! Wind, reveal thy glory with a surging rush!\"</style></i><br><br><size=22><style=\"tipsYellow\">Tips: Cast when Courage is low.</style></size>","skillLabel":["Ultimate","Physical","Wind","Direct DMG","AoE","Melee"]},"1410":{"name":"Typhoon Cleave","description":"Raises the banner spear, granting <style=\"accent-gn\">Inspire</style> to allies. Afterward, a follow-up leap can be launched, dealing <style=\"physical\">Attack DMG</style> to the enemies within range and <style=\"accent-gn\">knocking them airborne</style>, while restoring <style=\"accent-gn\">100</style> <style=\"accent-gn\">Courage</style>. <br><style=\"accent-gn\">Inspire</style>: Lasts for <style=\"accent-gn\">10s</style>. During this time, all allies' Haste +<style=\"accent-gn\">10%</style>. You restore <style=\"accent-gn\">10</style> <style=\"accent-gn\">Courage</style> <style=\"accent-gn\">per</style> second and <style=\"accent-gn\">1</style> stack of <style=\"accent-gn\">Sharp</style> every <style=\"accent-gn\">2s</style>. <br><i><style=\"text_third_gray\">\"Endless storm, unlock thy mighty power at my knight's command! Wind, reveal thy glory with a surging rush! Manifest in the wind! </style></i><br><br><size=22><style=\"tipsYellow\">Tips: Cast when Courage is low.</style></size>","skillLabel":["Ultimate","Physical","Wind","Direct DMG","AoE","Energy Restore","Melee"],"activeEffectParams":[["Total DMG",[{"r":["650%","676%","702%","780%","806%","832%","910%"]}," ATK +",{"l":["65","152","239","327","414","502","589","676","764","851","939","1026","1113","1201","1288","1376","1463","1551","1638","1725","1813","1900","1988","2075","2162","2250","2337","2425","2512","2600"]}," (Resilience Break: 358)"]],["CD",["60s"]]]},"1411":{"name":"Swift Blade","description":"Deals <style=\"physical\">Attack DMG</style> equal to <style=\"accent-gn\">100%</style> ATK to all the enemies, which scales with the Level/Tier of <style=\"accent-gn\">Basic Attack</style>. <br>Restores <style=\"accent-gn\">10</style> <style=\"accent-gn\">Courage</style> immediately upon use."},"1418":{"name":"Gale Thrust","description":"Consumes <style=\"accent-gn\">50</style> <style=\"accent-gn\">Courage</style> to perform <style=\"accent-gn\">3</style> thrusts toward the enemy, dealing <style=\"physical\">Attack DMG</style> with each hit.<br><br><size=22><style=\"tipsYellow\">Tips: Time casts carefully, and use this skill between Basic Attacks, as Courage takes time to accumulate.</style></size>","skillLabel":["Special Attack","Physical","Wind","Direct DMG","Single Target","Melee"],"activeEffectParams":[["Total DMG",[{"r":["148%","153.92%","159.84%","177.6%","183.52%","189.44%","207.2%"]}," ATK +",{"l":["14","34","54","74","94","114","134","154","174","194","214","234","254","274","294","315","335","355","375","395","415","435","455","475","495","515","535","555","575","600"]}," (Resilience Break: 148)"]]]},"1419":{"name":"Skyfall","description":"Consumes <style=\"accent-gn\">35</style> <style=\"accent-gn\">Courage</style> to leap into the air and deliver a downward strike on the enemy, dealing <style=\"physical\">Attack DMG</style>.<br><i><style=\"text_third_gray\">\"Even if enemy lines are unbreakable, the wind of victory will tear them asunder!\"</style></i><br><br><size=22><style=\"tipsYellow\">Tips: Cast when Courage is near cap. When casting in succession, the leap is skipped for faster follow-up attacks.</style></size>","skillLabel":["Special Attack","Physical","Wind","Direct DMG","Single Target","Melee"],"activeEffectParams":[["Total DMG",[{"r":["175%","182%","189%","210%","217%","224%","245%"]}," ATK +",{"l":["15","35","55","75","95","115","136","156","176","196","216","236","257","277","297","317","337","357","378","398","418","438","458","478","499","519","539","559","579","600"]}," (Resilience Break: 233)"]]]},"1420":{"name":"Galeform","description":"Stuns enemies in front upon casting, dealing <style=\"physical\">Attack DMG</style>. While active, continuously restores <style=\"accent-gn\">105</style> <style=\"accent-gn\">Courage</style> and increases your Strength.<br>This skill holds <style=\"accent-gn\">2</style> charges.<br><br><size=22><style=\"tipsYellow\">Tips: Cast when Courage is low.</style></size>","skillLabel":["Expertise Skill","Physical","Wind","Direct DMG","Single Target","Energy Restore","Increased Damage","Melee"],"activeEffectParams":[["Total DMG",[{"r":["50%","52%","54%","60%","62%","64%","70%"]}," ATK +",{"l":["5","11","18","25","31","38","45","52","58","65","72","78","85","92","99","105","112","119","126","132","139","146","152","159","166","173","179","186","193","200"]}]],["Strength Bonus",[{"r":["30%","30.8%","31.6%","34%","34.8%","35.6%","38%"]},"+",{"l":["20","25","30","36","41","46","52","57","62","68","73","78","84","89","94","100","105","110","116","121","126","132","137","142","148","153","158","164","169","175"]}]],["Duration",["15s"]],["CD",["30s"]],["Charge Time",["30s"]]]},"1421":{"name":"Spiral Thrust","description":"Consumes <style=\"accent-gn\">30</style> <style=\"accent-gn\">Courage</style> to reel in the spinning lance and unleash a final piercing strike. The spiraling gust tears through the air, dealing sustained <style=\"physical\">Attack DMG</style> to enemies within range. The initial strike inflicts a <style=\"accent-gn\">50%</style><style=\"accent-gn\"> <linktext=3004><style=\"ItemQuality_5\">Wound</style></linktext> on the target, lasting <style=\"accent-gn\">10s</style>. <br><br><size=22><style=\"tipsYellow\">Tips: Whenever you have enough Courage, use it on your most important skill.</style></size>","skillLabel":["Expertise Skill","Physical","Wind","Direct DMG","Single Target","Melee"],"activeEffectParams":[["Total DMG",[{"r":["497%","516.88%","536.76%","596.4%","616.28%","636.16%","695.8%"]}," ATK +",{"l":["49","112","182","245","315","385","448","518","581","651","721","784","854","917","987","1057","1120","1190","1253","1323","1393","1456","1526","1589","1659","1729","1792","1862","1925","1995"]}," (Resilience Break: 357)"]],["CD",["20s"]]]},"1422":{"name":"Breach Pursuit","description":"Lunges toward the enemy, dealing <style=\"physical\">Attack DMG</style> and gaining <style=\"accent-gn\">15</style> <style=\"accent-gn\">Courage</style>. Can be cast again to unleash a sweeping slash, dealing <style=\"physical\">Attack DMG</style> to all nearby enemies and knocking them <style=\"physical\">Airborne</style>. Targets with Resilience cannot be knocked airborne but will have their Resilience reduced. Additionally, gains <style=\"accent-gn\">10</style> <style=\"accent-gn\">Courage</style> for <style=\"accent-gn\">each</style> enemy hit, up to a maximum of <style=\"accent-gn\">50</style> Courage.<br><br><size=22><style=\"tipsYellow\">Tips: Equip when facing multiple enemies.</style></size>","skillLabel":["Expertise Skill","Physical","Wind","Direct DMG","AoE","Melee"],"activeEffectParams":[["Strike I",[{"r":["70%","72.8%","75.6%","84%","86.8%","89.6%","98%"]}," ATK +",{"l":["7","16","25","35","44","54","63","72","82","91","101","110","119","129","138","148","157","167","176","185","195","204","214","223","232","242","251","261","270","280"]}," (Resilience Break: 89)"]],["Strike II",[{"r":["130%","135.2%","140.4%","156%","161.2%","166.4%","182%"]}," ATK +",{"l":["13","30","47","65","82","100","117","135","152","170","187","205","222","240","257","275","292","310","327","345","362","380","397","415","432","450","467","485","502","520"]}," (Resilience Break: 166)"]],["CD",["12s"]]]},"1423":{"name":"Aegis Gale","description":"Condenses wind pressure in front of the caster, rendering the caster immune to all DMG. Counterattack DMG is incrementally amplified with each incoming attack, dealing <style=\"\"physical\"\">Attack DMG</style> in retaliation. <br><br><size=22><style=\"\"tipsYellow\"\">Tips: This skill is intended to be used in high-pressure situations to increase chances of survival. The more frequent enemy attack, the more this skill brings you.</style></size>","skillLabel":["Expertise Skill","Physical","Wind","Direct DMG","Single Target","Block","Melee"],"activeEffectParams":[["Base DMG",[{"r":["150%","156%","162%","180%","186%","192%","210%"]}," ATK +",{"l":["15","35","55","75","95","115","136","156","176","196","216","236","257","277","297","317","337","357","378","398","418","438","458","478","499","519","539","559","579","600"]}]],["CD",["30s"]]]},"1424":{"name":"Instant Edge","description":"Consumes 2 stacks of <style=\"accent-gn\">Sharp</style> to leap into the air and deliver a powerful aerial strike, dealing <style=\"physical\">Attack DMG</style>.<br><br><size=22><style=\"tipsYellow\">Tips: Combo with Skyward Spec. Cast when Courage is low to prevent overcapping and wasting Courage regeneration.</style></size>","skillLabel":["Expertise Skill","Physical","Wind","Direct DMG","Single Target","Melee"],"activeEffectParams":[["Total DMG",[{"r":["360%","374.4%","388.8%","432%","446.4%","460.8%","504%"]}," ATK +",{"l":["34","82","131","178","226","276","324","373","421","469","518","565","615","663","710","759","807","856","904","951","1001","1049","1097","1145","1193","1242","1290","1338","1387","1437"]}," (Resilience Break: 523)"]]]},"1425":{"name":"Falcon Toss","description":"Consumes <style=\"accent-gn\">40</style> <style=\"accent-gn\">Courage</style> to leap into the air and hurl a wind-forged spear with force. Deals <style=\"physical\">Attack DMG</style> to all enemies in range and greatly reduces their Resilience. Grants 1 stack of <style=\"accent-gn\">Sharp</style>.<br><br><size=22><style=\"tipsYellow\">Tips: Effective against enemies with Resilience. Also recommended when dealing with multiple targets.</style></size>","skillLabel":["Expertise Skill","Physical","Wind","Direct DMG","Single Target","Stagger","Melee"],"activeEffectParams":[["Charge Damage",[{"r":["75%","78%","81%","90%","93%","96%","105%"]}," ATK +",{"l":["7","17","27","37","47","57","68","78","88","98","108","118","128","138","148","158","168","178","189","199","209","219","229","239","249","259","269","279","289","300"]}," (Resilience Break: 94)"]],["Spear Damage",[{"r":["500%","520%","540%","600%","620%","640%","700%"]}," ATK +",{"l":["50","117","184","251","318","386","453","520","587","655","722","789","856","924","991","1058","1125","1193","1260","1327","1394","1462","1529","1596","1663","1731","1798","1865","1932","2000"]}," (Resilience Break: 631)"]],["CD",["0.5s"]],["Charge Time",["23s"]]]},"1426":{"name":"Typhoon Cleave","description":"Launches into enemy lines, dealing <style=\"physical\">Attack DMG</style> to enemies in range and knocking them <style=\"accent-gn\">Airborne</style>. Restores <style=\"accent-gn\">100</style> <style=\"accent-gn\">Courage</style>.<br><i><style=\"text_third_gray\">\"Endless storm, unlock thy mighty power at my knight's command! Wind, reveal thy glory with a surging rush!\"</style></i><br><br><size=22><style=\"tipsYellow\">Tips: Cast when Courage is low.</style></size>","skillLabel":["Ultimat