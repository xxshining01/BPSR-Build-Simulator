gle Healing",[{"r":["400%","400%","720%","1040%","1400%"]}," ATK/MATK"]],["CD",[{"r":["240s","240s","200s","150s","90s"]}]]]},"3024":{"name":"Infernal Thrust","description":"<style=\"accent-gn\">Summons Boss</style>: Iron Fang to deal a large instance of AoE <style=\"physical\">Attack DMG</style> to nearby enemies, inflicting <linktext=3004><style=\"ItemQuality_5\">Wound</style></linktext> on affected targets.<br><br><style=\"accent-gn\">Skill is not affected by CD</style>.","skillLabel":["Role Skills","Physical","Direct DMG","AoE","Wound"],"activeEffectParams":[["Total DMG",["1500% ATK/MATK +150 (Resilience Break: 100)"]],["Wound",[{"r":["50%","50%","50%","100%","100%"]}]],["Duration",[{"r":["5s","5s","7s","7s","10s"]}]],["CD",[{"r":["240s","240s","200s","150s","90s"]}]]]},"3025":{"name":"Thunder Roar","description":"<style=\"accent-gn\">Summons Boss</style>: Golden Juggernaut to provide a <style=\"accent-gn\">Shield</style> for the caster.<br><br><style=\"accent-gn\">Skill is not affected by CD</style>.","skillLabel":["Role Skills","Shield"],"activeEffectParams":[["Shield",[{"r":["10%","10%","13%","16%","20%"]}," Max HP"]],["Duration",[{"r":["10s","10s","12s","12s","15s"]}]],["CD",[{"r":["150s","150s","120s","90s","60s"]}]]]},"3026":{"name":"Silent Tide","description":"<style=\"accent-gn\">Summons Boss</style>: Lizardman King to deal <style=\"physical\">Attack DMG</style> to nearby enemies and continuously <linktext=3001><style=\"ItemQuality_5\">Silence</style></linktext> targets.<br><br><style=\"accent-gn\">Skill is not affected by CD</style>.","skillLabel":["Role Skills","Physical","Direct DMG","Ice","AoE","Silence"],"activeEffectParams":[["Total DMG",["1500% ATK/MATK +150 (Resilience Break: 100)"]],["Silence Duration",[{"r":["5s","5s","6s","7s","8s"]}]],["CD",[{"r":["240s","240s","200s","150s","90s"]}]]]},"3027":{"name":"Blessing of Life","description":"<style=\"accent-gn\">Summons</style> Airona. After a brief chant, some nearby teammates are revived.<br><style=\"accent-gn\">Weakness: Cannot be affected by the same type of effect for 60s (Weakness effects are amplified in Nightmare party dungeons).</style><br><br><style=\"accent-gn\">Skill is not affected by CD</style>.","skillLabel":["Role Skills"],"activeEffectParams":[["Revive Count",[{"r":["2","2","2","3","4"]}]],["Base HP on Revive",[{"r":["10%","10%","20%","30%","40%"]}]],["CD",[{"r":["240s","240s","210s","170s","120s"]}]]]},"3028":{"name":"Guardian's Boundary","description":"<style=\"accent-gn\">Summons</style> Fafala to create a field. The caster and allies within the field gain <style=\"accent-gn\">additional DMG reduction</style> (this attribute is triggered up to a maximum of <style=\"accent-gn\">50%</style>) and <style=\"accent-gn\">Super Armor</style>.<br><style=\"accent-gn\">(Cannot be stacked; only one instance of the same effect can be active.)</style><br><br><style=\"accent-gn\">Skill is not affected by CD</style>.","skillLabel":["Role Skills","Protect"],"activeEffectParams":[["Additional DMG Reduction",[{"r":["10%","10%","16%","22%","30%"]}]],["Duration",["10s"]],["CD",[{"r":["200s","200s","160s","120s","80s"]}]]]},"3311":{"name":"Overclock Shock","description":"Releases an energy wave, <linktext=3000><style=\"ItemQuality_5\">interrupting</style></linktext> all targets within <style=\"accent-gn\">5m</style> and <linktext=3001><style=\"ItemQuality_5\">silencing</style></linktext> them for <style=\"accent-gn\">5s</style>.<br><br><style=\"accent-gn\">This skill is unaffected by CD effects</style>.","skillLabel":["Role Skills","Silence"],"activeEffectParams":[["CD",["45s"]]]},"3312":{"name":"Renewal Prayer","description":"Revives the nearest ally within <style=\"accent-gn\">3m</style>.<br><br><style=\"accent-gn\">This skill is unaffected by CD effects</style>.<br><br><style=\"accent-gn\">Weakness: Unaffected by same type of effects for 60s (Weakness effects are enhanced in party dungeons in Nightmare mode).</style>","skillLabel":["Role Skills"],"activeEffectParams":[["CD",["90s"]]]},"3313":{"name":"Life Barrier","description":"Immediately grants the caster and up to <style=\"accent-gn\">10</style> nearby allies (party members prioritized) a shield equal to <style=\"accent-gn\">20%</style> Max HP, and while the shield persists, increases <style=\"accent-gn\">15%</style> additional DMG Reduction for <style=\"accent-gn\">10s</style>. <br><br><style=\"accent-gn\">This skill is unaffected by CD effects</style>.","skillLabel":["Role Skills","Shield","Protect"],"activeEffectParams":[["CD",["80s"]]]},"3314":{"name":"Silent Command","description":"Dispels <linktext=3021><style=\"ItemQuality_5\">debuffs</style></linktext> from up to <style=\"accent-gn\">10</style> allies within <style=\"accent-gn\">25m</style> (party members prioritized).<br><br><style=\"accent-gn\">This skill is unaffected by CD effects</style>.","skillLabel":["Role Skills"],"activeEffectParams":[["CD",["30s"]]]},"3611":{"name":"Overclock Wave","description":"Releases an energy wave, <linktext=3000><style=\"ItemQuality_5\">interrupting</style></linktext> all targets within <style=\"accent-gn\">5m</style>.<br><br><style=\"accent-gn\">This skill is unaffected by CD effects</style>.","skillLabel":["Role Skills"],"activeEffectParams":[["CD",["45s"]]]},"3612":{"name":"Unyielding Spirit","description":"Grants <style=\"accent-gn\">35%</style> additional DMG Reduction for <style=\"accent-gn\">5s</style>. This skill can store <style=\"accent-gn\">2</style> charges. <br><br><style=\"accent-gn\">This skill is unaffected by CD effects</style>.","skillLabel":["Role Skills","Protect"],"activeEffectParams":[["Charge Time",["80s"]]]},"3613":{"name":"Master of Stealth","description":"Conceals the caster's presence to prevent Aggro generation and cleanses all <linktext=3020><style=\"ItemQuality_5\">debuffs</style></linktext> from the caster for <style=\"accent-gn\">10s</style>.<br><br><style=\"accent-gn\">This skill is unaffected by CD effects</style>.","skillLabel":["Role Skills","Remove Debuff"],"activeEffectParams":[["CD",["30s"]]]},"3614":{"name":"Energy Reflux","description":"Instantly recovers <style=\"accent-gn\">50%</style> Stamina and increases Movement Speed by <style=\"accent-gn\">15%</style> for <style=\"accent-gn\">5s</style>.<br><br><style=\"accent-gn\">This skill is unaffected by CD effects</style>.","skillLabel":["Role Skills"],"activeEffectParams":[["CD",["30s"]]]}},"classes":{"1":{"name":"Stormblade","intro":"Wields a <color=#fcbe03>Reaper Scythe</color>, excelling in <color=#fcbe03>close-range combat</color>. Switches seamlessly between scythe and longsword forms, delivering <color=#fcbe03>precise area strikes</color>.","masteryDes":["Each 1% Mastery increases the DMG of skills that use Thunder Sigils by 3.4%","Each 1% Mastery increases the DMG of Thundercut, Storm Scythe, and Divine Sickle by 1.2%"]},"2":{"name":"Frost Mage","intro":"Wields a <color=#fcbe03>Frost Staff</color>, excelling in <color=#fcbe03>long-range combat</color>. Commands the power of ice to deliver <color=#fcbe03>wide-area DMG</color> and formidable <color=#fcbe03>control</color>.","masteryDes":["Each 1% Mastery grants 0.65% Ice Bonus","Each 1% Mastery grants 1% Ice Energy gain efficiency and 0.2% Ice Bonus.<br>Mastery Enhancement: Each 1% Mastery increases the Ice Bonus conversion ratio by 3%."]},"3":{"name":"Twin Striker","intro":"Excels in <color=#fcbe03>close-range</color> combat, using <color=#fcbe03>Dual Axes</color> as a weapon. Moves are as swift and fierce as fire, with excellent <color=#fcbe03>small-area attack</color> capabilities.","masteryDes":["Each 1% Mastery provides 3.2% CD Boost for Blazing Assault, Rage Cleave, and Axe Wind, and 0.2% ATK.","Each 1% Mastery grants 0.72% Fire Bonus."]},"4":{"name":"Wind Knight","intro":"Excels in <color=#fcbe03>close-range</color> combat, using a <color=#fcbe03>Lance</color> as a weapon. Agile and fast, possessing excellent <color=#fcbe03>small area attack</color> capabilities.","masteryDes":["Each 1% Mastery grants 0.35% Wind Bonus.<br>Mastery Enhancement: Each 1% Mastery increases the Wind Bonus conversion ratio by 3%.","Each 1% Mastery grants 0.65% Wind Bonus"]},"5":{"name":"Verdant Oracle","intro":"Wields a <color=#fcbe03>Nature Ring</color>, excelling in <color=#fcbe03>long-range healing</color>. Channels the verdant essence of the forest to deliver exceptional <color=#fcbe03>healing</color> and <color=#fcbe03>buffs</color>.","masteryDes":["Each 1% Mastery grants 0.75% Forest Bonus and 0.3% Shield Strength","Each 1% Mastery increases healing by 1%"]},"8":{"name":"Thunder Flash - Hand Cannon","intro":"Excels in <color=#fcbe03>long-range combat</color>,<br>capable of striking wide areas with rapid fire. Boosting <color=#fcbe03>Sigil chance</color> greatly increases trigger frequency.<br>Can <color=#fcbe03>charge</color> at close range to deal massive DMG. Boosts <color=#fcbe03>critical rate</color> for dealing massive DMG.","masteryDes":["Adds Thunder DMG","Adds Thunder DMG"]},"9":{"name":"Heavy Guardian","intro":"Wields a <color=#fcbe03>Guardblade</color>, excelling in <color=#fcbe03>close-range combat</color>. Channels the power of Rock to form a protective shell, offering exceptional <color=#fcbe03>defense</color> and <color=#fcbe03>control</color>.","masteryDes":["Each 1% Mastery increases Shield strength by 2.5%","Each 1% Mastery grants 0.2% Block DMG Reduction and 0.2% Lucky Block DMG Reduction"]},"10":{"name":"Ritual Dance of Shadowspirits: Ceremonial Blade / Staff","intro":"A mid-to-close-range weapon enabling Coordinated Attacks.","masteryDes":["Adds Dark DMG","Adds Dark DMG"]},"11":{"name":"Marksman","intro":"Wields a <color=#fcbe03>bow</color>, excelling in <color=#fcbe03>long-range</color> combat. Partners with animal companions to unleash <color=#fcbe03>wide-area attacks</color>.","masteryDes":["Each 1% Mastery increases Companion's DMG by 2.75%","Each 1% Mastery grants 0.6% Light Bonus"]},"12":{"name":"Shield Knight","intro":"Wields a <color=#fcbe03>Sword and Shield</color>, excelling in <color=#fcbe03>close-range combat</color>. Wears radiant lightforged armor, boasting exceptional <color=#fcbe03>defense</color> and <color=#fcbe03>self-healing</color>.","masteryDes":["Each 1% Mastery increases Radiant Shield gain by 2.5% and All Element Resistance by 0.2%","Each 1% Mastery increases Lightforged Barrier HP boost effect by 3% and All Element Resistance by 0.2%"]},"13":{"name":"Beat Performer","intro":"Excels in <color=#fcbe03>long-range</color> combat, using a <color=#fcbe03>Guitar</color> as a weapon. <color=#fcbe03>Heals</color> while attacking, excels in granting Allies <color=#fcbe03>buffs</color>, and possesses excellent <color=#fcbe03>support</color> capabilities.","masteryDes":["Each 1% Mastery increases Peaceful Tune conversion bonus by 1%","Each 1% Mastery reduces the decay speed of Healing Melody by 0.35%"]},"14":{"name":"Lucy","intro":"Excels in <color=#fcbe03>long-range combat</color>,<br>capable of striking wide areas with rapid fire. Boosting <color=#fcbe03>Sigil chance</color> greatly increases trigger frequency.<br>Can <color=#fcbe03>charge</color> at close range to deal massive DMG. Boosts <color=#fcbe03>critical rate</color> for dealing massive DMG.","masteryDes":["Increases Crit DMG","Increases Crit DMG"]},"15":{"name":"Natsu","intro":"Excels in <color=#fcbe03>long-range combat</color>,<br>capable of striking wide areas with rapid fire. Boosting <color=#fcbe03>Sigil chance</color> greatly increases trigger frequency.<br>Can <color=#fcbe03>charge</color> at close range to deal massive DMG. Boosts <color=#fcbe03>critical rate</color> for dealing massive DMG.","masteryDes":["Increases Crit DMG","Increases Crit DMG"]}},"parts":{"200":"Weapon","201":"Helmet","202":"Armor","203":"Gauntlets","204":"Boots","205":"Earrings","206":"Necklace","207":"Ring","208":"Bracelet (L)","209":"Bracelet (R)","210":"Charm"},"attributes":{"11010":"Strength","11012":"Strength","11014":"Strength","11020":"Intelle